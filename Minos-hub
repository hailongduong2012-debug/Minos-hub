-- Khởi tạo các biến cấu hình hệ thống toàn cục
local _G = getgenv and getgenv() or _G
_G.AutoSelectGarry = false
_G.AutoGearRainbow = false
_G.LockRainbow = false
_G.AutoTeleportBox = false
_G.BoxDamageValue = 1000
_G.AttackDelayValue = 0.1

-- Khóa đồng bộ (Sync Lock) để ngăn chặn hoàn toàn lỗi xung đột luồng giữa Toggle 2 và Toggle 3
local isHandlingGear = false 

-- Tạo Tab chính (Chuỗi thô / Main Script)
local MainTab = Window:CreateTab("Chuỗi Thô / Main Script", 4483362458)

-- =====================================================================
-- TOGGLE 1: CHỌN NHÂN VẬT GARRY (Quét diện rộng ép chọn Garry)
-- =====================================================================
MainTab:CreateToggle({
   Name = "Toggle 1: Chọn Nhân Vật (Garry)",
   CurrentValue = false,
   Flag = "ToggleGarry",
   Callback = function(Value)
      _G.AutoSelectGarry = Value
      if Value then
         task.spawn(function()
            while _G.AutoSelectGarry do
               for _, v in pairs(game:GetDescendants()) do
                  if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                     if string.find(string.lower(v.Name), "character") or string.find(string.lower(v.Name), "select") then
                        pcall(function()
                           v:FireServer("Garry")
                           v:InvokeServer("Garry")
                        end)
                     end
                  end
               end
               task.wait(1)
            end
         end)
      end
   end,
})

-- =====================================================================
-- TOGGLE 2: AUTO GEAR & GET RAINBOW (Trang bị gear, lấy kiếm Rainbow ẩn danh)
-- =====================================================================
MainTab:CreateToggle({
   Name = "Toggle 2: Auto Gear & Get Rainbow",
   CurrentValue = false,
   Flag = "ToggleGearRainbow",
   Callback = function(Value)
      _G.AutoGearRainbow = Value
      if Value then
         task.spawn(function()
            while _G.AutoGearRainbow do
               if not isHandlingGear then
                  isHandlingGear = true
                  
                  pcall(function()
                     local player = game.Players.LocalPlayer
                     local backpack = player:FindFirstChild("Backpack")
                     local character = player.Character
                     
                     -- Tự động trang bị Gear và kích hoạt chiêu
                     if backpack then
                        for _, gear in pairs(backpack:GetChildren()) do
                           if gear:IsA("Tool") and gear.Name ~= "Rainbow Sword" then
                              if character then
                                 gear.Parent = character
                                 task.wait(0.1)
                                 gear:Activate()
                              end
                           end
                        end
                     end
                     
                     -- Sử dụng getconnections để lấy kiếm Rainbow ẩn danh
                     if typeof(getconnections) == "function" then
                        for _, connection in pairs(getconnections(game:GetService("ReplicatedStorage").ChildAdded)) do
                           connection:Fire()
                        end
                     end
                     
                     -- Gọi Remote nhận kiếm Rainbow
                     local rainbowRemote = game:GetService("ReplicatedStorage"):FindFirstChild("GetRainbow", true) or game:GetService("ReplicatedStorage"):FindFirstChild("ClaimItem", true)
                     if rainbowRemote and rainbowRemote:IsA("RemoteEvent") then
                        rainbowRemote:FireServer("Rainbow Sword")
                     end
                  end)
                  
                  isHandlingGear = false
               end
               task.wait(1)
            end
         end)
      end
   end,
})

-- =====================================================================
-- TOGGLE 3: KHÓA KIẾM RAINBOW (Quét siêu nhanh 50ms, tự cầm, ép cất gear khác)
-- =====================================================================
MainTab:CreateToggle({
   Name = "Toggle 3: Khóa Kiếm Rainbow (50ms)",
   CurrentValue = false,
   Flag = "ToggleLockRainbow",
   Callback = function(Value)
      _G.LockRainbow = Value
      if Value then
         task.spawn(function()
            while _G.LockRainbow do
               -- Kiểm tra Sync Lock để triệt tiêu lỗi xung đột luồng dữ liệu với Toggle 2
               if not isHandlingGear then
                  pcall(function()
                     local player = game.Players.LocalPlayer
                     local backpack = player:FindFirstChild("Backpack")
                     local character = player.Character
                     
                     if character and backpack then
                        -- Ép cất toàn bộ các vũ khí/gear khác về balo
                        for _, tool in pairs(character:GetChildren()) do
                           if tool:IsA("Tool") and tool.Name ~= "Rainbow Sword" then
                              tool.Parent = backpack
                           end
                        end
                        
                        -- Tự động lấy kiếm Rainbow lên tay
                        local rainbowSword = backpack:FindFirstChild("Rainbow Sword")
                        if rainbowSword then
                           rainbowSword.Parent = character
                        end
                     end
                  end)
               end
               task.wait(0.05) -- Tốc độ quét cực nhanh 50ms
            end
         end)
      end
   end,
})

-- =====================================================================
-- INPUT BOX DAMAGE: Nhập sát thương trực tiếp từ 1 đến 1,000,000
-- =====================================================================
MainTab:CreateInput({
   Name = "Nhập Sát Thương Box / Boss",
   PlaceholderText = "Nhập từ 1 đến 1,000,000",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
      local num = tonumber(Text)
      if num then
         -- Giới hạn giá trị trong khoảng từ 1 đến 1,000,000
         _G.BoxDamageValue = math.clamp(num, 1, 1000000)
         Rayfield:Notify({
            Title = "Minos Hub Info",
            Content = "Sát thương hiện tại đặt thành: " .. tostring(_G.BoxDamageValue),
            Duration = 3,
         })
      else
         Rayfield:Notify({
            Title = "Lỗi Nhập Liệu",
            Content = "Vui lòng nhập một số hợp lệ!",
            Duration = 3,
         })
      end
   end,
})

-- =====================================================================
-- SLIDER DELAY: Kéo từ 1 đến 50 (Code tự động chia 100 làm thời gian chờ)
-- =====================================================================
MainTab:CreateSlider({
   Name = "Tốc Độ Đập / Tấn Công (Delay)",
   Min = 1,
   Max = 50,
   CurrentValue = 10,
   Flag = "SliderDelayFlag",
   Callback = function(Value)
      -- Tự động chia 100 để làm thời gian chờ thực tế (Ví dụ: 10 / 100 = 0.1s)
      _G.AttackDelayValue = Value / 100
   end,
})

