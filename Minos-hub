-- Hệ thống Anti-Ban (Bypass phát hiện gửi gói tin quá nhanh và Log báo cáo của Game)
local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", function(Self, ...)
    local Args = {...}
    local NamecallMethod = getnamecallmethod()
    
    -- Chặn game gửi log phát hiện script (Anti-Report & Anti-Cheat Bypass)
    if not checkcaller() and (NamecallMethod == "FireServer" or NamecallMethod == "InvokeServer") then
        if tostring(Self) == "Report" or tostring(Self) == "Ban" or tostring(Self) == "Log" or tostring(Self):find("Cheat") then
            return nil
        end
    end
    return OldNamecall(Self, unpack(Args))
end)

-- Hàm quét mục tiêu bảo mật của MINOS HUB
local function getSBSDTargets()
    local validTargets = {}
    for _, child in pairs(workspace:GetChildren()) do
        if child:IsA("Model") and child ~= LocalPlayer.Character then
            local humanoid = child:FindFirstChildOfClass("Humanoid")
            local mainPart = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("PrimaryPart") or child:FindFirstChild("Box")
            
            if humanoid and mainPart and humanoid.Health > 0 then
                table.insert(validTargets, mainPart)
            end
        end
    end
    return validTargets
end

-- Vòng lặp sát thương cực hạn tích hợp Anti-Spam Safe Guard
task.spawn(function()
    while true do
        if _G.QuorumAura then
            local currentEnemies = getSBSDTargets()
            
            local sbsdRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Attack")
                               or ReplicatedStorage:FindFirstChild("Attack")
                               or ReplicatedStorage:FindFirstChild("HitEnemy")
            
            if sbsdRemote and sbsdRemote:IsA("RemoteEvent") then
                for _, enemyPart in pairs(currentEnemies) do
                    if not _G.QuorumAura then break end
                    
                    -- Thực thi Quorum V6 Method: Bắn sát thương ẩn
                    sbsdRemote:FireServer(enemyPart.Position, enemyPart.Parent)
                end
            end
        end
        task.wait(_G.AttackSpeed)
    end
end)

