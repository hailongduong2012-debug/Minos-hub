-- [[ SBSD CAMPAIGN AUTO-ATTACK & BRING ENEMIES ]]
-- Giao diện: Rayfield Mockup UI (100% Hiện bảng - Không lỗi link)

if game:GetService("CoreGui"):FindFirstChild("RayfieldMockup_SBSD") then
    game:GetService("CoreGui")["RayfieldMockup_SBSD"]:Destroy()
end

-- Khởi tạo các biến tính năng
local AuraActive = false
local BringActive = false

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local AttackRemote = ReplicatedStorage:FindFirstChild("Attack") or ReplicatedStorage:FindFirstChild("HitEnemy")

-- === VẼ UI GIẢ LẬP STYLE RAYFIELD (MÀU ĐEN BO GÓC) ===
local SG = Instance.new("ScreenGui", game:GetService("CoreGui"))
SG.Name = "RayfieldMockup_SBSD"

-- Khung chính (Window)
local Main = Instance.new("Frame", SG)
Main.Size = UDim2.new(0, 320, 0, 190)
Main.Position = UDim2.new(0.35, 0, 0.35, 0)
Main.BackgroundColor3 = Color3.fromRGB(21, 21, 24)
Main.BorderSizePixel = 0
Main.Active = true
Main.Draggable = true

local UICorner = Instance.new("UICorner", Main)
UICorner.CornerRadius = UDim.new(0, 9)

-- Thanh Tiêu Đề (Title Bar)
local Title = Instance.new("TextLabel", Main)
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundColor3 = Color3.fromRGB(28, 28, 33)
