-- Tải thư viện Rayfield UI
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "SBSD Hub | Toàn Bản Đồ",
   LoadingTitle = "Đang đồng bộ hệ thống Sát Thương Tầm Xa...",
   LoadingSubtitle = "by SBSD Developer",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false 
})

local MainTab = Window:CreateTab("Global Farm", 4483362458)

_G.GlobalKillAura = false
_G.AttackSpeed = 0.001 -- Tốc độ gửi tín hiệu theo yêu cầu

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Hàm tự động tìm và trả về danh sách tất cả các quái hộp đang có trên bản đồ
local function getAllTargets()
    local targets = {}
    for _, obj in pairs(workspace:GetChildren()) do
        -- Kiểm tra xem đối tượng có phải là quái hộp trong SBSD hay không
        if obj:IsA("Model") and obj ~= LocalPlayer.Character then
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("PrimaryPart")
            
            if humanoid and rootPart and humanoid.Health > 0 then
                table.insert(targets, rootPart)
            end
        end
    end
    return targets
end

-- Vòng lặp bắn sát thương tầm xa toàn bộ map
task.spawn(function()
    while true do
        if _G.GlobalKillAura then
            local monsterParts = getAllTargets()
            
            -- Tìm cổng kết nối Remote của SBSD
            local attackRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Attack") 
                                 or ReplicatedStorage:FindFirstChild("Attack") 
                                 or ReplicatedStorage:FindFirstChild("Punch")
                                 or ReplicatedStorage:FindFirstChild("Hit")

            if attackRemote and attackRemote:IsA("RemoteEvent") then
                -- Ép sát thương lên tất cả mục tiêu cùng lúc trong danh sách quét
                for _, part in pairs(monsterParts) do
                    if _G.GlobalKillAura then
                        -- Gửi trực tiếp tọa độ của quái về server để nhận sát thương tầm xa
                        attackRemote:FireServer(part.Position)
                    else
                        break
                    end
                end
            end
        end
        task.wait(_G.AttackSpeed)
    end
end)

-- Tạo nút công tắc điều khiển trên giao diện Rayfield
local Toggle = MainTab:CreateToggle({
   Name = "Bật Kill Aura Toàn Bản Đồ (Gây Sát Thương)",
   CurrentValue = false,
   Flag = "GlobalKillAuraToggle",
   Callback = function(Value)
      _G.GlobalKillAura = Value
      if Value then
          Rayfield:Notify({Title = "SBSD Global", Content = "Đã ép sát thương Kill Aura lên toàn map!", Duration = 2.5})
      else
          Rayfield:Notify({Title = "SBSD Global", Content = "Đã ngắt kết nối sát thương.", Duration = 2.5})
      end
   end,
})
