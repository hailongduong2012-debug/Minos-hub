local isFarmToggled = false
local isKillAllToggled = false
local isReviving = false
local loopConnection = nil
local angle = 0
local NPC_HITBOX = Vector3.new(100, 100, 100)
local STORM_HITBOX = Vector3.new(99999999, 99999999, 99999999)
local farmEquipPending = true
local HEIGHT_OFFSET = -35
local selectedFarmMethod = "Magnet & Spin"
local stormTargetMode = "Box"

local stormSide = 1
local stormLastSwitch = 0
local lastStormSkillTime = 0
local currentTween = nil
local TWEEN_SPEED = 1000
local STORM_SWITCH_INTERVAL = 0.1

local SAFE_PATROL = {
    Vector3.new(-495.3, -22.3, 518.4),
    Vector3.new(481.9, -24.1, 513.1),
    Vector3.new(496.6, -26.1, -478.6),
    Vector3.new(-485.5, -21.9, -473.7),
}
local safePatrolIndex = 1
local lastSafeTargetPos = nil
local cachedJoints = {}
local lastStormTarget = nil

local function checkForcefield()
    local char = LocalPlayer.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child.Name:lower() == "forcefield" or child:IsA("ForceField") then
                return true
            end
        end
    end
    local elites = workspace:FindFirstChild("Elites")
    if elites then
        local eliteChar = elites:FindFirstChild(LocalPlayer.Name)
        if eliteChar then
            for _, child in ipairs(eliteChar:GetChildren()) do
                if child.Name:lower() == "forcefield" or child:IsA("ForceField") then
                    return true
                end
            end
        end
    end
    return false
end

local function tweenTo(root, targetCFrame)
    if not root then return end
    if currentTween then
        pcall(function() currentTween:Cancel() end)
    end
    root.Anchored = false
    root.AssemblyLinearVelocity = Vector3.zero

    local dist = (targetCFrame.Position - root.Position).Magnitude
    local time = math.max(dist / TWEEN_SPEED, 0.01)

    local tweenInfo = TweenInfo.new(
        time,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )
    currentTween = TweenService:Create(root, tweenInfo, { CFrame = targetCFrame })
    currentTween:Play()
end

local function handleSafeZone(playerRoot)
    local targetPos = SAFE_PATROL[safePatrolIndex]
    local dist = (playerRoot.Position - targetPos).Magnitude
    
    if dist < 15 then
        safePatrolIndex = safePatrolIndex % #SAFE_PATROL + 1
        targetPos = SAFE_PATROL[safePatrolIndex]
    end
    
    if targetPos ~= lastSafeTargetPos then
        lastSafeTargetPos = targetPos
        tweenTo(playerRoot, CFrame.new(targetPos))
    end
end

local function disableGrip(tool)
    local char = LocalPlayer.Character
    if not char or not tool then return end
    local handle = tool:FindFirstChild("Handle")
    for _, descendant in ipairs(char:GetDescendants()) do
        if descendant:IsA("JointInstance") or descendant:IsA("WeldConstraint") or descendant:IsA("Motor6D") then
            if descendant.Name:find("RightGrip") or (handle and (descendant.Part0 == handle or descendant.Part1 == handle) and descendant.Parent ~= tool) then
                if descendant.Parent ~= nil then
                    table.insert(cachedJoints, { joint = descendant, parent = descendant.Parent })
                    descendant.Parent = nil
                end
            end
        end
    end
end

local function enableGrip()
    for _, data in ipairs(cachedJoints) do
        if data.joint and data.parent and data.parent.Parent then
            pcall(function() data.joint.Parent = data.parent end)
        end
    end
    cachedJoints = {}
end

local function restoreNPCs()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            if not Players:GetPlayerFromCharacter(obj) then
                local hrp = obj.HumanoidRootPart
                hrp.Anchored = false
                hrp.CanCollide = true
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 1
            end
        end
    end
    enableGrip()
end

local function farmAutoEquipOnce(char)
    if not farmEquipPending then return end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        if not char:FindFirstChildOfClass("Tool") then
            local tool = getGearFromParent(backpack) or backpack:FindFirstChildOfClass("Tool")
            if tool then tool.Parent = char end
        end
    end
    if char:FindFirstChildOfClass("Tool") then farmEquipPending = false end
end

local function getActiveHandle()
    local char = LocalPlayer.Character
    if not char then return nil end
    farmAutoEquipOnce(char)
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        disableGrip(tool)
        local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
        if handle then
            handle.Anchored = false
            handle.CanCollide = false
        end
        return handle
    end
    return nil
end

local function isStormTarget(obj, char)
    if not obj or not obj:IsA("Model") then return false end
    if obj == char then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not obj:FindFirstChild("HumanoidRootPart") then return false end
    local nameLower = obj.Name:lower()
    
    if stormTargetMode == "Box" then
        return nameLower:find("box") ~= nil
           and not nameLower:find("boombox")
           and not nameLower:find("supporter")
    else
        return nameLower:find("astral") ~= nil
            or nameLower:find("void")   ~= nil
            or nameLower:find("doom")   ~= nil
    end
end

local function getUhhRemote(char)
    if not char then return nil end
    local ls = char:FindFirstChild("LocalScript")
    if not ls then return nil end
    return ls:FindFirstChild("uhh")
end

local function startFarmLoop()
    if loopConnection then loopConnection:Disconnect() end
    farmEquipPending = true
    safePatrolIndex = 1
    lastSafeTargetPos = nil
    stormSide = 1
    stormLastSwitch = 0
    lastStormSkillTime = 0
    lastStormTarget = nil
    local lastTeleportTime = 0
    local currentTargetIndex = 1

    loopConnection = runService.RenderStepped:Connect(function(deltaTime)
        if isReviving then return end

        local char = LocalPlayer.Character
        local playerRoot = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        if not isFarmToggled and not isKillAllToggled then
            loopConnection:Disconnect()
            restoreNPCs()
            if playerRoot then playerRoot.Anchored = false end
            return
        end

        if playerRoot and humanoid then
            local hasFF = checkForcefield()
            if not hasFF then
                lastStormTarget = nil
                handleSafeZone(playerRoot)
                return
            else
                lastSafeTargetPos = nil
                safePatrolIndex = 1
            end

            if selectedFarmMethod == "stormdiverautokill" then
                if tick() - lastStormSkillTime >= 0.5 then
                    lastStormSkillTime = tick()
                    local uhh = getUhhRemote(char)
                    if uhh then
                        pcall(function() 
                            uhh:FireServer(Enum.KeyCode.T)
                            uhh:FireServer(Enum.KeyCode.Y)
                            uhh:FireServer(Enum.KeyCode.Q)
                            uhh:FireServer(Enum.KeyCode.R)
                            uhh:FireServer("slide")
                        end)
                    end
                end

                local closest, closestDist = nil, math.huge

                if stormTargetMode == "Astral" then
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and isStormTarget(obj, char) and obj.Name:lower():find("glitch") then
                            local npcRoot = obj.HumanoidRootPart
                            npcRoot.Size = STORM_HITBOX
                            npcRoot.Transparency = 1
                            npcRoot.CanCollide = false

                            local dist = (npcRoot.Position - playerRoot.Position).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closest = obj
                            end
                        end
                    end
                end

                if not closest then
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and isStormTarget(obj, char) then
                            local npcRoot = obj.HumanoidRootPart
                            
                            npcRoot.Size = STORM_HITBOX
                            npcRoot.Transparency = 1
                            npcRoot.CanCollide = false

                            local dist = (npcRoot.Position - playerRoot.Position).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closest = obj
                            end
                        end
                    end
                end

                if closest then
                    local npcRoot = closest.HumanoidRootPart
                    local npcPos = npcRoot.Position

                    if closest ~= lastStormTarget then
                        lastStormTarget = closest
                        if currentTween then pcall(function() currentTween:Cancel() end) end
                        playerRoot.CFrame = CFrame.new(npcPos + Vector3.new(0, 3, 0))
                        stormSide = 1
                        stormLastSwitch = tick()
                        return
                    end

                    local now = tick()
                    if now - stormLastSwitch >= STORM_SWITCH_INTERVAL then
                        stormSide = -stormSide
                        stormLastSwitch = now

                        local sideOffset = Vector3.new(stormSide * 10, 0, 0)
                        local targetPos = npcPos + sideOffset
                        local targetCFrame = CFrame.new(targetPos, npcPos)

                        tweenTo(playerRoot, targetCFrame)
                    end
                else
                    lastStormTarget = nil
                    playerRoot.Anchored = false
                end
                return
            end

            local toolPart = nil
            if selectedFarmMethod == "Magnet & Spin" then
                toolPart = getActiveHandle()
            end

            angle = (angle + 3600 * deltaTime) % 360

            if selectedFarmMethod == "Magnet & Spin" then
                if toolPart then
                    toolPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    toolPart.AssemblyAngularVelocity = Vector3.new(1000, 10000, 1000)
                    local blackholeCFrame = playerRoot.CFrame * CFrame.new(0, HEIGHT_OFFSET, 0)
                    local spinCFrame = CFrame.Angles(math.rad(angle * 2), math.rad(angle * 5), math.rad(angle * 3))
                    local targetBodyPart = nil
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                            if obj ~= char and obj.Humanoid.Health > 0 then
                                local isPlayer = Players:GetPlayerFromCharacter(obj)
                                if (isFarmToggled and not isPlayer) or isKillAllToggled then
                                    local npcRoot = obj.HumanoidRootPart
                                    npcRoot.Anchored = true
                                    npcRoot.CanCollide = false
                                    if not isPlayer and npcRoot.Size ~= NPC_HITBOX then
                                        npcRoot.Size = NPC_HITBOX
                                        npcRoot.Transparency = 1
                                    end
                                    npcRoot.CFrame = blackholeCFrame * CFrame.Angles(0, math.rad(angle * 4), 0)
                                    if not targetBodyPart then
                                        targetBodyPart = obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso") or npcRoot
                                    end
                                end
                            end
                        end
                    end
                    if targetBodyPart then
                        toolPart.CFrame = targetBodyPart.CFrame * spinCFrame
                    else
                        toolPart.CFrame = blackholeCFrame * spinCFrame
                    end
                else
                    restoreNPCs()
                end
            elseif selectedFarmMethod == "autoclose" then
                local validTargets = {}
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                        if obj ~= char and obj.Humanoid.Health > 0 then
                            local isPlayer = Players:GetPlayerFromCharacter(obj)
                            local objNameLower = string.lower(obj.Name)
                            if not string.find(objNameLower, "boombox") then
                                if (isFarmToggled and not isPlayer) or isKillAllToggled then
                                    local npcRoot = obj.HumanoidRootPart
                                    npcRoot.Size = Vector3.new(15, 15, 15)
                                    npcRoot.Transparency = 0.5
                                    if string.find(objNameLower, "box") then
                                        table.insert(validTargets, obj)
                                    end
                                end
                            end
                        end
                    end
                end
                if #validTargets > 0 then
                    if tick() - lastTeleportTime >= 0.1 then
                        lastTeleportTime = tick()
                        currentTargetIndex = currentTargetIndex + 1
                    end
                    if currentTargetIndex > #validTargets then currentTargetIndex = 1 end
                    local targetNPC = validTargets[currentTargetIndex]
                    if targetNPC and targetNPC:FindFirstChild("HumanoidRootPart") then
                        playerRoot.Anchored = false
                        playerRoot.CFrame = targetNPC.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                        playerRoot.AssemblyLinearVelocity = Vector3.zero
                        local boxPart = targetNPC:FindFirstChild("Box")
                        if boxPart then
                            local closePrompt = boxPart:FindFirstChild("Close")
                            if closePrompt and closePrompt:IsA("ProximityPrompt") then
                                if fireproximityprompt then fireproximityprompt(closePrompt) end
                            end
                        end
                    end
                end
            end
        end
    end)
end

