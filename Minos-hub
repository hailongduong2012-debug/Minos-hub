local antiAdminConn = nil
addHackButton("🚫 Anti Admin Powers (Chống Fling)", function(state)
    if state then
        antiAdminConn = runService.Heartbeat:Connect(function()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
