-- [[ SBSD CAMPAIGN AUTO-ATTACK & BRING ENEMIES ]]
-- Giao diện: Rayfield UI (Bypass Key - Hiện UI ngay lập tức)

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "SBSD Campaign Hub | Rayfield",
   LoadingTitle = "Loading SBSD Script...",
   LoadingSubtitle = "by AI Assistant",
   ConfigurationSaving = {
      Enabled = false
   },
   KeySystem = false -- Tắt hệ thống bắt nhập Key rườm rà
})

local MainTab = Window:CreateTab("Main Campaign", 4483345998) -- Tạo Tab chính

-- Biến lưu trạng thái bật/tắt
local AuraActive = false
local BringActive = false

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Xác định Remote tấn công chuẩn của game Superbox Siege Defense
local AttackRemote = ReplicatedStorage:FindFirstChild("Attack") or ReplicatedStorage:FindFirstChild("HitEnemy")

-- 1. Tính năng Auto Attack (Giãn cách 0.15s an toàn, chống bị ban quét dữ liệu)
task.spawn(function()
    while true do
        task.wait(0.15)
        if AuraActive then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") and AttackRemote then
                    for _, enemy in pairs(workspace:GetDescendants()) do
                        if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            if not Players:GetPlayerFromCharacter(enemy) then
                                -- Tự động xả đòn đánh/chiêu thức bằng sát thương gốc của nhân vật
                                AttackRemote:FireServer(enemy)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- 2. Tính năng Gom Hút Quái về trước mặt (Client-side)
RunService.Heartbeat:Connect(function()
    if BringActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local gatherPos = hrp.Position + (hrp.CFrame.LookVector * 4) -- Gom quái cách trước mặt 4 Studs
            
            local enemiesFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Mobs") or workspace
            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") then
                    if enemy.Humanoid.Health > 0 and not Players:GetPlayerFromCharacter(enemy) then
                        enemy.HumanoidRootPart.CFrame = CFrame.new(gatherPos)
                        enemy.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
                    end
                end
            end
        end)
    end
end)

-- Tạo các nút bấm (Toggle) trên Rayfield UI
MainTab:CreateToggle({
   Name = "Auto Attack (Safe Aura)",
   CurrentValue = false,
   Flag = "AutoAttackFlag",
   Callback = function(Value)
      AuraActive = Value
   end,
})

MainTab:CreateToggle({
   Name = "Bring Enemies (Gom Quái)",
   CurrentValue = false,
   Flag = "BringEnemiesFlag",
   Callback = function(Value)
      BringActive = Value
   end,
})

Rayfield:Notify({
   Title = "SBSD Script Loaded!",
   Content = "Bảng menu Rayfield đã kích hoạt thành công.",
   Duration = 5,
   Image = 4483345998,
})
