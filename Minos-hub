-----------------------------------------------------
-- SILENT AIM CONFIG & UTILS
-----------------------------------------------------
local silentAimEnabled    = true
local silentAimDistance   = 5000
local silentAimPrediction = 0.165
local silentAimTargetMode = "Box"

local SA_TargetPart  = nil
local SA_CurrentNPC  = nil
local SA_Mouse       = LocalPlayer:GetMouse()
local lastScanTime   = 0
local SCAN_COOLDOWN  = 0.3

local function SA_IsCameraOrSystemScript()
    if not getcallingscript then return false end
    local sc = getcallingscript()
    if not sc then return false end
    local name = sc.Name:lower()
    if name:find("camera") or name:find("popper") or name:find("control") or name:find("player") then return true end
    return false
end

local function SA_IsBaseValid(model)
    if not model or not model:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(model) or model == LocalPlayer.Character then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function SA_IsValidNPC(model)
    if not SA_IsBaseValid(model) then return false end
    local nameLower = model.Name:lower()
    if silentAimTargetMode == "Box" then
        return nameLower:find("box") ~= nil and not nameLower:find("boombox") and not nameLower:find("supporter")
    else
        return nameLower:find("astral") ~= nil or nameLower:find("void") ~= nil or nameLower:find("doom") ~= nil
    end
end

local function SA_GetTargetPart(char)
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end

local function SA_UpdateTarget()
    local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localRoot then SA_CurrentNPC = nil; SA_TargetPart = nil; return end

    if SA_CurrentNPC and SA_IsValidNPC(SA_CurrentNPC) then
        local tPart = SA_GetTargetPart(SA_CurrentNPC)
        if tPart and (tPart.Position - localRoot.Position).Magnitude <= silentAimDistance then
            SA_TargetPart = tPart
            return
        end
    end

    local now = os.clock()
    if now - lastScanTime < SCAN_COOLDOWN then return end
    lastScanTime = now

    local closestNPC = nil
    local shortestDistance = silentAimDistance

    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and SA_IsValidNPC(obj) then
            local tPart = SA_GetTargetPart(obj)
            if tPart then
                local distance = (tPart.Position - localRoot.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestNPC = obj
                end
            end
        end
    end

    if closestNPC then
        SA_CurrentNPC = closestNPC
        SA_TargetPart = SA_GetTargetPart(closestNPC)
    else
        SA_CurrentNPC = nil; SA_TargetPart = nil
    end
end

runService.Heartbeat:Connect(function() pcall(SA_UpdateTarget) end)

