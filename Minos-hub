-- === 1. CƠ CHẾ SKY ANCHORED SAFE ZONE CHỐNG GIẬT LÙI TUYỆT ĐỐI ===
Toggle2.MouseButton1Click:Connect(function()
    SkyAnchoredActive = not SkyAnchoredActive
    Toggle2.Text = SkyAnchoredActive and "Sky Safe Zone (Chống Kéo Lùi) : ON" or "Sky Safe Zone (Chống Kéo Lùi) : OFF"
    Toggle2.TextColor3 = SkyAnchoredActive and Color3.fromRGB(80, 200, 80) or Color3.fromRGB(200, 70, 70)
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if SkyAnchoredActive and root then
        SavedLocation = root.CFrame
        root.CFrame = root.CFrame * CFrame.new(0, 550, 0)
    else
        if root then
            root.Anchored = false
            if SavedLocation then root.CFrame = SavedLocation end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if SkyAnchoredActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local char = LocalPlayer.Character
            local playerRoot = char.HumanoidRootPart
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            playerRoot.Anchored = true
            
            if humanoid then
                humanoid.BreakJointsOnDeath = false
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                if humanoid.Health < humanoid.MaxHealth then humanoid.Health = humanoid.MaxHealth end
            end
        end)
    end
end)


