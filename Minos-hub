-- [[ MINOS HUB PREMIUM ENGINE - UPDATE FOR SBSD ]]
-- TÍNH NĂNG: KILL AURA CHỈNH DELAY 0.0001S & RANGE TOÀN MAP (ĐÃ XÓA GOD MODE & AUTO SUMMON)

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local P = game:GetService("Players")
local LP = P.LocalPlayer
local RS = game:GetService("ReplicatedStorage")

local A_Active = false

-- === KHỞI TẠO BẢNG ĐIỀU KHIỂN RAYFIELD ===
local Window = Rayfield:CreateWindow({
   Name = "Minos hub Premium | SBSD EDITION",
   LoadingTitle = "Minos hub Loading...",
   LoadingSubtitle = "by minos",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "MinosHubSBSD",
      FileName = "MinosConfig"
   },
   Discord = {
      Enabled = false,
      Invite = "",
      RememberJoins = true
   },
   KeySystem = false
})

-- Tạo Tab chức năng Auto Farm
local FarmTab = Window:CreateTab("Death Mode Farm", 4483345998)

-- == TÍNH NĂNG GLOBAL KILL AURA TOÀN MAP DELAY 0.0001S ==
FarmTab:CreateToggle({
   Name = "Global Kill Aura (Infinite Range - Delay 0.0001s)",
   CurrentValue = false,
   Flag = "KillAuraFlag",
   Callback = function(Value)
      A_Active = Value
   end,
})

-- === HỆ THỐNG XỬ LÝ LOGIC CHẠY NGẦM KHÔNG HOÃN ===
task.spawn(function()
    while true do
        task.wait(0.0001) -- Độ trễ chính xác 0.0001s theo yêu cầu
        if A_Active and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                -- Tự động lấy vũ khí lên tay từ Backpack nếu chưa trang bị
                local tool = LP.Character:FindFirstChildOfClass("Tool")
                if not tool then
                    local backpackTool = LP.Backpack:FindFirstChildOfClass("Tool")
                    if backpackTool then
                        backpackTool.Parent = LP.Character
                        tool = backpackTool
                    end
                end

                -- Tìm kiếm hệ thống Remote chiến đấu của trò chơi
                local AttackRemote = RS:FindFirstChild("Attack") or RS:FindFirstChild("HitEnemy") or RS:FindFirstChild("Damage") or RS:FindFirstChild("Hit")
                
                -- Duyệt qua toàn bộ thực thể trong Workspace (Toàn Map không giới hạn khoảng cách)
                for _, enemy in pairs(workspace:GetChildren()) do
                    if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy:FindFirstChild("HumanoidRootPart") and enemy.Humanoid.Health > 0 then
                        if not P:GetPlayerFromCharacter(enemy) and enemy.Name ~= "Base" then
                            
                            -- Kích hoạt hành động vung/chém của vũ khí
                            if tool then 
                                tool:Activate() 
                            end
                            
                            -- Tấn công từ xa xuyên biên giới: Đồng loạt gửi các gói tin gây sát thương
                            if AttackRemote and AttackRemote:IsA("RemoteEvent") then
                                AttackRemote:FireServer(enemy, enemy.HumanoidRootPart.Position)
                                AttackRemote:FireServer(enemy.HumanoidRootPart, enemy.HumanoidRootPart.Position)
                                AttackRemote:FireServer(enemy, tool)
                            end
                        end
                    end
                end
            end)
        end
    end
end)
