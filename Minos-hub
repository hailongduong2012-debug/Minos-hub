-- SDBF Freeze Boss Script (Bản cập nhật mới nhất)
-- Loại trừ: Tora và Flower

local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

-- Danh sách các boss không được phép đóng băng
local ExcludedBosses = {
    ["Tora"] = true,
    ["Flower"] = true
}

local function FreezeEnemies()
    -- Thay đổi đường dẫn bên dưới nếu cấu trúc thư mục chứa Boss trong game có cập nhật
    local EnemiesFolder = Workspace:FindFirstChild("Enemies") or Workspace:FindFirstChild("Bosses")
    
    if EnemiesFolder then
        for _, enemy in pairs(EnemiesFolder:GetChildren()) do
            if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") then
                -- Kiểm tra tên boss xem có nằm trong danh sách loại trừ không
                if not ExcludedBosses[enemy.name] then
                    local hrp = enemy.HumanoidRootPart
                    -- Đóng băng bằng cách neo vị trí (Anchor) và xóa vận tốc
                    hrp.Anchored = true
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.RotVelocity = Vector3.new(0, 0, 0)
                    
                    -- Đảm bảo quái không thể hồi phục vị trí di chuyển
                    local humanoid = enemy:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        humanoid.WalkSpeed = 0
                        humanoid.JumpPower = 0
                    end
                else
                    -- Nếu là Tora hoặc Flower thì bỏ neo để boss hoạt động bình thường
                    local hrp = enemy.HumanoidRootPart
                    if hrp.Anchored then
                        hrp.Anchored = false
                    end
                end
            end
        end
    end
end

-- Vòng lặp liên tục để tự động đóng băng các boss mới xuất hiện
RunService.Heartbeat:Connect(function()
    pcall(FreezeEnemies)
end)
