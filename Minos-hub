-- === CONFIG CÁC NÚT BẤM (MỜ ĐỂ THẤY NỀN) ===
local function CreateDoomButton(text, posY)
    local btn = Instance.new("TextButton")
    btn.Parent = Main
    btn.Size = UDim2.new(0, 290, 0, 40)
    btn.Position = UDim2.new(0, 15, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    btn.BackgroundTransparency = 0.2 -- Tạo hiệu ứng kính nhìn xuyên qua thấy hình nền
    btn.Text = text .. " : OFF"
    btn.TextColor3 = Color3.fromRGB(220, 80, 80)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.ZIndex = 2
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    return btn
end

