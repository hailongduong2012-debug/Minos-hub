-- MINOS HUB | SBSD GLOBAL PASSIVE TOUCH (KHÔNG CAN THIỆP SÂU)
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "MINOS HUB | SBSD",
   LoadingTitle = "Đang cấu hình Safe Passive Aura...",
   LoadingSubtitle = "BY MINOS",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false 
})

local MainTab = Window:CreateTab("Passive Aura", 4483362458)

_G.PassiveAura = false
_G.HitboxSize = 250 -- Phóng to kích thước hitbox để bao phủ toàn bộ map Campaign/Death Mode

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Hàm xử lý ép va chạm vật lý giữa vũ khí và quái toàn map
local function applyGlobalPassiveTouch()
    local character = LocalPlayer.Character
    if not character then return end
    
    -- Tìm vũ khí (Tool) bạn đang cầm trên tay
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end
    
    -- Tìm phần lưỡi kiếm hoặc phần gây sát thương của vũ khí (thường là Handle hoặc Blade)
    local toolHandle = tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("Part")
    if not toolHandle then return end

    local enemyContainer = workspace:FindFirstChild("Enemies") or workspace

    for _, child in pairs(enemyContainer:GetChildren()) do
        if child:IsA("Model") and child ~= character then
            local humanoid = child:FindFirstChildOfClass("Humanoid")
            local enemyRoot = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("PrimaryPart")
            
            if humanoid and enemyRoot and humanoid.Health > 0 then
                -- 1. Phóng to hitbox nhận sát thương của quái vật cực đại
                enemyRoot.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
                enemyRoot.Transparency = 0.8
                enemyRoot.CanCollide = false
                
                -- 2. Ép vị trí hitbox của quái trùng khít vào lưỡi kiếm của bạn để kích hoạt sự kiện .Touched của game
                enemyRoot.CFrame = toolHandle.CFrame
            end
        end
    end
end

-- Vòng lặp quét và xử lý va chạm liên tục mỗi 0.1 giây
task.spawn(function()
    while true do
        if _G.PassiveAura then
            pcall(applyGlobalPassiveTouch)
        end
        task.wait(0.1) -- Giãn cách an toàn giúp giảm tải CPU và tránh bị Anticheat nghi ngờ spam
    end
end)

