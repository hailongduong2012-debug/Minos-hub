-- === 1. CƠ CHẾ CÁCH LY VÙNG TIỆM CẬN (SUB-SPACE SAFE ZONE) ===
Toggle2.MouseButton1Click:Connect(function()
    SafeZoneActive = not SafeZoneActive
    Toggle2.Text = SafeZoneActive and "Sub-Space Safe Zone (Chống Ban) : ON" or "Sub-Space Safe Zone (Chống Ban) : OFF"
    Toggle2.TextColor3 = SafeZoneActive and Color3.fromRGB(80, 200, 80) or Color3.fromRGB(200, 70, 70)
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if SafeZoneActive and root then
        SavedPos = root.CFrame
        -- Đưa nhân vật lên độ cao tiệm cận 3000 block (Vừa đủ né hoàn toàn Boss Death Mode, vừa giữ khoảng cách nhảy damage)
        local VoidTarget = CFrame.new(root.Position.X, 3000, root.Position.Z)
        root.CFrame = VoidTarget
        
        -- Tạo sàn đấu ảo nâng chân bảo vệ
        FakeFloor = Instance.new("Part")
        FakeFloor.Size = Vector3.new(40, 1, 40)
        FakeFloor.CFrame = VoidTarget * CFrame.new(0, -3, 0)
        FakeFloor.Anchored = true
        FakeFloor.Material = Enum.Material.ForceField
        FakeFloor.Parent = workspace
    else
        if FakeFloor then FakeFloor:Destroy() FakeFloor = nil end
        if root and SavedPos then root.CFrame = SavedPos end
    end
end)

-- Giữ cứng vị trí và khóa thuộc tính sinh học không cho Server check rơi tự do
RunService.PreSimulation:Connect(function()
    if SafeZoneActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local char = LocalPlayer.Character
            char.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
            
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.BreakJointsOnDeath = false
                hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
            end
        end)
    end
end)


