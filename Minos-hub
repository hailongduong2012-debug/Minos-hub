end)

-- Cơ chế bất tử FF: Liên tục xóa bỏ trạng thái nhận sát thương (State) và giữ máu không thể tụt
RunService.Stepped:Connect(function()
    if GodModeActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        pcall(function()
            local hum = LocalPlayer.Character.Humanoid
            hum.MaxHealth = math.huge
            hum.Health = math.huge
            -- Chặn đứng các hiệu ứng đổi trạng thái chết đột ngột
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end
end)


-- === LOGIC BRING ENEMIES ===
Toggle2.MouseButton1Click:Connect(function()
    BringActive = not BringActive
    if BringActive then
        Toggle2.Text = "Bring Enemies (Gom Quái) : ON"
        Toggle2.TextColor3 = Color3.fromRGB(80, 200, 80)
    else
        Toggle2.Text = "Bring Enemies (Gom Quái) : OFF"
        Toggle2.TextColor3 = Color3.fromRGB(200, 70, 70)
    end
end)

RunService.Heartbeat:Connect(function()
    if BringActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local gatherPos = hrp.Position + (hrp.CFrame.LookVector * 4)
            
            local enemiesFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Mobs") or workspace
            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") then
                    if enemy.Humanoid.Health > 0 and not Players:GetPlayerFromCharacter(enemy) then
                        enemy.HumanoidRootPart.CFrame = CFrame.new(gatherPos)
                        enemy.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
                    end
                end
            end
        end)
    end
end)
