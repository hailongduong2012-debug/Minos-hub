    label.ZIndex = 3
    
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0, 55, 0, 26)
    btn.Position = UDim2.new(1, -65, 0, 9)
    btn.BackgroundColor3 = Color3.fromRGB(150, 40, 40) -- Đỏ là OFF
