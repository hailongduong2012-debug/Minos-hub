-- 1. TÍNH NĂNG: Global Gear Attack Tấn Công Toàn Map Từ Xa (Không làm nhân vật bị lướt)
task.spawn(function()
    while true do
        task.wait(0.04) -- Tần suất gây sát thương liên tục
        if AuraActive then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        -- Lấy các cổng Remote nhận đòn đánh nội bộ của cây vũ khí đang cầm và hệ thống game
                        local weaponRemote = tool:FindFirstChild("Remote") or tool:FindFirstChild("Action") or tool:FindFirstChild("Attack") or tool:FindFirstChild("Hit")
                        local globalRemote = ReplicatedStorage:FindFirstChild("Attack") or ReplicatedStorage:FindFirstChild("HitEnemy") or ReplicatedStorage:FindFirstChild("InflictDamage")

                        -- Quét sạch 100% quái vừa spawn ra trên map không giới hạn khoảng cách
                        for _, enemy in pairs(workspace:GetDescendants()) do
                            if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                                if not Players:GetPlayerFromCharacter(enemy) and enemy.Name ~= "Base" then
                                    local enemyHrp = enemy:FindFirstChild("HumanoidRootPart")
                                    if enemyHrp then
                                        -- Gửi tín hiệu dồn sát thương từ xa bỏ qua hoạt ảnh lướt vung đòn của nhân vật
                                        if weaponRemote and weaponRemote:IsA("RemoteEvent") then
                                            weaponRemote:FireServer(enemy, enemyHrp.Position)
                                        end
                                        if globalRemote then
                                            if globalRemote:IsA("RemoteEvent") then
                                                globalRemote:FireServer(enemy, tool)
                                            elseif globalRemote:IsA("RemoteFunction") then
                                                globalRemote:InvokeServer(enemy, tool)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- 2. TÍNH NĂNG: Safe Zone Max God Mode (Khóa đầy máu thời gian thực cấp độ nhịp tim hệ thống)
RunService.Heartbeat:Connect(function()
    if GodModeActive then
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.Health = hum.MaxHealth -- Liên tục bơm đầy máu chống chết sốclag ở Death Mode
                    if hum.Health <= 0 then
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                        hum.Health = hum.MaxHealth
                    end
                end
                if not char:FindFirstChildOfClass("ForceField") then
                    Instance.new("ForceField", char)
                end
            end
        end)
    end
end)

