local FULLSCREEN_SIZE = UDim2.new(9999, 9999, 99999, 99999)
local function stretch(gui, size)
  if gui and gui:IsA("GuiObject") then
    gui.Visible = true
    gui.Position = UDim2.new(0, 0, 0, 0)
    gui.Size = size
    gui.ZIndex = 99999
    if gui:IsA("ScrollingFrame") then gui.CanvasPosition = Vector2.new(0, 0) end
  end
end

local function f33(btn)
  if not btn or not btn:IsA("GuiObject") then return false end
  local parent = btn.Parent
  if parent then
    for _, child in ipairs(parent:GetChildren()) do
      if child:IsA("UIGridLayout") or child:IsA("UIListLayout") then child:Destroy() end
    end
  end
  stretch(btn, UDim2.new(1, 0, 99999, 99999))
  local ancestor = parent
  for _ = 1, 3 do
    if not ancestor or ancestor:IsA("LayerCollector") then break end
    stretch(ancestor, FULLSCREEN_SIZE)
    ancestor = ancestor.Parent
  end
  local screenGui = btn:FindFirstAncestorWhichIsA("ScreenGui")
  if screenGui then screenGui.DisplayOrder = 99999 end
  task.wait(0.05)
  clickScreenCenter()
  return true
end

local charForcedTries = 0
local nextCharTry = 0
local function f34()
  if tick() < nextCharTry then return false end
  local playerGui = getPlayerGui()
  local charClass = playerGui and playerGui:FindFirstChild("CharClass")
  if not charClass then return false end
  
  local targetBtn = nil
  
  -- Tìm đúng path theo yêu cầu
  local scroll = charClass:FindFirstChild("Scroll")
  if scroll then
      if selectedAutoChar == "Cam" then
          local frame = scroll:FindFirstChild("Frame")
          if frame and frame:FindFirstChild("Cam") then
              targetBtn = frame.Cam
          end
      elseif selectedAutoChar == "speedy" then
          local crossover = scroll:FindFirstChild("crossover")
          if crossover and crossover:FindFirstChild("speedy") then
              targetBtn = crossover.speedy
          end
      end
  end
  
  -- Nếu chọn Admin hoặc không tìm thấy bằng path, tìm quyét qua toàn bộ nhánh
  if not targetBtn then
      for _, desc in ipairs(charClass:GetDescendants()) do
          if desc:IsA("GuiObject") and desc.Name == selectedAutoChar then
              targetBtn = desc
              break
          end
      end
  end
  
  if not targetBtn then return false end

  local forced = not charClass.Enabled
  if forced then
    if charForcedTries >= 5 then return false end
    charForcedTries = charForcedTries + 1
    charClass.Enabled = true
  end
  nextCharTry = tick() + 1
  
  for _, child in ipairs(charClass:GetChildren()) do
      if child:IsA("ScrollingFrame") then child.Visible = false end
  end
  
  local parent = targetBtn.Parent
  while parent and parent ~= charClass do
      if parent:IsA("ScrollingFrame") then
          parent.Visible = true
      end
      parent = parent.Parent
  end
  
  f33(targetBtn)
  
  if forced then task.wait(0.2); if charClass.Parent then charClass.Enabled = false end end
  return true
end

