                                        remoteFolder.Parent = ReplicatedStorage
                                    end
                                    local playerRemote = remoteFolder:FindFirstChild(player.Name)
                                    if not playerRemote then
                                        playerRemote = Instance.new("RemoteEvent")
                                        playerRemote.Name = player.Name
                                        playerRemote.Parent = remoteFolder
                                    end
                                    playerRemote:FireServer(player.Name)
                                end)

                                local char = workspace:FindFirstChild(player.Name)
                                local myChar = LocalPlayer.Character
                                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                                local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid")

                                local head = char and char:FindFirstChild("Head")
                                local revivePrompt = head and head:FindFirstChild("Revive")

                                if revivePrompt and revivePrompt:IsA("ProximityPrompt") and head and myRoot and myHum and myHum.Health > 0 then
                                    isReviving = true
                                    if currentTween then pcall(function() currentTween:Cancel() end) end

                                    local savedCFrame = myRoot.CFrame
                                    myRoot.AssemblyLinearVelocity = Vector3.zero
                                    myRoot.CFrame = CFrame.new(head.Position + Vector3.new(0, 3, 0))

                                    revivePrompt.HoldDuration = 0
                                    if fireproximityprompt then
                                        fireproximityprompt(revivePrompt)
                                    else
                                        f22()
                                    end

                                    task.wait(0.015)

                                    if LocalPlayer.Character == myChar and myRoot.Parent and myHum.Health > 0 then
                                        myRoot.AssemblyLinearVelocity = Vector3.zero
                                        myRoot.CFrame = savedCFrame
                                    end

                                    lastStormTarget = nil
                                    lastSafeTargetPos = nil
                                    safePatrolIndex = 1
                                    isReviving = false
                                end

                                task.wait(0.015)
                            end
                        end)
                    end
                end
            end
            task.wait(0.015)
        end
        isReviving = false
    end)
end

local EliteRevive = {
    Enabled   = false,
    Running   = false,
    SpamDelay = 0.015,
    Timeout   = 10,
}

function EliteRevive.GetPrompt(player)
    local elites = workspace:FindFirstChild("Elites")
    local eliteChar = elites and elites:FindFirstChild(player.Name)
    local hrp = eliteChar and eliteChar:FindFirstChild("HumanoidRootPart")
    local prompt = hrp and (hrp:FindFirstChild("ProximityPrompt") or hrp:FindFirstChildOfClass("ProximityPrompt"))
    return prompt, hrp
end

function EliteRevive.Run()
    if EliteRevive.Running then return end
    EliteRevive.Running = true

    task.spawn(function()
        while EliteRevive.Enabled do
            local allPlayers = Players:GetPlayers()
            for _, plr in ipairs(allPlayers) do
                if plr ~= LocalPlayer then
                    task.spawn(function()
                        while EliteRevive.Enabled and plr.Parent do
                            pcall(function()
                                local remoteFolder = ReplicatedStorage:FindFirstChild("ReviveRemotes")
                                if not remoteFolder then
                                    remoteFolder = Instance.new("Folder")
                                    remoteFolder.Name = "ReviveRemotes"
                                    remoteFolder.Parent = ReplicatedStorage
                                end
                                local playerRemote = remoteFolder:FindFirstChild(plr.Name)
                                if not playerRemote then
                                    playerRemote = Instance.new("RemoteEvent")
                                    playerRemote.Name = plr.Name
                                    playerRemote.Parent = remoteFolder
                                end
                                playerRemote:FireServer(plr.Name)
                            end)

                            local prompt, targetHrp = EliteRevive.GetPrompt(plr)
                            local myChar = LocalPlayer.Character
                            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                            local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid")

                            if prompt and targetHrp and myRoot and myHum and myHum.Health > 0 then
                                isReviving = true
                                if currentTween then pcall(function() currentTween:Cancel() end) end

                                local savedCFrame = myRoot.CFrame

                                pcall(function()
                                    local startT = tick()
                                    while EliteRevive.Enabled and tick() - startT < EliteRevive.Timeout do
                                        if LocalPlayer.Character ~= myChar then break end
                                        if not myHum or myHum.Health <= 0 then break end
                                        if not plr.Parent then break end

                                        local curPrompt, curHrp = EliteRevive.GetPrompt(plr)
                                        if not curPrompt or not curHrp or not curPrompt.Enabled then break end

                                        myRoot.AssemblyLinearVelocity = Vector3.zero
                                        myRoot.CFrame = CFrame.new(curHrp.Position + Vector3.new(0, 3, 0))

                                        curPrompt.HoldDuration = 0
                                        if fireproximityprompt then
                                            fireproximityprompt(curPrompt)
                                        else
                                            f22()
                                        end
                                        task.wait(EliteRevive.SpamDelay)
                                    end
                                end)

                                if LocalPlayer.Character == myChar and myRoot.Parent and myHum.Health > 0 then
                                    myRoot.AssemblyLinearVelocity = Vector3.zero
                                    myRoot.CFrame = savedCFrame
                                end

                                lastStormTarget = nil
                                lastSafeTargetPos = nil
                                safePatrolIndex = 1
                                isReviving = false
                            end

                            task.wait(EliteRevive.SpamDelay)
                        end
                    end)
                end
            end
            task.wait(1)
        end

        isReviving = false
        EliteRevive.Running = false
    end)
end

