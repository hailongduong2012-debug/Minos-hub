-- === HỆ THỐNG XỬ LÝ TOÀN BỘ LOGIC GAMEPLAY SBSD CHẠY NGẦM ===

-- 1. Xử lý Kill Aura Max Range Delay 0 (Gửi dồn dập gói tin tấn công thời gian thực qua nhịp khung hình Stepped)
RunS.Stepped:Connect(function()
    if A_Active and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            -- Tự động kiểm tra và trang bị vũ khí lên tay từ Backpack
            local tool = LP.Character:FindFirstChildOfClass("Tool")
            if not tool then
                local backpackTool = LP.Backpack:FindFirstChildOfClass("Tool")
                if backpackTool then
                    backpackTool.Parent = LP.Character
                    tool = backpackTool
                end
            end

            -- Tìm kiếm Remote chiến đấu thực tế của game SBSD để ép nhảy damage
            local AttackRemote = RS:FindFirstChild("Attack") or RS:FindFirstChild("HitEnemy") or RS:FindFirstChild("Damage") or RS:FindFirstChild("Hit")
            
            -- Quét toàn bộ workspace (Max Range) không giới hạn khoảng cách quái vật
            for _, enemy in pairs(workspace:GetChildren()) do
                if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy:FindFirstChild("HumanoidRootPart") and enemy.Humanoid.Health > 0 then
                    if not P:GetPlayerFromCharacter(enemy) and enemy.Name ~= "Base" then
                        
                        -- Vung vũ khí liên tục thời gian thực không độ trễ
                        if tool then 
                            tool:Activate() 
                        end
                        
                        -- CƠ CHẾ ĐÁNH XA BYPASS CHECK: Gửi đồng thời Vector3 vị trí quái để đánh lừa máy chủ cự ly đòn đánh hợp lệ
                        if AttackRemote and AttackRemote:IsA("RemoteEvent") then
                            AttackRemote:FireServer(enemy, enemy.HumanoidRootPart.Position)
                            AttackRemote:FireServer(enemy.HumanoidRootPart, enemy.HumanoidRootPart.Position)
                            AttackRemote:FireServer(enemy, tool)
                        end
                    end
                end
            end
        end)
    end
end)

-- 2. Xử lý Bất tử tuyệt đối chống chết ngầm (Max God Mode)
RunS.Stepped:Connect(function()
    if G_Active then
        pcall(function()
            local char = LP.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    -- Liên tục khóa máu đầy cây thời gian thực
                    hum.Health = hum.MaxHealth 
                    
                    -- Cơ chế ép hồi sinh khẩn cấp tại chỗ: Nếu bị dính đòn chí mạng hoặc trạng thái chuyển thành Dead, ép sống lại lập tức
                    if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                        hum.Health = hum.MaxHealth
                    end
                end
                -- Tự động duy trì Khiên bất hoại ForceField bảo vệ cấu trúc nhân vật
                if not char:FindFirstChildOfClass("ForceField") then
                    Instance.new("ForceField", char)
                end
            end
        end)
    end
end)

-- 3. Xử lý Tự động đặt lính lính Telescope khi tích đủ 5 Coins
task.spawn(function()
    while true do
        task.wait(0.4)
        if T_Active then
            pcall(function()
                local SummonRemote = RS:FindFirstChild("PlaceUnit") or RS:FindFirstChild("SpawnUnit") or RS:FindFirstChild("HEUGHSUMMONS") or RS:FindFirstChild("Summon")
                local stats = LP:FindFirstChild("leaderstats")
                local cash = stats and (stats:FindFirstChild("Cash") or stats:FindFirstChild("Coins") or stats:FindFirstChild("Points"))
                
                if cash and cash.Value >= 5 and SummonRemote then
                    local spawnPos = LP.Character and LP.Character.HumanoidRootPart.Position or Vector3.new(0, 0, 0)
                    SummonRemote:FireServer("Telescope", spawnPos)
                end
            end)
        end
    end
end)
