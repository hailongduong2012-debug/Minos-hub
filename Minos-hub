-- Hàm tìm mục tiêu hợp lệ trong trận đấu (Không quét ở sảnh)
local function getSBSDTargets()
    local validTargets = {}
    -- Anti-Cheat SBSD chứa quái trong folder "Enemies" hoặc trực tiếp tại Workspace khi vào trận
    local enemyContainer = workspace:FindFirstChild("Enemies") or workspace
    
    for _, child in pairs(enemyContainer:GetChildren()) do
        if child:IsA("Model") and child ~= LocalPlayer.Character then
            local humanoid = child:FindFirstChildOfClass("Humanoid")
            local mainPart = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("PrimaryPart")
            
            if humanoid and mainPart and humanoid.Health > 0 then
                table.insert(validTargets, mainPart)
            end
        end
    end
    return #validTargets > 0 and validTargets or nil
end

-- Vòng lặp mô phỏng click chuột vật lý siêu an toàn
task.spawn(function()
    while true do
        if _G.QuorumAura then
            local currentEnemies = getSBSDTargets()
            
            -- Chỉ bấm chuột khi hệ thống xác nhận ĐÃ VÀO TRẬN và CÓ QUÁI XUẤT HIỆN
            if currentEnemies then
                local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool then
                    -- Mô phỏng nhấp chuột trái vật lý (An toàn 100% trước Namecall Detector)
                    VirtualUser:ClickButton1(Vector2.new(0, 0))
                end
            end
        end
        -- Luôn giữ thời gian chờ biến thiên một chút để giả lập hành vi con người
        task.wait(_G.AttackSpeed + math.random(1, 9) / 100)
    end
end)

