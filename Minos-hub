-- AUTO REVIVE (Teleport tới người gục và cứu ngay lập tức - Không lag)
-----------------------------------------------------
local isAutoReviveToggled = false
local isReviving = false

local function autoReviveLoop()
    task.spawn(function()
        while isAutoReviveToggled do
            local allPlayers = Players:GetPlayers()
            for _, player in ipairs(allPlayers) do
                if player ~= LocalPlayer and isAutoReviveToggled then
                    pcall(function()
                        local remoteFolder = ReplicatedStorage:FindFirstChild("ReviveRemotes")
                        if not remoteFolder then
                            remoteFolder = Instance.new("Folder")
                            remoteFolder.Name = "ReviveRemotes"
                            remoteFolder.Parent = ReplicatedStorage
                        end
                        local playerRemote = remoteFolder:FindFirstChild(player.Name)
                        if not playerRemote then
                            playerRemote = Instance.new("RemoteEvent")
                            playerRemote.Name = player.Name
                            playerRemote.Parent = remoteFolder
                        end
                        playerRemote:FireServer(player.Name)
                    end)

                    local char = workspace:FindFirstChild(player.Name)
                    local myChar = LocalPlayer.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid")

                    local head = char and char:FindFirstChild("Head")
                    local revivePrompt = head and head:FindFirstChild("Revive")

                    if revivePrompt and revivePrompt:IsA("ProximityPrompt") and head and myRoot and myHum and myHum.Health > 0 then
                        isReviving = true
                        local savedCFrame = myRoot.CFrame
                        myRoot.AssemblyLinearVelocity = Vector3.zero
                        myRoot.CFrame = CFrame.new(head.Position + Vector3.new(0, 3, 0))

                        revivePrompt.HoldDuration = 0
                        if fireproximityprompt then
                            fireproximityprompt(revivePrompt)
                        else
                            virtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                            task.wait(0.1)
                            virtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                        end

                        task.wait(0.05)

                        if LocalPlayer.Character == myChar and myRoot.Parent and myHum.Health > 0 then
                            myRoot.AssemblyLinearVelocity = Vector3.zero
                            myRoot.CFrame = savedCFrame
                        end
                        isReviving = false
                    end
                end
            end
            task.wait(0.3)
        end
        isReviving = false
    end)
end

