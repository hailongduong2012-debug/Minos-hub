                                AttackRemote:InvokeServer(enemy)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- 2. Bật/Tắt Gom Hút Quái về trước mặt
Toggle2.MouseButton1Click:Connect(function()
    BringActive = not BringActive
    if BringActive then
        Toggle2.Text = "Bring Enemies (Gom Quái) : ON"
        Toggle2.TextColor3 = Color3.fromRGB(80, 220, 80)
