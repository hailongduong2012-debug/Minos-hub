-- Toggle 1: Chọn Nhân Vật (Phương thức quét đè toàn bộ Remote)
AutoCampaignTab:CreateToggle({
   Name = "Chọn Nhân Vật (Garry Method)",
   CurrentValue = false,
   Callback = function(Value)
      States.SelectCharacter = Value
      if Value then
          task.spawn(function()
              while States.SelectCharacter do
                  pcall(function()
                      -- Quét sâu toàn bộ ReplicatedStorage để ép kích hoạt chọn nhân vật
                      for _, remote in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                          if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
                              local rName = string.lower(remote.Name)
                              if string.find(rName, "char") or string.find(rName, "slot") or string.find(rName, "select") then
                                  if remote:IsA("RemoteFunction") then
                                      remote:InvokeServer("GarryCharacter")
                                  else
                                      remote:FireServer("GarryCharacter")
                                  end
                              end
                          end
                      end
                  end)
                  task.wait(2)
              end
          end)
      end
   end,
})

-- Toggle 2: Auto Gear & Get Rainbow Sword (Cơ chế đồng bộ hóa luồng mới)
AutoCampaignTab:CreateToggle({
   Name = "Auto Gear & Get Rainbow Sword",
   CurrentValue = false,
   Callback = function(Value)
      States.GearAndRainbow = Value
      if Value then
          task.spawn(function()
              while States.GearAndRainbow do
                  States.IsProcessingGear = true -- Bật cờ ưu tiên (Khóa hotbar tạm buông)
                  
                  pcall(function()
                      local character = LocalPlayer.Character
                      local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                      
                      -- Tìm kiếm mọi vũ khí phụ trách Gear trong balo để lôi ra dùng chiêu
                      if backpack then
                          for _, item in ipairs(backpack:GetChildren()) do
                              if item:IsA("Tool") and string.find(string.lower(item.Name), "gear") then
                                  if character and character:FindFirstChild("Humanoid") then
                                      character.Humanoid:EquipTool(item)
                                  end
                              end
                          end
                      end
                      
                      task.wait(0.2)
                      
                      -- Kích hoạt chiêu thức Gear ẩn bằng cách quét diện rộng
                      for _, remote in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                          if remote:IsA("RemoteEvent") then
                              local rName = string.lower(remote.Name)
                              if string.find(rName, "gear") or string.find(rName, "skill") or string.find(rName, "ability") then
                                  remote:FireServer("ActivateSkill")
                                  remote:FireServer(true)
                                  remote:FireServer()
                              end
                          end
                      end
                      
                      task.wait(0.5) -- Đợi chiêu sinh ra hiệu ứng lấy kiếm
                      
                      -- Gọi kết nối getconnections lấy kiếm Rainbow ẩn danh
                      if getconnections then
                          for _, con in ipairs(getconnections(game:GetService("ReplicatedStorage").ChildAdded)) do
                              pcall(function() con:Fire() end)
                          end
                      end
                  end)
                  
                  task.wait(1.5)
                  States.IsProcessingGear = false -- Trả quyền lại cho bộ khóa cứng
              end
          end)
      end
   end,
})

-- Toggle 3: Auto Equip & Khóa Cứng Kiếm Rainbow (Chống đổi sang vũ khí khác)
AutoCampaignTab:CreateToggle({
   Name = "Auto Equip & Khóa Kiếm Rainbow",
   CurrentValue = false,
   Callback = function(Value)
      States.AutoEquipLock = Value
      if Value then
          task.spawn(function()
              while States.AutoEquipLock do
                  -- Chỉ khóa khi không trong chu kỳ kích hoạt Gear
                  if not States.IsProcessingGear then
                      pcall(function()
                          local character = LocalPlayer.Character
                          local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                          
                          if character and backpack then
                              local rainbow = backpack:FindFirstChild("Rainbow Sword")
                              
                              -- Nếu kiếm nằm trong balo, tự động lôi ra tay
                              if rainbow and character:FindFirstChild("Humanoid") then
                                  character.Humanoid:EquipTool(rainbow)
                              end
                              
                              -- Vòng lặp cưỡng chế: Cầm bất cứ Gear nào khác lập tức đá văng về balo
                              for _, item in ipairs(character:GetChildren()) do
                                  if item:IsA("Tool") and item.Name ~= "Rainbow Sword" then
                                      item.Parent = backpack
                                  end
                              end
                          end
                      end)
                  end
                  task.wait(0.05) -- Tốc độ kiểm tra 50ms (Khóa siêu cứng hotbar)
              end
          end)
      end
   end,
})

-- Toggle 4: Auto Teleport & Đập Box Sát Thương Triệu Đơn Vị (Chống Kẹt)
AutoCampaignTab:CreateToggle({
   Name = "Auto Teleport & Đập Box",
   CurrentValue = false,
   Callback = function(Value)
      States.AutoFarmBoss = Value
      if Value then
          task.spawn(function()
              while States.AutoFarmBoss do
                  pcall(function()
                      local target = GetTargetInstance()
                      if target then
                          local targetPart = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChildOfClass("BasePart")
                          local character = LocalPlayer.Character
                          local root = character and character:FindFirstChild("HumanoidRootPart")
                          
                          if targetPart and root then
                              -- Cơ chế Teleport áp sát từ phía trên hoặc ngang hông Box tránh kẹt góc bản đồ
                              root.CFrame = targetPart.CFrame * CFrame.new(0, -1, 1.5)
                              
                              -- Logic tấn công quét đa điểm bằng pcall
                              local tool = character:FindFirstChild("Rainbow Sword")
                              if tool then
                                  -- Tự tìm RemoteEvent tấn công nằm trực tiếp bên trong thanh kiếm hoặc ReplicatedStorage
                                  local attackRemote = tool:FindFirstChildOfClass("RemoteEvent") 
                                  if not attackRemote then
                                      for _, r in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                                          if r:IsA("RemoteEvent") and (string.find(string.lower(r.Name), "attack") or string.find(string.lower(r.Name), "hit")) then
                                              attackRemote = r
                                              break
                                          end
                                      end
                                  end
                                  
                                  if attackRemote then
                                      local totalDmg = tonumber(States.BossDamageInput) or 1000000
                                      -- Đập dồn dập gói tin để đạt mốc 1.000.000 sát thương trong 1 chu kỳ chém
                                      for i = 1, totalDmg do
                                          if not States.AutoFarmBoss then break end
                                          attackRemote:FireServer(target)
                                      end
                                  end
                              end
                          end
                      end
                  end)
                  -- Độ trễ chém chia cho 100 theo đúng yêu cầu
                  task.wait(States.AttackDelay / 100)
              end
          end)
      end
   end,
})

