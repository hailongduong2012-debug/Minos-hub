local cachedJoints = {}
local freezeCFrame = nil

-----------------------------------------------------
-- UTILITY FUNCTIONS
-----------------------------------------------------
local function getGearFromParent(container)
    if not container then return nil end
    for _, child in ipairs(container:GetChildren()) do
        local lowerName = string.lower(child.Name)
        if string.find(lowerName, "sword") or string.find(lowerName, "axe") or string.find(lowerName, "periastron") or string.find(lowerName, "pe") then
            return child
        end
    end
    return nil
end

local function disableGrip(tool)
    local char = LocalPlayer.Character
    if not char or not tool then return end
    local handle = tool:FindFirstChild("Handle")
    for _, descendant in ipairs(char:GetDescendants()) do
        if descendant:IsA("JointInstance") or descendant:IsA("WeldConstraint") or descendant:IsA("Motor6D") then
            if descendant.Name:find("RightGrip") or (handle and (descendant.Part0 == handle or descendant.Part1 == handle) and descendant.Parent ~= tool) then
                if descendant.Parent ~= nil then
                    table.insert(cachedJoints, { joint = descendant, parent = descendant.Parent })
                    descendant.Parent = nil
                end
            end
        end
    end
end

local function enableGrip()
    for _, data in ipairs(cachedJoints) do
        if data.joint and data.parent and data.parent.Parent then
            pcall(function() data.joint.Parent = data.parent end)
        end
    end
    cachedJoints = {}
end

local function restoreNPCs()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            if not Players:GetPlayerFromCharacter(obj) then
                local hrp = obj.HumanoidRootPart
                hrp.Anchored = false
                hrp.CanCollide = true
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 0
            end
        end
    end
    enableGrip()
end

local function getActiveHandle()
    local char = LocalPlayer.Character
    if not char then return nil end
    if farmEquipPending then
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        if backpack and not char:FindFirstChildOfClass("Tool") then
            local tool = getGearFromParent(backpack) or backpack:FindFirstChildOfClass("Tool")
            if tool then tool.Parent = char end
        end
        if char:FindFirstChildOfClass("Tool") then farmEquipPending = false end
    end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        disableGrip(tool)
        local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
        if handle then
            handle.Anchored = false
            handle.CanCollide = false
        end
        return handle
    end
    return nil
end

-----------------------------------------------------
-- CORE AUTO FARM LOOP (HITBOX 100 & HEIGHT 0)
-----------------------------------------------------
local function startFarmLoop()
    if loopConnection then loopConnection:Disconnect() end
    farmEquipPending = true
    
    loopConnection = runService.RenderStepped:Connect(function(deltaTime)
        local char = LocalPlayer.Character
        local playerRoot = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        
        if not isFarmToggled then
            loopConnection:Disconnect()
            restoreNPCs()
            return
        end
        
        if playerRoot and humanoid then
            local toolPart = getActiveHandle()

            -- ÉP KIẾM VÀ QUÁI VỀ CÙNG ĐỘ CAO TUYỆT ĐỐI KHÔNG LỆCH
            if toolPart then
                toolPart.AssemblyLinearVelocity = Vector3.zero
                toolPart.AssemblyAngularVelocity = Vector3.new(1000, 10000, 1000)
                
                -- Tăng độ to hitbox cây kiếm lên thẳng 100 studs theo ý bạn
                toolPart.Size = Vector3.new(100, 100, 100)
                toolPart.CanCollide = false
                toolPart.Transparency = 0.8
                
                local spinCFrame = CFrame.Angles(math.rad(angle * 2), math.rad(angle * 5), math.rad(angle * 3))
                toolPart.CFrame = playerRoot.CFrame * CFrame.new(0, HEIGHT_OFFSET, -3) * spinCFrame
            end
            
            angle = (angle + 3600 * deltaTime) % 360
            
            if selectedFarmMethod == "Magnet & Spin" then
                local blackholeCFrame = playerRoot.CFrame * CFrame.new(0, HEIGHT_OFFSET, -3)
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                        if obj ~= char and obj.Humanoid.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                            local npcRoot = obj.HumanoidRootPart
                            npcRoot.Anchored = true
                            npcRoot.CanCollide = false
                            if npcRoot.Size ~= NPC_HITBOX then
                                npcRoot.Size = NPC_HITBOX
                                npcRoot.Transparency = 1
                            end
                            npcRoot.CFrame = blackholeCFrame
                            npcRoot.Velocity = Vector3.zero
                        end
                    end
                end
            elseif selectedFarmMethod == "Bring & Freeze" then
                if freezeCFrame == nil then
                    freezeCFrame = playerRoot.CFrame * CFrame.new(0, HEIGHT_OFFSET, -3)
                end
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                        if obj ~= char and obj.Humanoid.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                            local npcRoot = obj.HumanoidRootPart
                            npcRoot.Anchored = true
                            npcRoot.CanCollide = false
                            npcRoot.CFrame = freezeCFrame
                            npcRoot.Velocity = Vector3.zero
                        end
                    end
                end
            end
        end
    end)
end

