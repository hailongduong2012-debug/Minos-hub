local silentAimEnabled    = false
local silentAimDistance   = 5000
local silentAimPrediction = 0.165
local silentAimTargetMode = "Box"

local SA_TargetPart  = nil
local SA_CurrentNPC  = nil
local SA_Mouse       = LocalPlayer:GetMouse()

local function SA_IsCameraOrSystemScript()
    if not getcallingscript then return false end
    local sc = getcallingscript()
    if not sc then return false end
    local name = sc.Name:lower()
    local parent = sc.Parent
    local parentName = parent and parent.Name:lower() or ""
    if name:find("camera") or name:find("popper") or name:find("control")
       or name:find("player") or name:find("zoom") or name:find("shiftlock")
       or name:find("animate") or name:find("mouse")
       or parentName:find("camera") or parentName:find("player") or parentName:find("control") then
        return true
    end
    return false
end

local function SA_IsBaseValid(model)
    if not model or not model:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(model) or model == LocalPlayer.Character then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
    if not root then return false end
    return true
end

local function SA_IsGboxAssistant(model)
    if not model then return false end
    local nameLower = model.Name:lower():gsub("%s+", "")
    return nameLower:find("gboxassistant") ~= nil
end

local function SA_IsValidNPC(model)
    if not SA_IsBaseValid(model) then return false end
    local nameLower = model.Name:lower()
    if silentAimTargetMode == "Box" then
        return nameLower:find("box") ~= nil
           and not nameLower:find("boombox")
           and not nameLower:find("supporter")
    else
        return nameLower:find("astral") ~= nil
            or nameLower:find("void")   ~= nil
            or nameLower:find("doom")   ~= nil
    end
end

local function SA_GetTargetPart(char)
    return char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
end

local lastCheckTick = 0
local function SA_UpdateTarget()
    if tick() - lastCheckTick < 0.15 then return end
    lastCheckTick = tick()

    local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localRoot then SA_CurrentNPC = nil; SA_TargetPart = nil; return end

    if silentAimTargetMode == "Box" then
        local gboxModel, gboxPart = nil, nil
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:IsA("Model") and SA_IsBaseValid(obj) and SA_IsGboxAssistant(obj) then
                local tPart = SA_GetTargetPart(obj)
                if tPart and (tPart.Position - localRoot.Position).Magnitude <= silentAimDistance then
                    gboxModel = obj; gboxPart = tPart; break
                end
            end
        end
        if gboxPart then
            SA_CurrentNPC = gboxModel
            SA_TargetPart = gboxPart
            return
        end
    end

    if SA_CurrentNPC and SA_IsValidNPC(SA_CurrentNPC) then
        local tPart = SA_GetTargetPart(SA_CurrentNPC)
        if tPart and (tPart.Position - localRoot.Position).Magnitude <= silentAimDistance then
            SA_TargetPart = tPart
            return
        end
    end

    local closestDist = silentAimDistance
    local closestPart, closestModel = nil, nil

    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("Model") and SA_IsValidNPC(obj) then
            local tPart = SA_GetTargetPart(obj)
            if tPart then
                local tPos = tPart.Position
                if silentAimPrediction > 0 and obj:FindFirstChild("HumanoidRootPart") then
                    tPos = tPos + (obj.HumanoidRootPart.Velocity * silentAimPrediction)
                end
                local dist3D = (tPos - localRoot.Position).Magnitude
                if dist3D <= closestDist then
                    closestDist = dist3D
                    closestPart = tPart
                    closestModel = obj
                end
            end
        end
    end

    SA_CurrentNPC = closestModel
    SA_TargetPart = closestPart
end

if not IS_131_GAME then
    local SA_oldNamecall = nil
    SA_oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if checkcaller() or not silentAimEnabled or not SA_TargetPart then return SA_oldNamecall(self, ...) end
        if SA_IsCameraOrSystemScript() then return SA_oldNamecall(self, ...) end

        local method = getnamecallmethod()
        local args = {...}

        if (method == "FireServer" or method == "InvokeServer") then
            local nameLower = self.Name:lower()
            if nameLower:match("fire") or nameLower:match("hit") or nameLower:match("attack") or nameLower:match("shoot") or nameLower:match("mouse") then
                local modified = false
                for i = 1, #args do
                    if typeof(args[i]) == "Vector3" then
                        args[i] = SA_TargetPart.Position; modified = true
                    elseif typeof(args[i]) == "CFrame" then
                        args[i] = CFrame.new(args[i].Position, SA_TargetPart.Position); modified = true
                    end
                end
                if modified then return SA_oldNamecall(self, unpack(args)) end
            end
        end

        if method == "Raycast" and self == workspace then
            local origin = args[1]
            if origin then
                local newDir = (SA_TargetPart.Position - origin).Unit * args[2].Magnitude
                return SA_oldNamecall(self, origin, newDir, args[3], args[4])
            end
        end

        return SA_oldNamecall(self, ...)
    end)

    runService.Heartbeat:Connect(function()
        if silentAimEnabled then
            SA_UpdateTarget()
        else
            SA_CurrentNPC = nil
            SA_TargetPart = nil
        end
    end)
end

