-- === CƠ CHẾ BẤT TỬ TÁCH HỒN THẬT SỰ (REAL DESYNC GODMODE) ===
Toggle3.MouseButton1Click:Connect(function()
    GodModeActive = not GodModeActive
    Toggle3.Text = GodModeActive and "God Mode (Bất Tử Tách Hồn) : ON" or "God Mode (Bất Tử Tách Hồn) : OFF"
    Toggle3.TextColor3 = GodModeActive and Color3.fromRGB(80, 200, 80) or Color3.fromRGB(200, 70, 70)
    
    local Char = LocalPlayer.Character
    if Char and Char:FindFirstChild("Humanoid") then
        if GodModeActive then
            -- Tách hồn: Nhân bản một Humanoid rỗng để đánh lừa Server nhận sát thương
            local OrigHum = Char.Humanoid
            local FakeHum = OrigHum:Clone()
            FakeHum.Parent = Char
            OrigHum:Destroy() -- Xóa Humanoid gốc đã đăng ký nhận damage với Server
            LocalPlayer.Character = Char
            FakeHum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        else
            -- Khi tắt tính năng, reset nhân vật để đồng bộ lại bình thường
            if Char:FindFirstChild("Humanoid") then
                Char.Humanoid.Health = 0
            end
        end
    end
end)


