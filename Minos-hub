        local function tryDestroy()
            local target = resolvePath()
            if target then
                pcall(function() target:Destroy() end)
                pcall(function() target.Parent = nil end)
                return true
            end
            return false
        end
        for _ = 1, 20 do
            if tryDestroy() then break end
            task.wait(0.25)
        end
        task.spawn(function()
            while task.wait(1) do tryDestroy() end
        end)
