-- MINOS HUB | SBSD SURGE TURBO TOUCH AURA (MAX TICK RATE)
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "MINOS HUB | SURGE TURBO",
   LoadingTitle = "Đang ép nhịp sát thương Surge Driver...",
   LoadingSubtitle = "BY MINOS",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false 
})

local MainTab = Window:CreateTab("Surge Aura", 4483362458)

_G.SurgeTouchAura = false
_G.TurboTicks = 5 -- Số nhịp giật damage lặp lại trong 1 khung hình (Tăng tốc độ nhảy số)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Hàm giả lập chuỗi va chạm siêu tốc toàn map
local function applySurgeTurboAura()
    local character = LocalPlayer.Character
    if not character then return end
    
    -- Kiểm tra xem anh đã cầm vũ khí trên tay chưa
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end
    
    -- Tìm phần lưỡi kiếm/vũ khí gây sát thương
    local toolHandle = tool:FindFirstChild("Handle") or tool:FindFirstChild("Blade") or tool:FindFirstChildOfClass("Part")
    if not toolHandle then return end

    -- Xác định thư mục chứa quái trong trận đấu SBSD
    local enemyContainer = workspace:FindFirstChild("Enemies") or workspace

    for _, child in pairs(enemyContainer:GetChildren()) do
        if child:IsA("Model") and child ~= character then
            local humanoid = child:FindFirstChildOfClass("Humanoid")
            local enemyRoot = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("PrimaryPart")
            
            if humanoid and enemyRoot and humanoid.Health > 0 then
                -- MULTI-TICK METHOD: Bắn liên tiếp nhiều nhịp va chạm cùng lúc để sát thương nhảy liên tục không ngừng
                for i = 1, _G.TurboTicks do
                    firetouchinterest(enemyRoot, toolHandle, 0) -- Kích hoạt chạm
                    firetouchinterest(enemyRoot, toolHandle, 1) -- Ngắt chạm để sẵn sàng cho phát sau
                end
            end
        end
    end
end

-- Vòng lặp tối ưu hóa chu kỳ quét chống nghẽn CPU
task.spawn(function()
    while true do
        if _G.SurgeTouchAura then
            pcall(applySurgeTurboAura)
        end
        -- Dùng runservice hoặc đợi tối thiểu để đạt tốc độ giật điện liên tục mượt mà nhất
        task.wait() 
    end
end)

-- Tạo nút bật tắt giao diện Rayfield bản quyền MINOS
local Toggle = MainTab:CreateToggle({
   Name = "Kích hoạt Surge Turbo Aura (Giật Dmg Liên Tục)",
   CurrentValue = false,
   Flag = "MINOSSurgeTurbo",
   Callback = function(Value)
      _G.SurgeTouchAura = Value
      if Value then
          Rayfield:Notify({Title = "MINOS HUB", Content = "Đã kích hoạt tốc độ giật điện siêu tốc!", Duration = 2.5})
      else
          Rayfield:Notify({Title = "MINOS HUB", Content = "Đã tắt Surge Aura.", Duration = 2.5})
      end
   end,
})
