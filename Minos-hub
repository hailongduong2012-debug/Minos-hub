Toggle1.TextColor3 = Color3.fromRGB(200, 70, 70)
Toggle1.Font = Enum.Font.SourceSansBold
Toggle1.TextSize = 15

local T1Corner = Instance.new("UICorner", Toggle1)
T1Corner.CornerRadius = UDim.new(0, 6)

-- Nút Toggle 2: Bring Mobs
local Toggle2 = Instance.new("TextButton", Main)
Toggle2.Size = UDim2.new(0, 290, 0, 45)
Toggle2.Position = UDim2.new(0, 15, 0, 120)
Toggle2.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
Toggle2.Text = "Bring Enemies (Gom Quái) : OFF"
Toggle2.TextColor3 = Color3.fromRGB(200, 70, 70)
Toggle2.Font = Enum.Font.SourceSansBold
Toggle2.TextSize = 15

local T2Corner = Instance.new("UICorner", Toggle2)
T2Corner.CornerRadius = UDim.new(0, 6)

-- === XỬ LÝ LOGIC HOẠT ĐỘNG ===

-- 1. Xử lý nút Auto Attack
Toggle1.MouseButton1Click:Connect(function()
    AuraActive = not AuraActive
    if AuraActive then
        Toggle1.Text = "Auto Attack (Safe Aura) : ON"
        Toggle1.TextColor3 = Color3.fromRGB(80, 200, 80)
    else
        Toggle1.Text = "Auto Attack (Safe Aura) : OFF"
        Toggle1.TextColor3 = Color3.fromRGB(200, 70, 70)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.15)
        if AuraActive then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") and AttackRemote then
                    for _, enemy in pairs(workspace:GetDescendants()) do
                        if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            if not Players:GetPlayerFromCharacter(enemy) then
                                AttackRemote:FireServer(enemy)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- 2. Xử lý nút Bring Enemies
Toggle2.MouseButton1Click:Connect(function()
    BringActive = not BringActive
    if BringActive then
        Toggle2.Text = "Bring Enemies (Gom Quái) : ON"
        Toggle2.TextColor3 = Color3.fromRGB(80, 200, 80)
    else
        Toggle2.Text = "Bring Enemies (Gom Quái) : OFF"
        Toggle2.TextColor3 = Color3.fromRGB(200, 70, 70)
    end
end)

RunService.Heartbeat:Connect(function()
    if BringActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local gatherPos = hrp.Position + (hrp.CFrame.LookVector * 4)
            
            local enemiesFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Mobs") or workspace
            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") then
                    if enemy.Humanoid.Health > 0 and not Players:GetPlayerFromCharacter(enemy) then
                        enemy.HumanoidRootPart.CFrame = CFrame.new(gatherPos)
                        enemy.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
                    end
                end
            end
        end)
    end
end)
