-- [[ SBSD SECURE CAMPAIGN AUTO-ATTACK & BRING ]]
-- Cơ chế an toàn: Gom quái về trước mặt hợp lệ và tự động định vị mục tiêu

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- Cấu hình phím bấm điều khiển tiện lợi
local TOGGLE_AUTO_TARGET = Enum.KeyCode.P  -- Bấm P để Bật/Tắt tự động khóa mục tiêu mạnh nhất
local TOGGLE_BRING_ENEMY = Enum.KeyCode.B  -- Bấm B để Bật/Tắt gom quái về trước mặt để xả chiêu

local enemiesFolder = workspace:WaitForChild("Enemies", 5) or workspace:WaitForChild("Mobs", 5)
local targetActive = false
local bringActive = false

-- 1. Hàm tự động định vị và khóa mục tiêu có máu trâu nhất (Bypass Quét Lỗi)
task.spawn(function()
    while true do
        task.wait(0.2)
        if targetActive and enemiesFolder then
            pcall(function()
                local strongestEnemy = nil
                local maxHealth = 0
                
                for _, enemy in pairs(enemiesFolder:GetChildren()) do
                    if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") then
                        local hp = enemy.Humanoid.Health
                        if hp > maxHealth then
                            maxHealth = hp
                            strongestEnemy = enemy
                        end
                    end
                end
                
                -- Khóa mục tiêu để nhân vật luôn tung chiêu chuẩn xác vào con khỏe nhất
                if strongestEnemy and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = player.Character.HumanoidRootPart
                    local enemyHrp = strongestEnemy:FindFirstChild("HumanoidRootPart")
                    if enemyHrp then
                        -- Xoay hướng nhân vật về phía quái một cách tự nhiên
                        hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(enemyHrp.Position.X, hrp.Position.Y, enemyHrp.Position.Z))
                    end
                end
            end)
        end
    end
end)

-- 2. Hàm gom quái về trước mặt (Client-side) giúp dọn map Campaign cực nhanh mà không đổi sát thương gốc
RunService.Heartbeat:Connect(function()
    if bringActive and enemiesFolder and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local myHrp = player.Character.HumanoidRootPart
            -- Xác định tọa độ an toàn cách trước mặt nhân vật 3 Studs
            local targetPosition = myHrp.Position + (myHrp.CFrame.LookVector * 3) 
            
            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") then
                    if enemy.Humanoid.Health > 0 then
                        local enemyHrp = enemy.HumanoidRootPart
                        -- Kéo quái về mặt client để bạn xả combo chiêu thức trúng 100% đám quái
                        enemyHrp.CFrame = CFrame.new(targetPosition)
                        enemyHrp.Velocity = Vector3.new(0, 0, 0)
                    end
                end
            end
        end)
    end
end)

-- Nhận diện thao tác bật tắt bằng phím
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == TOGGLE_AUTO_TARGET then
        targetActive = not targetActive
        print("Tự động khóa mục tiêu mạnh nhất: " .. tostring(targetActive))
    elseif input.KeyCode == TOGGLE_BRING_ENEMY then
        bringActive = not bringActive
        print("Gom quái về trước mặt: " .. tostring(bringActive))
    end
end)
