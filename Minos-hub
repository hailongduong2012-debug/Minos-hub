local function getGearFromParent(container)
  if not container then return nil end
  local isNewGame = (game.PlaceId == 12377995562 or game.PlaceId == 15735896047)
  for _, child in ipairs(container:GetChildren()) do
      local lowerName = string.lower(child.Name)
      if isNewGame then
          if string.find(lowerName, "trollge_tui axe") or lowerName == "rainbowperiastron" then return child end
      else
          if string.find(lowerName, "whig sword")
          or lowerName == "rainbowperiastron"
          or lowerName == "dragonslayersswordandshield"
          or lowerName == "uppersword"
          or string.find(lowerName, "pe") then
              return child
          end
      end
  end
  return nil
end

