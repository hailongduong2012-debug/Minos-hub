-- 1. Xử lý Kill Aura Max Tầm Đánh (Giữ nguyên tốc độ hủy diệt quái trâu)
Toggle1.MouseButton1Click:Connect(function()
    AuraActive = not AuraActive
    if AuraActive then
        Toggle1.Text = "Kill Aura (Death Mode Speed) : ON"
        Toggle1.TextColor3 = Color3.fromRGB(80, 240, 80)
        Toggle1.BackgroundColor3 = Color3.fromRGB(20, 70, 20)
    else
        Toggle1.Text = "Kill Aura (Death Mode Speed) : OFF"
        Toggle1.TextColor3 = Color3.fromRGB(240, 80, 80)
        Toggle1.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.05)
        if AuraActive then
            pcall(function()
                local AttackRemote = ReplicatedStorage:FindFirstChild("Attack") or ReplicatedStorage:FindFirstChild("HitEnemy") or ReplicatedStorage:FindFirstChild("InflictDamage")
                if AttackRemote then
                    for _, enemy in pairs(workspace:GetDescendants()) do
                        if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            if not Players:GetPlayerFromCharacter(enemy) then
                                if AttackRemote:IsA("RemoteEvent") then
                                    AttackRemote:FireServer(enemy)
                                elseif AttackRemote:IsA("RemoteFunction") then
                                    AttackRemote:InvokeServer(enemy)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

