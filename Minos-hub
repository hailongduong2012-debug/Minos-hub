-- HÀM TẠO CÁC NÚT TÍNH NĂNG
local yPos = 45
local function addHackButton(text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 40)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.Text = text .. " [OFF]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = MainFrame

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            btn.Text = text .. " [ON]"
            btn.TextColor3 = Color3.fromRGB(0, 0, 0)
        else
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            btn.Text = text .. " [OFF]"
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        callback(active)
    end)
    yPos = yPos + 45
end

-- ========================================================
-- 1. CHỨC NĂNG ❄️ FREEZE BOSS (KHÓA CỨNG AHAT MAN / GOD DEMON)
-- ========================================================
local freezeConn = nil
addHackButton("❄️ Freeze Boss (Đóng Băng)", function(state)
    if state then
        freezeConn = runService.Heartbeat:Connect(function()
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("Humanoid") and not Players:GetPlayerFromCharacter(v.Parent) then
                    local hrp = v.Parent:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.Anchored = true
                        hrp.Velocity = Vector3.new(0, 0, 0)
                        hrp.RotVelocity = Vector3.new(0, 0, 0)
                    end
                end
            end
        end)
    else
        if freezeConn then freezeConn:Disconnect(); freezeConn = nil end
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Humanoid") and not Players:GetPlayerFromCharacter(v.Parent) then
                local hrp = v.Parent:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.Anchored = false end
            end
        end
    end
end)

