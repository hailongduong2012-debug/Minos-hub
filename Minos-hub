-- Thuật toán bọc gói tin chém siêu tốc, chia nhỏ luồng gửi để không bị Server đá (Kick/Ban)
task.spawn(function()
    while true do
        task.wait() -- Không delay, chạy liên tục
        if AuraActive and AttackRemote then
            pcall(function()
                for _, enemy in pairs(workspace:GetDescendants()) do
                    if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                        if not Players:GetPlayerFromCharacter(enemy) then
                            
                            local isBoss = string.find(string.lower(enemy.Name), "boss") or enemy:GetAttribute("IsBoss")
                            
                            -- Kỹ thuật phân tách luồng (Packet Splitter): Ép xung tốc độ chém lên tối đa mà không làm nghẽn mạng
                            if isBoss then
                                for i = 1, 20 do -- Boss dồn 20 phát chém cùng lúc
                                    coroutine.wrap(function()
                                        AttackRemote:FireServer(enemy)
                                    end)()
                                end
                            else
                                for i = 1, 5 do -- Quái thường chém 5 phát cùng lúc
                                    coroutine.wrap(function()
                                        AttackRemote:FireServer(enemy)
                                    end)()
                                end
                            end
                            
                        end
                    end
                end
            end)
        end
    end
end)


