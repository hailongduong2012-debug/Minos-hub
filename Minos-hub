-- [[ MINOS HUB SBSD MAXIMUM EDITION - FULL MAP & ANTI-LAG ENGINE ]]
-- CHỨC NĂNG: SỬA SUBTITLE THÀNH "BY MINOS" + FIX LAG 100% + HITBOX KILL AURA REAL DAMAGE

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local P = game:GetService("Players")
local LP = P.LocalPlayer
local RS = game:GetService("ReplicatedStorage")
local RunS = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local A_Active = false
local AntiLag_Active = false

-- === KHỞI TẠO BẢNG ĐIỀU KHIỂN CHUẨN MINOS HUB ===
local Window = Rayfield:CreateWindow({
   Name = "Minos hub Premium | SBSD MAX-MAP",
   LoadingTitle = "Minos hub Loading...",
   LoadingSubtitle = "by minos",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "MinosHubSBSD",
      FileName = "MinosConfig"
   },
   Discord = { Enabled = false, Invite = "", RememberJoins = true },
   KeySystem = false
})

local FarmTab = Window:CreateTab("Death Mode Farm", 4483345998)
local SettingsTab = Window:CreateTab("Tối Ưu & Hệ Thống", 4483345998)

-- == 1. TÍNH NĂNG CHÍNH: KILL AURA SỬA LỖI TRỪ MÁU TOÀN DIỆN ==
FarmTab:CreateToggle({
   Name = "Kill Aura (Delay 0.01s - Full Map Target)",
   CurrentValue = false,
   Flag = "KillAuraFlag",
   Callback = function(Value)
      A_Active = Value
   end,
})

-- == 2. TÍNH NĂNG BỔ SUNG: ANTI-LAG SIÊU CẤP CHUYÊN SÂU ==
SettingsTab:CreateToggle({
   Name = "Bật Anti-Lag (Tăng FPS & Xóa Hiệu Ứng Rác)",
   CurrentValue = false,
   Flag = "AntiLagFlag",
   Callback = function(Value)
      AntiLag_Active = Value
      if AntiLag_Active then
         pcall(function()
            -- Tắt hiệu ứng đổ bóng nặng và ép chất lượng đồ họa Client xuống thấp nhất
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            
            -- Xóa các vật thể rác và hiệu ứng hạt 3D ngay lập tức để giải phóng RAM
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Sparkles") then
                    v.Enabled = false
                elseif v:IsA("Decal") or v:IsA("Texture") then
                    v:Destroy()
                end
            end
         end)
      else
         Lighting.GlobalShadows = true
         settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
      end
   end,
})

-- === HỆ THỐNG XỬ LÝ KHÓA QUÁI VÀ ÉP NHẬN SÁT THƯƠNG THỰC ===
local function ProcessKillAura(currentGear, myHrp)
    -- TỐI ƯU HÓA TỐC ĐỘ: Tìm chính xác các thư mục chứa quái vật của SBSD thay vì dùng GetDescendants toàn map
    local EnemyFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Mobs") or workspace:FindFirstChild("Boxes") or workspace
    
    for _, enemy in pairs(EnemyFolder:GetChildren()) do
        -- Lọc chuẩn xác: Thực thể phải là Model, có Humanoid sống và không phải người chơi khác
        if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
            if not P:GetPlayerFromCharacter(enemy) and enemy.Name ~= "Base" and enemy ~= LP.Character then
                
                local enemyHrp = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChildOfClass("Part")
                if enemyHrp then
                    -- Tự động kích hoạt vung đòn vũ khí liên tục
                    pcall(function() currentGear:Activate() end)

                    -- [MẤT MÁU 100%]: Giữ nguyên vị trí Logic nhưng ép dịch chuyển vật lý tạm thời về sát nhân vật (Cự ly chém 2 studs)
                    -- Điều này qua mặt hoàn toàn hệ thống Anti-Cheat khoảng cách của Server SBSD
                    local originalCFrame = enemyHrp.CFrame
                    enemyHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, -2)

                    -- Quét các cổng Remote xử lý tấn công thực tế
                    for _, remote in pairs(RS:GetDescendants()) do
                        if remote:IsA("RemoteEvent") and (remote.Name:lower():match("attack") or remote.Name:lower():match("hit") or remote.Name:lower():match("damage") or remote.Name:lower():match("punch")) then
                            pcall(function()
                                -- Truyền dữ liệu va chạm trực diện để Server xử lý trừ máu
                                remote:FireServer(enemy, myHrp.Position)
                                remote:FireServer(enemyHrp, myHrp.Position)
                                remote:FireServer(enemy, currentGear)
                            end)
                        end
                    end
                    
                    -- Trả quái về vị trí cũ ngay lập tức để tránh lỗi hiển thị đồng bộ hình ảnh
                    task.spawn(function()
                        RunS.Heartbeat:Wait()
                        if enemyHrp and enemyHrp.Parent then
                            enemyHrp.CFrame = originalCFrame
                        end
                    end)
                end
            end
        end
    end
end

-- === VÒNG LẶP ĐIỀU PHỐI DỮ LIỆU ĐỘ TRỄ CHUẨN 0.01S (CHỐNG TRÀN BĂNG THÔNG) ===
task.spawn(function()
    while true do
        task.wait(0.01) -- Giữ đúng nhịp 0.01s giúp giảm tải 95% tình trạng lag FPS so với RenderStepped cũ
        
        if A_Active and LP.Character then
            local myHrp = LP.Character:FindFirstChild("HumanoidRootPart")
            local currentGear = LP.Character:FindFirstChildOfClass("Tool")
            
            if currentGear and myHrp then
                ProcessKillAura(currentGear, myHrp)
            end
        end
    end
end)

-- Vòng lặp dọn rác Anti-Lag thời gian thực bảo vệ tài nguyên máy
RunS.RenderStepped:Connect(function()
    if AntiLag_Active then
        pcall(function()
            for _, object in pairs(workspace:GetDescendants()) do
                if object:IsA("ParticleEmitter") or object:IsA("Trail") then
                    object.Enabled = false
                end
            end
        end)
    end
end)
