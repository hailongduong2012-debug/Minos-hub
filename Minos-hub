getgenv().SecureMode = true
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "sbsd_mogged Hub | Winner Setup",
   LoadingTitle = "Loading System...",
   LoadingSubtitle = "by Assistant",
   Theme = "Default",
   DisableRayfieldPrompts = true,
   ConfigurationSaving = { Enabled = false }
})

local MainTab = Window:CreateTab("SBSD Campaign", 4483345998)

local AuraActive = false
local GodModeActive = false

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Fix nút thu nhỏ thành chữ SBSD màu xanh lá kéo thả được
task.spawn(function()
    task.wait(1.2)
    pcall(function()
        local RayfieldGui = game:GetService("CoreGui"):FindFirstChild("Rayfield") or LocalPlayer.PlayerGui:FindFirstChild("Rayfield")
        if RayfieldGui and RayfieldGui:FindFirstChild("OpenButton") then
            local openBtn = RayfieldGui.OpenButton:FindFirstChildOfClass("ImageButton") or RayfieldGui.OpenButton
            if openBtn then
                openBtn.Image = ""
                openBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
                openBtn.Size = UDim2.new(0, 75, 0, 35)
                
                local txt = Instance.new("TextLabel", openBtn)
                txt.Size = UDim2.new(1, 0, 1, 0)
                txt.BackgroundTransparency = 1
                txt.Text = "SBSD"
                txt.TextColor3 = Color3.fromRGB(0, 255, 0)
                txt.Font = Enum.Font.SourceSansBold
                txt.TextSize = 18
                
                Instance.new("UICorner", openBtn).CornerRadius = UDim.new(0, 6)
                local stroke = Instance.new("UIStroke", openBtn)
                stroke.Color = Color3.fromRGB(0, 255, 0)
                stroke.Thickness = 1.5
            end
        end
    end)
end)

-- =======================================================
-- BẢN FIX: BỘ GỐC KILL AURA TOÀN MAP SIÊU MƯỢT LÚC SÁNG
-- =======================================================
RunService.Stepped:Connect(function()
    if AuraActive then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    -- Quét thẳng cổng đòn đánh từ xa của Gear và hệ thống
                    local weaponRemote = tool:FindFirstChild("Remote") or tool:FindFirstChild("Action") or tool:FindFirstChild("Attack") or tool:FindFirstChild("Hit")
                    local globalRemote = ReplicatedStorage:FindFirstChild("Attack") or ReplicatedStorage:FindFirstChild("HitEnemy") or ReplicatedStorage:FindFirstChild("InflictDamage") or ReplicatedStorage:FindFirstChild("Hit")

                    -- Chạy vòng lặp quét nhịp tim hệ thống cực nhanh, quái vừa spawn ra dính đam chết ngay
                    for _, enemy in pairs(workspace:GetDescendants()) do
                        if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            if not Players:GetPlayerFromCharacter(enemy) and enemy.Name ~= "Base" then
                                local enemyHrp = enemy:FindFirstChild("HumanoidRootPart")
                                if enemyHrp then
                                    
                                    -- Ép nổ sát thương từ xa bằng gói tin gốc, KHÔNG DÙNG lệnh vung đòn gây lướt nhân vật
                                    if weaponRemote and weaponRemote:IsA("RemoteEvent") then
                                        weaponRemote:FireServer(enemy, enemyHrp.Position)
                                    end
                                    
                                    if globalRemote and globalRemote:IsA("RemoteEvent") then
                                        globalRemote:FireServer(enemy, tool)
                                    end
                                    
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end)

-- Safe Zone God Mode bất tử khóa máu nhịp tim
RunService.Heartbeat:Connect(function()
    if GodModeActive then
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.Health = hum.MaxHealth
                    if hum.Health <= 0 then
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                        hum.Health = hum.MaxHealth
                    end
                end
                if not char:FindFirstChildOfClass("ForceField") then
                    Instance.new("ForceField", char)
                end
            end
        end)
    end
end)

-- Nút gạt Toggle trên Rayfield UI
MainTab:CreateToggle({
   Name = "Global Gear Attack (Toàn Bản Đồ)",
   CurrentValue = false,
   Flag = "GlobalGearAttackFlag",
   Callback = function(Value) AuraActive = Value end,
})

MainTab:CreateToggle({
   Name = "Safe Zone God Mode (Bất Tử)",
   CurrentValue = false,
   Flag = "SafeZoneGodModeFlag",
   Callback = function(Value) GodModeActive = Value end,
})

-- Đổi nhãn chữ thành màu xanh lá cây [sbsd] cổ điển
pcall(function()
    task.wait(1.5)
    local RayfieldGui = game:GetService("CoreGui"):FindFirstChild("Rayfield") or LocalPlayer.PlayerGui:FindFirstChild("Rayfield")
    if RayfieldGui and RayfieldGui:FindFirstChild("Main") then
