    humanoid:EquipTool(tool)
    return true
  end
  return false
end

local function autoGearStep()
  local playerGui = getPlayerGui()
  if not playerGui then return end
  local gears = playerGui:FindFirstChild("gears")
  if hasGear() then
    -- Đã có gear: tắt GUI "gears" (giống f36 của script Quorum) rồi cầm gear lên
    gearMiss = 0
    gearHandled = true
    if gears and gears.Enabled then gears.Enabled = false end
    if gearAutoEquipPending and equipGear() then gearAutoEquipPending = false end
    return
