-- [1] TỐI ƯU HÓA ĐỒ HỌA GỐC (GIẢM LAG CỰC MẠNH)
-- Chỉ tắt các hiệu ứng ánh sáng gây tràn RAM, không xóa Texture để giữ nguyên giao diện game
pcall(function()
    local Lighting = game:GetService("Lighting")
    local Effects = {"BloomEffect", "BlurEffect", "ColorCorrectionEffect", "SunRaysEffect"}
    for _, effect in pairs(Lighting:GetDescendants()) do
        for _, name in pairs(Effects) do
            if effect:IsA(name) then
                effect.Enabled = false
            end
        end
    end
end)

-- [2] BỘ LỌC AN TOÀN KHI ĐỔI NHÂN VẬT (ANTI-CRASH & FREEZE)
-- Ngăn hiện tượng đơ camera hoặc mất kết nối nhân vật khi script gốc thực hiện Auto Character
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

LocalPlayer.CharacterChanging:Connect(function()
    pcall(function()
        if workspace.CurrentCamera then
            workspace.CurrentCamera.CameraSubject = nil
        end
    end)
end)

LocalPlayer.CharacterAdded:Connect(function(Character)
    pcall(function()
        local Humanoid = Character:WaitForChild("Humanoid", 10)
        if Humanoid then
            task.wait(0.2) -- Tạo khoảng trễ siêu nhỏ để bộ nhớ thiết bị kịp xử lý nhân vật mới
            if workspace.CurrentCamera then
                workspace.CurrentCamera.CameraSubject = Humanoid
            end
        end
    end)
end)

-- [3] HOOK FIRESERVER - GIỚI HẠN TỐC ĐỘ GỬI LỆNH (CHỨC NĂNG VẪN CHẠY NHƯNG AN TOÀN HƠN)
-- Khi script gốc gọi lệnh chọn nhân vật, hàm này sẽ đảm bảo các lệnh không bị đè lên nhau gây văng game
local OldFireServer
OldFireServer = hookmetamethod(game, "__index", function(Self, Key)
    if not checkcaller() and Key == "FireServer" and Self.ClassName == "RemoteEvent" then
        local EventName = string.lower(Self.Name)
        if string.find(EventName, "character") or string.find(EventName, "spawn") or string.find(EventName, "select") then
            if _G.LastSpawnTime and tick() - _G.LastSpawnTime < 1.0 then
                return nil -- Chặn lệnh spam quá nhanh trong < 1 giây, đợi lượt sau để không bị văng
            end
            _G.LastSpawnTime = tick()
        end
    end
    return OldFireServer(Self, Key)
end)

