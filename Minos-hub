-- Hàm tự tạo nút bấm Doom an toàn
local function CreateDoomButton(text, posY)
    local btn = Instance.new("TextButton")
    btn.Parent = Main
    btn.Size = UDim2.new(0, 290, 0, 40)
    btn.Position = UDim2.new(0, 15, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    btn.BackgroundTransparency = 0.2
    btn.Text = text .. " : OFF"
    btn.TextColor3 = Color3.fromRGB(220, 80, 80)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.ZIndex = 2
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    return btn
end

local Toggle1 = CreateDoomButton("Kill Aura (Vô Hạn Tầm Đánh)", 55)
local Toggle2 = CreateDoomButton("Bring Enemies (Gom Quái)", 110)
local Toggle3 = CreateDoomButton("Auto Spawn Telescope (5 Coins)", 165)


-- === HỆ THỐNG PHÒNG THỦ CHỐNG LỖI LOGIC GAME ===
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Nút 1: Điều khiển Vô hạn tầm đánh
Toggle1.MouseButton1Click:Connect(function()
    AuraActive = not AuraActive
    if AuraActive then
        Toggle1.Text = "Kill Aura (Vô Hạn Tầm Đánh) : ON"
        Toggle1.TextColor3 = Color3.fromRGB(80, 220, 80)
        Toggle1.BackgroundColor3 = Color3.fromRGB(20, 60, 20)
    else
        Toggle1.Text = "Kill Aura (Vô Hạn Tầm Đánh) : OFF"
        Toggle1.TextColor3 = Color3.fromRGB(220, 80, 80)
        Toggle1.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.12)
        if AuraActive then
            pcall(function()
                -- Quét tìm Remote động ngay trong lúc chạy để tránh bị kẹt file
                local AttackRemote = ReplicatedStorage:FindFirstChild("Attack") or ReplicatedStorage:FindFirstChild("HitEnemy") or ReplicatedStorage:FindFirstChild("InflictDamage")
                if AttackRemote then
                    for _, enemy in pairs(workspace:GetDescendants()) do
                        if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            if not Players:GetPlayerFromCharacter(enemy) then
                                if AttackRemote:IsA("RemoteEvent") then
                                    AttackRemote:FireServer(enemy)
                                elseif AttackRemote:IsA("RemoteFunction") then
                                    AttackRemote:InvokeServer(enemy)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- Nút 2: Gom hút quái Campaign
Toggle2.MouseButton1Click:Connect(function()
    BringActive = not BringActive
    if BringActive then
        Toggle2.Text = "Bring Enemies (Gom Quái) : ON"
        Toggle2.TextColor3 = Color3.fromRGB(80, 220, 80)
        Toggle2.BackgroundColor3 = Color3.fromRGB(20, 60, 20)
    else
        Toggle2.Text = "Bring Enemies (Gom Quái) : OFF"
        Toggle2.TextColor3 = Color3.fromRGB(220, 80, 80)
        Toggle2.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    end
end)

RunService.Heartbeat:Connect(function()
    if BringActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local gatherPos = hrp.Position + (hrp.CFrame.LookVector * 4)
            
            local enemiesFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Mobs") or workspace
            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") then
                    if enemy.Humanoid.Health > 0 and not Players:GetPlayerFromCharacter(enemy) then
                        enemy.HumanoidRootPart.CFrame = CFrame.new(gatherPos)
                        enemy.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
                    end
                end
            end
        end)
    end
end)

-- Nút 3: Tự động Spawn lính khi đủ tiền
Toggle3.MouseButton1Click:Connect(function()
    AutoTeleActive = not AutoTeleActive
    if AutoTeleActive then
        Toggle3.Text = "Auto Spawn Telescope (5 Coins) : ON"
        Toggle3.TextColor3 = Color3.fromRGB(80, 220, 80)
        Toggle3.BackgroundColor3 = Color3.fromRGB(20, 60, 20)
    else
        Toggle3.Text = "Auto Spawn Telescope (5 Coins) : OFF"
        Toggle3.TextColor3 = Color3.fromRGB(220, 80, 80)
        Toggle3.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.3)
        if AutoTeleActive then
            pcall(function()
                local SummonRemote = ReplicatedStorage:FindFirstChild("HEUGHSUMMONS") or ReplicatedStorage:FindFirstChild("SummonUnit") or ReplicatedStorage:FindFirstChild("Summon")
                local stats = LocalPlayer:FindFirstChild("leaderstats")
                local cash = stats and (stats:FindFirstChild("Cash") or stats:FindFirstChild("Coins") or stats:FindFirstChild("Points"))
                
                if cash and cash.Value >= 5 and SummonRemote then
                    if SummonRemote:IsA("RemoteEvent") then
                        SummonRemote:FireServer("Heli")
                    elseif SummonRemote:IsA("RemoteFunction") then
                        SummonRemote:InvokeServer("Heli")
                    end
                end
            end)
        end
    end
end)
