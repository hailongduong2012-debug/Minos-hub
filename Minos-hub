-- HÀM BYPASS HỆ THỐNG PHÒNG THỦ ĐỒ HỌA: Tự động chọn nơi an toàn để hiện bảng
local function GetSafeGUIParent()
    local CoreGui = game:GetService("CoreGui")
    local success, _ = pcall(function()
        local test = Instance.new("ScreenGui")
        test.Parent = CoreGui
        test:Destroy()
    end)
    if success then
        return CoreGui
    else
        -- Nếu CoreGui bị chặn, ép UI nhét thẳng vào PlayerGui của người chơi để hiện lên 100%
        return LocalPlayer:WaitForChild("PlayerGui")
    end
end

