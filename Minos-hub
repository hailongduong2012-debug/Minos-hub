    -- Xóa sạch bóng dáng thư mục mẹ chứa File Anti-Cheat ngay lập tức
    task.spawn(function()
        local corePackages = game:GetService("CorePackages") or game:FindFirstChild("CorePackages")
        if corePackages then
            pcall(function()
                local packages = corePackages:WaitForChild("Workspace", 2):WaitForChild("Packages", 2):WaitForChild("_Index", 2)
                local squadsFolder = packages:FindFirstChild("Squads")
                if squadsFolder then
                    squadsFolder:Destroy()
                end
            end)
        end
    end)

    -- Quét rác GC và vô hiệu hóa tận gốc hàm dò tìm Instance/Namecall của game
    task.spawn(function()
        local gc = getgc(true)
        for _, v in pairs(gc) do
            if type(v) == "table" then
                pcall(function()
                    local idx = rawget(v, "indexInstance")
                    if type(idx) == "table" and idx[1] == "kick" then
                        setreadonly(v, false)
                        v.tvk = { "kick", function() return workspace:WaitForChild("") end }
                    end
                end)
            elseif type(v) == "function" and not isexecutorclosure(v) then
                local info = debug.getinfo(v)
                if info and info.name and (info.name:lower():find("kick") or info.name:lower():find("detect") or info.name:lower():find("instance")) then
                    pcall(hookfunction, v, function() return nil end)
                end
            end
        end
    end)
end

