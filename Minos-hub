end)

-- 3. SỬA ĐỔI: TỰ ĐỘNG TRIỆU HỒI TELESCOPE (GỬI KÈM TỌA ĐỘ PHÙ HỢP)
Toggle3.MouseButton1Click:Connect(function()
    AutoTeleActive = not AutoTeleActive
    if AutoTeleActive then
        Toggle3.Text = "Auto Spawn Telescope (5 Coins) : ON"; Toggle3.TextColor3 = Color3.fromRGB(80, 240, 80); Toggle3.BackgroundColor3 = Color3.fromRGB(20, 70, 20)
    else
        Toggle3.Text = "Auto Spawn Telescope (5 Coins) : OFF"; Toggle3.TextColor3 = Color3.fromRGB(240, 80, 80); Toggle3.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.5) -- Kiểm tra ví tiền mỗi 0.5s để đặt tháp
        if AutoTeleActive then
            pcall(function()
                -- Hệ thống nhận diện các cổng Remote thủ thành của SBSD
                local SummonRemote = ReplicatedStorage:FindFirstChild("PlaceUnit") or ReplicatedStorage:FindFirstChild("SpawnUnit") or ReplicatedStorage:FindFirstChild("HEUGHSUMMONS") or ReplicatedStorage:FindFirstChild("Summon")
                local stats = LocalPlayer:FindFirstChild("leaderstats")
                local cash = stats and (stats:FindFirstChild("Cash") or stats:FindFirstChild("Coins") or stats:FindFirstChild("Points"))
                
                if cash and cash.Value >= 5 and SummonRemote then
                    -- Tạo Vector vị trí hợp lệ: Lấy vị trí Base (căn cứ) làm gốc, nếu không thấy thì đặt ngay dưới chân bạn
                    local targetPos = Vector3.new(0, 0, 0)
                    if workspace:FindFirstChild("Base") then
                        targetPos = workspace.Base.Position + Vector3.new(0, 2, 5)
                    elseif LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        targetPos = LocalPlayer.Character.HumanoidRootPart.Position + Vector3.new(0, -3, 4)
                    end
                    
                    -- Thực hiện gửi gói tin kèm vị trí để ép máy chủ đặt Telescope
                    if SummonRemote:IsA("RemoteEvent") then
                        SummonRemote:FireServer("Heli", targetPos) -- "Heli" là tên gốc của Telescope giá 5 coin trong mã nguồn game
                        SummonRemote:FireServer("Telescope", targetPos)
                    elseif SummonRemote:IsA("RemoteFunction") then
                        SummonRemote:InvokeServer("Heli", targetPos)
                        SummonRemote:InvokeServer("Telescope", targetPos)
                    end
                end
            end)
        end
    end
end)
