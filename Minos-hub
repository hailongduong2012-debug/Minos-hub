    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()

        if self == nil or typeof(self) ~= "Instance" then
            return coroutine.yield()
        end

        if not checkcaller() and method == "FindFirstChild" and tostring(self) == "Humanoid" then
            return nil
        end

        return oldNamecall(self, ...)
    end)
