RunService.Heartbeat:Connect(function()
    if BringActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local hrp = LocalPlayer.Character.HumanoidRootPart
            -- Nếu đang bật God Mode bay lên trời, quái sẽ được kéo lên lơ lửng ngay trước mặt bạn để chém cho dễ
            local gatherPos = hrp.Position + (hrp.CFrame.LookVector * 5)
            
            local enemiesFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Mobs") or workspace
            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") then
                    if enemy.Humanoid.Health > 0 and not Players:GetPlayerFromCharacter(enemy) then
                        enemy.HumanoidRootPart.CFrame = CFrame.new(gatherPos)
                        enemy.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
                    end
                end
            end
        end)
    end
end)
