-- 2. TÍNH NĂNG 🛡️ AUTO PARRY (Từ bản Sbsd gốc của bạn)
-- ========================================================
local isParryToggled = false

createToggle("🛡️ Auto Parry (Đỡ Đòn)", "Tự động kích hoạt đỡ đòn", function(Value)
    isParryToggled = Value
end)

local function equipTool(toolName)
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if character and character:FindFirstChildOfClass("Humanoid") then
        local tool = (backpack and backpack:FindFirstChild(toolName)) or (character and character:FindFirstChild(toolName))
        if tool and tool.Parent ~= character then
            character.Humanoid:EquipTool(tool)
            return tool
        end
        return character:FindFirstChild(toolName)
    end
    return nil
end

local function executeParry()
    equipTool("Ivory Periastron")
    task.wait(0.01)
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("Ivory Periastron") then
        local r = character["Ivory Periastron"]:FindFirstChild("Remote")
        if r then r:FireServer(Enum.KeyCode.E) end
    end
    task.wait(0.01)
    local azure = equipTool("Azure Periastron")
    if azure and azure:FindFirstChild("Remote") then azure.Remote:FireServer(Enum.KeyCode.E) end
end

local function handleDetection(descendant)
    if not isParryToggled then return end
    local character = LocalPlayer.Character
    if not character then return end
    local id = ""
    if descendant:IsA("ParticleEmitter") then
        id = string.match(descendant.Texture, "%d+") or ""
    elseif descendant:IsA("MeshPart") or descendant:IsA("SpecialMesh") then
        id = string.match(descendant.MeshId, "%d+") or ""
    end
    if id == "214269134" then
        local parent = descendant.Parent
        if parent and parent.Name == "IFrame" and parent.Parent and parent.Parent.Parent == character then
            task.spawn(executeParry)
        end
    end
end

if LocalPlayer.Character then LocalPlayer.Character.DescendantAdded:Connect(handleDetection) end
LocalPlayer.CharacterAdded:Connect(function(char) char.DescendantAdded:Connect(handleDetection) end)

