local unffScreenGui = nil

local function toggleUnffGui(state)
    if state then
        if unffScreenGui then unffScreenGui:Destroy() end
        
        unffScreenGui = Instance.new("ScreenGui")
        unffScreenGui.Name = "UnffGui"
        if gethui then
            unffScreenGui.Parent = gethui()
        else
            local success = pcall(function() unffScreenGui.Parent = game:GetService("CoreGui") end)
            if not success then unffScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
        end
        unffScreenGui.ResetOnSpawn = false

        local btn = Instance.new("TextButton")
        btn.Parent = unffScreenGui
        btn.Size = UDim2.new(0, 50, 0, 50)
        btn.Position = UDim2.new(0.5, -25, 0.2, 0)
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        btn.BorderColor3 = Color3.fromRGB(0, 255, 255)
        btn.Text = "UNFF"
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 14
        btn.Font = Enum.Font.GothamBold

        -- Xử lý kéo thả GUI
        local dragging, dragInput, dragStart, startPos
        
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = btn.Position
                
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)

        -- Kích hoạt remote khi click
        btn.MouseButton1Click:Connect(function()
            pcall(function()
                local Event = ReplicatedStorage:FindFirstChild("HDAdminClient")
                if Event then
                    Event = Event:FindFirstChild("Signals")
                    if Event then
                        Event = Event:FindFirstChild("RequestCommand")
                        if Event then
                            Event:InvokeServer(";unff")
                        end
                    end
                end
            end)
        end)
    else
        if unffScreenGui then
            unffScreenGui:Destroy()
            unffScreenGui = nil
        end
    end
end

