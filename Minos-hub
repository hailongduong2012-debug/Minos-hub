-- 3. Biến trạng thái hệ thống
local States = {
    SelectCharacter = false,
    GearAndRainbow = false,
    AutoEquipLock = false,
    AutoFarmBoss = false,
    BossDamageInput = 1000000, 
    AttackDelay = 1,
    IsProcessingGear = false -- Bộ lọc luồng ưu tiên tránh xung đột
}

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Hàm quét và tìm kiếm mục tiêu (Box/Boss) diện rộng toàn bộ Workspace
local function GetTargetInstance()
    local c = workspace:GetChildren()
    -- Cách 1: Quét các thực thể chứa từ khóa đặc biệt ở Workspace
    for i = 1, #c do
        local v = c[i]
        if v:IsA("Model") or v:IsA("BasePart") then
            local nameLower = string.lower(v.Name)
            if string.find(nameLower, "box") or string.find(nameLower, "boss") or string.find(nameLower, "chest") then
                return v
            end
        end
    end
    -- Cách 2: Tìm sâu trong các folder quái vật thường gặp
    local folders = {"Enemies", "Mobs", "Monsters", "Npcs"}
    for _, fName in ipairs(folders) do
        local f = workspace:FindFirstChild(fName)
        if f then
            for _, v in ipairs(f:GetChildren()) do
                if string.find(string.lower(v.Name), "box") or string.find(string.lower(v.Name), "boss") then
                    return v
                end
            end
        end
    end
    return workspace:FindFirstChild("Box") or workspace:FindFirstChild("Boss")
end

