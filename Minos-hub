-- Hệ thống Anti-Ban (Bypass Metatable Log)
local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", function(Self, ...)
    local Args = {...}
    local NamecallMethod = getnamecallmethod()
    
    if not checkcaller() and (NamecallMethod == "FireServer" or NamecallMethod == "InvokeServer") then
        if tostring(Self) == "Report" or tostring(Self) == "Ban" or tostring(Self) == "Log" or tostring(Self):find("Cheat") or tostring(Self) == "Detector" then
            return nil
        end
    end
    return OldNamecall(Self, unpack(Args))
end)

-- Hàm quét mục tiêu an toàn của MINOS HUB
local function getSBSDTargets()
    -- KIỂM TRA SẢNH: Nếu game chưa vào trận hoặc không có thực thể quái, dừng quét ngay để tránh Detector
    local monsterSpawned = false
    local validTargets = {}
    
    for _, child in pairs(workspace:GetChildren()) do
        if child:IsA("Model") and child ~= LocalPlayer.Character then
            local humanoid = child:FindFirstChildOfClass("Humanoid")
            local mainPart = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("PrimaryPart") or child:FindFirstChild("Box")
            
            if humanoid and mainPart and humanoid.Health > 0 then
                monsterSpawned = true
                table.insert(validTargets, mainPart)
            end
        end
    end
    
    if not monsterSpawned then return nil end -- Trả về rỗng nếu đang ở sảnh
    return validTargets
end

-- Vòng lặp sát thương cực hạn tích hợp Safe Lobby Guard
