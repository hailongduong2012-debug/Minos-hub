local AutoFarmCampaign = false
local Player = game:GetService("Players").LocalPlayer

-- HÀM TỰ ĐỘNG CẦM KIẾM/VŨ KHÍ (Bắt buộc phải có vũ khí trên tay sát thương mới nhảy)
local function EquipWeapon()
    local backpack = Player:FindFirstChild("Backpack")
    local character = Player.Character
    if character and backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                character.Humanoid:EquipTool(tool)
                break
            end
        end
    end
end

-- HÀM CORE NÂNG CẤP: TELEPORT KILL + FAST ATTACK MULTIPLIER
task.spawn(function()
    while true do
        task.wait(0.01) -- Quét mục tiêu liên tục
        if AutoFarmCampaign and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
            local enemiesFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Zombies") or workspace
            local hitRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Hit") or game:GetService("ReplicatedStorage"):FindFirstChild("Damage")
            
            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") then
                    local humanoid = enemy:FindFirstChildOfClass("Humanoid")
                    
                    -- Bám sát mục tiêu cho tới khi quái chết hẳn
                    while AutoFarmCampaign and humanoid and humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") do
                        task.wait()
                        EquipWeapon() -- Đảm bảo luôn cầm vũ khí khi chém
                        
                        -- Dịch chuyển áp sát phía sau quái tránh bị phản đòn
                        Player.Character.HumanoidRootPart.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
                        
                        -- VÒNG LẶP FAST ATTACK: Ép gửi 15 lệnh chém cùng 1 lúc để nhân sát thương đầu ra
                        if hitRemote then
                            for i = 1, 15 do 
                                hitRemote:FireServer(enemy.HumanoidRootPart, enemy.HumanoidRootPart.Position)
                            end
                        end
                    end
                end
            end
        end
    end
end)

