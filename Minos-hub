local AutoFastAttack = false
local Player = game:GetService("Players").LocalPlayer

-- HÀM CẦM VŨ KHÍ TỰ ĐỘNG (Giữ vũ khí ổn định không bị bật/tắt liên tục)
local function EquipWeapon()
    local backpack = Player:FindFirstChild("Backpack")
    local character = Player.Character
    if character and backpack then
        if not character:FindFirstChildOfClass("Tool") then
            for _, tool in pairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    character.Humanoid:EquipTool(tool)
                    break
                end
            end
        end
    end
end

-- VÒNG LẶP CHÍNH: XẢ BỒN CẦU LẬP TỨC - TELEPORT SIÊU TỐC KHÔNG DELAY
task.spawn(function()
    while true do
        task.wait(0.01) -- Chu kỳ quét siêu nhỏ mô phỏng tốc độ Teleport đỉnh cao
        if AutoFastAttack and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
            local myRoot = Player.Character.HumanoidRootPart
            local enemiesFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Zombies") or workspace
            local hitRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Hit") or game:GetService("ReplicatedStorage"):FindFirstChild("Damage")
            local interactRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Interact") or game:GetService("ReplicatedStorage"):FindFirstChild("CloseBox")
            
            -- Biến lưu vị trí quái gần nhất
            local targetEnemy = nil
            local shortestDistance = math.huge
            
            -- Thuật toán tìm quái nhanh nhất (Tìm mục tiêu tối ưu để Teleport ngay lập tức)
            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") then
                    local humanoid = enemy:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        local distance = (myRoot.Position - enemy.HumanoidRootPart.Position).Magnitude
                        if distance < shortestDistance then
                            shortestDistance = distance
                            targetEnemy = enemy
                        end
                    end
                end
            end
            
            -- Nếu phát hiện thấy mục tiêu còn sống
            if targetEnemy then
                local enemyRoot = targetEnemy.HumanoidRootPart
                local humanoid = targetEnemy:FindFirstChildOfClass("Humanoid")
                
                -- Phân loại: Boss hay Quái nhỏ
                local isBoss = false
                if string.find(string.lower(targetEnemy.Name), "boss") or string.find(string.lower(targetEnemy.Name), "titan") or (humanoid and humanoid.MaxHealth >= 1000) then
                    isBoss = true
                end
                
                -- Thực hiện chu kỳ bám đuổi hạ gục
                while AutoFastAttack and humanoid and humanoid.Health > 0 and enemyRoot:IsDescendantOf(workspace) do
                    
                    -- 1. XỬ LÝ QUÁI THƯỜNG (QUÁI NHỎ): Dịch chuyển tức thời & Auto Close đóng hộp xả bồn cầu liên tục
                    if not isBoss then
                        -- Dịch chuyển trực diện cực nhanh
                        myRoot.CFrame = enemyRoot.CFrame * CFrame.new(0, 0, 1.5)
                        
                        -- Vòng lặp spam lệnh tương tác/đóng hộp (Auto Close tốc độ cao)
                        if interactRemote then
                            for i = 1, 10 do
                                interactRemote:FireServer(targetEnemy)
                            end
                        end
                        
                        -- Hỗ trợ thêm sát thương cận chiến để clear nhanh nhất có thể
                        if hitRemote then
                            hitRemote:FireServer(enemyRoot, enemyRoot.Position)
                        end
                    
                    -- 2. XỬ LÝ BOSS / QUÁI LỚN: Teleport lên trên đầu né đạn tầm xa & Đẩy sát thương cực đại
                    else
                        -- Bay lên đầu Boss cách 3 block tránh vùng sát thương đạn diện rộng
                        myRoot.CFrame = enemyRoot.CFrame * CFrame.new(0, 3, 0)
                        
                        EquipWeapon()
                        
                        -- Kỹ thuật nhân bản luồng gửi dữ liệu (High DMG Multithreading)
                        if hitRemote then
                            for luong = 1, 3 do
                                task.spawn(function()
                                    for i = 1, 10 do 
                                        hitRemote:FireServer(enemyRoot, enemyRoot.Position)
                                    end
                                end)
                            end
                        end
                    end
                    
                    -- Đặt thời gian chờ tối thiểu (Bỏ hẳn delay cũ để đảm bảo tốc độ tối đa không bị khựng)
                    task.wait() 
                end
            end
        end
    end
end)

