task.spawn(function()
    while true do
        task.wait(0.05) -- Tốc độ kích hoạt Gear cực nhanh
        if AuraActive then
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    -- Tự động tìm và ép trang bị/vũ khí ông giáo đang cầm (Sawblade, Ultra...) hoạt động
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        -- Quét sạch mọi ngóc ngách bản đồ
                        for _, enemy in pairs(workspace:GetDescendants()) do
                            if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                                if not Players:GetPlayerFromCharacter(enemy) and enemy.Name ~= "Base" then
                                    
                                    -- ĐÁNH LỪA GAME: Ép tâm ngắm (Target) của vũ khí dính thẳng vào tọa độ quái từ xa
                                    local hrp = enemy:FindFirstChild("HumanoidRootPart")
                                    if hrp then
                                        -- Gọi lệnh kích hoạt gốc của cây Gear ông giáo đang cầm
                                        tool:Activate()
                                        
                                        -- Bổ sung tín hiệu đánh từ xa thông qua Remote nội bộ đính kèm trong cây vũ khí
                                        local remote = tool:FindFirstChild("Remote") or tool:FindFirstChild("Action") or tool:FindFirstChild("Attack")
                                        if remote and remote:IsA("RemoteEvent") then
                                            remote:FireServer(enemy, hrp.Position)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

