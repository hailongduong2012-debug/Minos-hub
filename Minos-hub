-- Định vị điểm tuần tra gần nhất an toàn chống đạn
local function stepSafePatrol(deltaTime)
    if not safePatrolPos then
        local nearest, nearestDist = 1, math.huge
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        for i, pos in ipairs(SAFE_PATROL) do
            local dist = root and (root.Position - pos).Magnitude or i
            if dist < nearestDist then nearest, nearestDist = i, dist end
        end
        safePatrolPos = SAFE_PATROL[nearest]
        safePatrolTarget = nearest % #SAFE_PATROL + 1
    end
    local step = SAFE_PATROL_SPEED * math.min(deltaTime, 0.1)
    local target = SAFE_PATROL[safePatrolTarget]
    local diff = target - safePatrolPos
    local dist = diff.Magnitude
    if dist <= step then
        safePatrolPos = target
        safePatrolTarget = safePatrolTarget % #SAFE_PATROL + 1
    else
        safePatrolPos = safePatrolPos + diff.Unit * step
    end
    return safePatrolPos
end

