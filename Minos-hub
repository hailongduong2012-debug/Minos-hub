-- Toggle 1: Chọn Nhân Vật (Garry Method)
AutoCampaignTab:CreateToggle({
   Name = "Chọn Nhân Vật (Garry Method)",
   CurrentValue = false,
   Callback = function(Value)
      States.SelectCharacter = Value
      if Value then
          task.spawn(function()
              while States.SelectCharacter do
                  pcall(function()
                      -- Quét diện rộng tất cả các Remote có chức năng Set/Select Character trong ReplicatedStorage
                      for _, remote in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                          if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
                              if string.find(string.lower(remote.Name), "character") or string.find(string.lower(remote.Name), "char") then
                                  if remote:IsA("RemoteFunction") then
                                      remote:InvokeServer("GarryCharacter")
                                  else
                                      remote:FireServer("GarryCharacter")
                                  end
                              end
                          end
                      end
                  end)
                  task.wait(1)
              end
          end)
      end
   end,
})

-- Toggle 2: Auto Gear & Get Rainbow Sword (Dùng chiêu Gear lấy Rainbow ẩn danh)
AutoCampaignTab:CreateToggle({
   Name = "Auto Gear & Get Rainbow Sword",
   CurrentValue = false,
   Callback = function(Value)
      States.GearAndRainbow = Value
      if Value then
          task.spawn(function()
              while States.GearAndRainbow do
                  pcall(function()
                      -- 1. Kích hoạt chiêu thức của Gear hiện tại trước
                      for _, remote in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                          if remote:IsA("RemoteEvent") and (string.find(string.lower(remote.Name), "gear") or string.find(string.lower(remote.Name), "skill")) then
                              remote:FireServer("ActivateSkill")
                              remote:FireServer(true)
                          end
                      end
                      task.wait(0.3)
                      -- 2. Đón đầu kết nối ẩn danh để lấy thanh kiếm Rainbow
                      if getconnections then
                          for _, con in ipairs(getconnections(game:GetService("ReplicatedStorage").ChildAdded)) do
                              pcall(function() con:Fire() end)
                          end
                      end
                  end)
                  task.wait(1.5)
              end
          end)
      end
   end,
})

-- Toggle 3: Auto Equip & Khóa Kiếm Rainbow (Chặn đổi Gear)
AutoCampaignTab:CreateToggle({
   Name = "Auto Equip & Khóa Kiếm Rainbow",
   CurrentValue = false,
   Callback = function(Value)
      States.AutoEquipLock = Value
      if Value then
          task.spawn(function()
              while States.AutoEquipLock do
                  pcall(function()
                      local character = LocalPlayer.Character
                      local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                      if character and backpack then
                          local rainbow = backpack:FindFirstChild("Rainbow Sword")
                          
                          -- Nếu kiếm rớt vào balo, móc ra tay ngay lập tức
                          if rainbow then
                              character:WaitForChild("Humanoid"):EquipTool(rainbow)
                          end
                          
                          -- Khóa cứng Hotbar: Phát hiện có bất kỳ Gear/Vũ khí nào khác đang cầm trên tay, đá về balo liền
                          for _, item in ipairs(character:GetChildren()) do
                              if item:IsA("Tool") and item.Name ~= "Rainbow Sword" then
                                  item.Parent = backpack
                              end
                          end
                      end
                  end)
                  task.wait(0.05) -- Tần suất khóa siêu nhanh (50ms) chặn đứng mọi hành vi đổi Gear bằng phím số
              end
          end)
      end
   end,
})

-- Toggle 4: Auto Teleport & Đập Box Sát Thương Tối Đa
AutoCampaignTab:CreateToggle({
   Name = "Auto Teleport & Đập Box",
   CurrentValue = false,
   Callback = function(Value)
      States.AutoFarmBoss = Value
      if Value then
          task.spawn(function()
              while States.AutoFarmBoss do
                  pcall(function()
                      local target = GetTarget()
                      if target then
                          local targetPart = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChildOfClass("BasePart")
                          if targetPart then
                              -- Teleport áp sát chuẩn vị trí xuống Box
                              TeleportTo(targetPart.CFrame * CFrame.new(0, -2, 2))
                              
                              -- Thực hiện gom đòn đánh gây sát thương cực đại lên tới 1.000.000 trong 1 lần kích hoạt vòng lặp mạng
                              local character = LocalPlayer.Character
                              local tool = character and character:FindFirstChild("Rainbow Sword")
                              if tool then
                                  -- Tìm chính xác Remote tấn công nằm bên trong thanh kiếm hoặc trong ReplicatedStorage
                                  local attackRemote = tool:FindFirstChildOfClass("RemoteEvent") or game:GetService("ReplicatedStorage"):FindFirstChild("AttackRemote")
                                  if attackRemote then
                                      local dmgCount = tonumber(States.BossDamageInput) or 1000000
                                      -- Đập dồn dập số lượng gói tin tương đương 1,000,000 dmg
                                      for i = 1, dmgCount do
                                          if not States.AutoFarmBoss then break end
                                          attackRemote:FireServer(target)
                                      end
                                  end
                              end
                          end
                      end
                  end)
                  task.wait(States.AttackDelay / 100)
              end
          end)
      end
   end,
})

