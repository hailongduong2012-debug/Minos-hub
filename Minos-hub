-- 1. KÍCH HOẠT TÍNH NĂNG ❄️ FREEZE BOSS (Đã thêm vào bản Sbsd)
-- ========================================================
local freezeState = false
local freezeConnection = nil

createToggle("❄️ Freeze Boss (Đóng Băng)", "Khóa cứng chuyển động của Boss", function(Value)
    freezeState = Value
    if freezeState then
        freezeConnection = runService.Heartbeat:Connect(function()
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("Humanoid") and not Players:GetPlayerFromCharacter(v.Parent) then
                    local hrp = v.Parent:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.Anchored = true
                        hrp.Velocity = Vector3.new(0, 0, 0)
                    end
                end
            end
        end)
    else
        if freezeConnection then freezeConnection:Disconnect(); freezeConnection = nil end
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Humanoid") and not Players:GetPlayerFromCharacter(v.Parent) then
                local hrp = v.Parent:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.Anchored = false end
            end
        end
    end
end)

