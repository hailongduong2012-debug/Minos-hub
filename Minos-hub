-- 1. SỬA ĐỔI: Kill Aura Quét Vòng Tròn Toàn Bản Đồ 360° (Chống sót sau lưng)
Toggle1.MouseButton1Click:Connect(function()
    AuraActive = not AuraActive
    if AuraActive then
        Toggle1.Text = "Kill Aura 360° (Vô Hạn Tầm) : ON"; Toggle1.TextColor3 = Color3.fromRGB(80, 240, 80); Toggle1.BackgroundColor3 = Color3.fromRGB(20, 70, 20)
    else
        Toggle1.Text = "Kill Aura 360° (Vô Hạn Tầm) : OFF"; Toggle1.TextColor3 = Color3.fromRGB(240, 80, 80); Toggle1.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.04) -- Đẩy tốc độ chém lên mốc tối đa
        if AuraActive then
            pcall(function()
                local AttackRemote = ReplicatedStorage:FindFirstChild("Attack") or ReplicatedStorage:FindFirstChild("HitEnemy") or ReplicatedStorage:FindFirstChild("InflictDamage") or ReplicatedStorage:FindFirstChild("Hit")
                if AttackRemote then
                    -- Quét sạch mọi ngóc ngách bản đồ bất kể hướng đứng của bạn
                    for _, enemy in pairs(workspace:GetDescendants()) do
                        if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            if not Players:GetPlayerFromCharacter(enemy) and enemy.Name ~= "Base" then
                                if AttackRemote:IsA("RemoteEvent") then
                                    AttackRemote:FireServer(enemy)
                                elseif AttackRemote:IsA("RemoteFunction") then
                                    AttackRemote:InvokeServer(enemy)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- 2. SỬA ĐỔI: Safe Zone Max God Mode Tích Hợp ForceField (Không thể chết)
Toggle2.MouseButton1Click:Connect(function()
    GodModeActive = not GodModeActive
    if GodModeActive then
        Toggle2.Text = "Safe Zone God Mode (Bất Tử) : ON"; Toggle2.TextColor3 = Color3.fromRGB(80, 240, 80); Toggle2.BackgroundColor3 = Color3.fromRGB(20, 70, 20)
    else
        Toggle2.Text = "Safe Zone God Mode (Bất Tử) : OFF"; Toggle2.TextColor3 = Color3.fromRGB(240, 80, 80); Toggle2.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        -- Tắt hiệu ứng bất tử khi người chơi hủy nút
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("ForceField") then
                LocalPlayer.Character:FindFirstChildOfClass("ForceField"):Destroy()
            end
        end)
    end
end)

RunService.Heartbeat:Connect(function()
    if GodModeActive then
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then 
                    -- Liên tục hồi đầy cây máu của bạn ngay lập tức khi nhận sát thương
                    hum.Health = hum.MaxHealth 
                end
                -- Triệu hồi liên tục lớp màng bảo vệ ForceField chống quái dồn damage chết sốc
                if not char:FindFirstChildOfClass("ForceField") then
                    Instance.new("ForceField", char)
                end
            end
        end)
    end
end)

