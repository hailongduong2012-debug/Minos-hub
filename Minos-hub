-- ANTI-CHEAT / ANTI-KICK BYPASS
-----------------------------------------------------
if not IS_131_GAME then
    task.spawn(function()
        local gc = getgc(true)
        for _, v in pairs(gc) do
            pcall(function()
                local idx = rawget(v, "indexInstance")
                if type(idx) == "table" and idx[1] == "kick" then
                    setreadonly(v, false)
                    v.tvk = { "kick", function() return workspace:WaitForChild("") end }
                end
            end)
        end
    end)

    task.spawn(function()
        local PATH = {"Workspace", "Packages", "_Index", "Squads", "Squads", "Components", "SquadLobby", "SquadLobbyBanners"}

        local function getCorePackages()
            local ok, cp = pcall(function() return game:GetService("CorePackages") end)
            if ok and cp then return cp end
            return game:FindFirstChild("CorePackages")
        end

        local function resolvePath()
            local node = getCorePackages()
            if not node then return nil end
            for _, name in ipairs(PATH) do
                if not node then return nil end
                node = node:FindFirstChild(name)
            end
            return node
        end

        local function tryDestroy()
            local target = resolvePath()
            if target then
                pcall(function() target:Destroy() end)
                pcall(function() target.Parent = nil end)
                return true
            end
            return false
        end

        for _ = 1, 20 do
            if tryDestroy() then break end
            task.wait(0.25)
        end

        task.spawn(function()
            while task.wait(1) do
                tryDestroy()
            end
        end)
    end)
end

