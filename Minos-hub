    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if SkyAnchoredActive and root then
        -- Lưu vị trí gốc trên mặt đất
        SavedLocation = root.CFrame
        -- Đưa thẳng nhân vật lên độ cao an toàn tuyệt đối
        root.CFrame = root.CFrame * CFrame.new(0, 550, 0)
    else
        -- Trả tự do vật lý và đưa về vị trí cũ khi tắt
        if root then
            root.Anchored = false
            if SavedLocation then root.CFrame = SavedLocation end
        end
    end
end)

-- Thực thi vòng lặp khóa cứng tọa độ ở chu kỳ kết xuất để triệt tiêu bộ kéo lùi của Server
RunService.RenderStepped:Connect(function()
    if SkyAnchoredActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local char = LocalPlayer.Character
            local playerRoot = char.HumanoidRootPart
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            -- ÉP CHẶT NEO VẬT LÝ: Đóng băng dữ liệu vận tốc, vô hiệu hóa lệnh kéo lùi từ Server
            playerRoot.Anchored = true
            
            if humanoid then
                humanoid.BreakJointsOnDeath = false
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                if humanoid.Health < humanoid.MaxHealth then humanoid.Health = humanoid.MaxHealth end
            end
        end)
    end
end)


