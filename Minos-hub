-- HÀM KHỞI TẠO NÚT BẬT TẮT
local yOffset = 45
local function createHackToggle(name, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 35)
    btn.Position = UDim2.new(0, 10, 0, yOffset)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.Text = name .. " : [OFF]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = MenuFrame

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
            btn.Text = name .. " : [BẬT]"
            btn.TextColor3 = Color3.fromRGB(0, 0, 0)
        else
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            btn.Text = name .. " : [OFF]"
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        callback(active)
    end)
    yOffset = yOffset + 45
end

-- ========================================================
-- 1. CHỨC NĂNG ❄️ FREEZE BOSS NÂNG CẤP (KHÓA CẢ HOẠT ẢNH)
-- ========================================================
local freezeLoop = nil
createHackToggle("❄️ Đóng Băng Boss", function(state)
    if state then
        freezeLoop = runService.Heartbeat:Connect(function()
            for _, obj in pairs(workspace:GetDescendants()) do
                -- Lọc lấy chính xác quái vật/boss, bỏ qua người chơi
                if obj:IsA("Humanoid") and not Players:GetPlayerFromCharacter(obj.Parent) then
                    local rootPart = obj.Parent:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        -- Khóa tọa độ và triệt tiêu toàn bộ vận tốc để tránh chiêu fling
                        rootPart.Anchored = true
                        rootPart.Velocity = Vector3.new(0, 0, 0)
                        rootPart.RotVelocity = Vector3.new(0, 0, 0)
                    end
                    -- Ép tất cả các hoạt ảnh ra chiêu của Boss dừng chạy
                    local animator = obj:FindFirstChildOfClass("Animator") or obj
                    if animator then
                        pcall(function()
                            for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                                track:AdjustSpeed(0) -- Giảm tốc độ hoạt ảnh về 0 (Đứng hình chiêu thức)
                            end
                        </pcall>
                    end
                end
            end
        end)
    else
        if freezeLoop then freezeLoop:Disconnect(); freezeLoop = nil end
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Humanoid") and not Players:GetPlayerFromCharacter(obj.Parent) then
                local rootPart = obj.Parent:FindFirstChild("HumanoidRootPart")
                if rootPart then rootPart.Anchored = false end
                
                local animator = obj:FindFirstChildOfClass("Animator") or obj
                if animator then
                    pcall(function()
                        for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                            track:AdjustSpeed(1) -- Trả lại tốc độ hoạt ảnh bình thường khi tắt hack
                        end
                    end)
                end
            end
        end
    end
end)

-- ========================================================
-- 2. CHỨC NĂNG 🛡️ AUTO PARRY CHẠY NỀN KHÔNG TRỄ
-- ========================================================
local parryState = false
createHackToggle("🛡️ Auto Parry Đỡ Đòn", function(state)
    parryState = state
end)

local function triggerParrySkill()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if char and char:FindFirstChildOfClass("Humanoid") then
        local tool = (backpack and backpack:FindFirstChild("Azure Periastron")) or char:FindFirstChild("Azure Periastron")
        if tool then
            if tool.Parent ~= char then char.Humanoid:EquipTool(tool) end
            local remote = tool:FindFirstChild("Remote")
            if remote then remote:FireServer(Enum.KeyCode.E) end
        end
    end
end

local function listenToCharacter(char)
    char.DescendantAdded:Connect(function(desc)
        if not parryState then return end
        local textureId = ""
        if desc:IsA("ParticleEmitter") then textureId = string.match(desc.Texture, "%d+") or ""
        elseif desc:IsA("MeshPart") or desc:IsA("SpecialMesh") then textureId = string.match(desc.MeshId, "%d+") or "" end
        
        -- Nhận diện mã nguồn hạt đòn đánh quét diện rộng của Ahat Man / God Demon
        if textureId == "214269134" then
            task.spawn(triggerParrySkill)
        end
    end)
end

if LocalPlayer.Character then listenToCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(listenToCharacter)

