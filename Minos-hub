                        targetPos = LocalPlayer.Character.HumanoidRootPart.Position + Vector3.new(math.random(-4,4), -3, math.random(-4,4))
                    end
                    
                    if SummonRemote:IsA("RemoteEvent") then
                        SummonRemote:FireServer("Heli", targetPos)
                        SummonRemote:FireServer("Telescope", targetPos)
                    elseif SummonRemote:IsA("RemoteFunction") then
                        SummonRemote:InvokeServer("Heli", targetPos)
