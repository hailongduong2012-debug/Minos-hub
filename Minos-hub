local function SA_IsCameraOrSystemScript()
    if not getcallingscript then return false end
    local sc = getcallingscript()
    if not sc then return false end
    local name = sc.Name:lower()
    local parent = sc.Parent
    local parentName = parent and parent.Name:lower() or ""
    if name:find("camera") or name:find("popper") or name:find("control")
       or name:find("player") or name:find("zoom") or name:find("shiftlock")
       or name:find("animate") or name:find("mouse")
       or parentName:find("camera") or parentName:find("player") or parentName:find("control") then
        return true
    end
    return false
end

