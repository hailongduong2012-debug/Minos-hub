-- Ép máu nhân vật thành vô hạn thực sự ở mức dữ liệu lõi, quái đánh hoàn toàn không mất máu
RunService.PreSimulation:Connect(function()
    if GodModeActive and LocalPlayer.Character then
        pcall(function()
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                -- Ép chỉ số Math Huge (Vô hạn thực tế) vào thanh máu trực tiếp
                hum.MaxHealth = 999999999
                hum.Health = 999999999
                
                -- Đóng băng trạng thái nhận sát thương từ Server gửi về Client
                hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                if hum:GetState() == Enum.HumanoidStateType.FallingDown or hum:GetState() == Enum.HumanoidStateType.Ragdoll then
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
            end
        end)
    end
end)


