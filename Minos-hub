-- MINOS HUB | SBSD REMOTE TOUCH AURA (CHÉM TẦM XA KHÔNG GOM QUÁI)
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "MINOS HUB | SBSD",
   LoadingTitle = "Đang đồng bộ Touch Aura Tầm Xa...",
   LoadingSubtitle = "BY MINOS",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false 
})

local MainTab = Window:CreateTab("Remote Touch", 4483362458)

_G.RemoteTouchAura = false
_G.AttackSpeed = 0.01 -- Tốc độ kích hoạt nhịp nhảy damage cực nhanh (0.01 giây)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Hàm giả lập chạm kiếm vào quái toàn bản đồ từ xa
local function applyRemoteTouchAura()
    local character = LocalPlayer.Character
    if not character then return end
    
    -- Kiểm tra xem bạn đã cầm vũ khí trên tay chưa
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end
    
    -- Tìm phần gây sát thương của vũ khí (Handle hoặc Blade)
    local toolHandle = tool:FindFirstChild("Handle") or tool:FindFirstChild("Blade") or tool:FindFirstChildOfClass("Part")
    if not toolHandle then return end

    -- Xác định thư mục chứa quái vật trong trận đấu SBSD
    local enemyContainer = workspace:FindFirstChild("Enemies") or workspace

    for _, child in pairs(enemyContainer:GetChildren()) do
        if child:IsA("Model") and child ~= character then
            local humanoid = child:FindFirstChildOfClass("Humanoid")
            local enemyRoot = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("PrimaryPart")
            
            if humanoid and enemyRoot and humanoid.Health > 0 then
                -- Ép sự kiện va chạm (Touch) vật lý giữa lưỡi kiếm và quái từ xa
                -- Số 0 là bắt đầu chạm (nhận sát thương), số 1 là bỏ chạm (để hồi lại nhịp chém tiếp theo)
                firetouchinterest(enemyRoot, toolHandle, 0)
                firetouchinterest(enemyRoot, toolHandle, 1)
            end
        end
    end
end

-- Vòng lặp quét quái và kích hoạt sát thương liên tục
task.spawn(function()
    while true do
        if _G.RemoteTouchAura then
            pcall(applyRemoteTouchAura)
        end
        task.wait(_G.AttackSpeed)
    end
end)

-- Tạo nút công tắc Bật/Tắt trên giao diện Rayfield bản quyền MINOS
local Toggle = MainTab:CreateToggle({
   Name = "Kích hoạt Remote Touch Aura (Chỉ cần cầm vũ khí)",
   CurrentValue = false,
   Flag = "MINOSRemoteTouch",
   Callback = function(Value)
      _G.RemoteTouchAura = Value
      if Value then
          Rayfield:Notify({Title = "MINOS HUB", Content = "Đã kích hoạt chém từ xa không gom quái!", Duration = 2.5})
      else
          Rayfield:Notify({Title = "MINOS HUB", Content = "Đã tắt Touch Aura.", Duration = 2.5})
      end
   end,
})
