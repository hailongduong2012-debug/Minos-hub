-- ========================================================
-- SCRIPT SBSD - PHIÊN BẢN CHẠY NGẦM KHÔNG UI (ANTI-BAN & AUTO-ACTIVATE)
-- Tự động kích hoạt Đóng băng Boss, Auto Parry và Anti-Fling
-- ========================================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local runService = game:GetService("RunService")
local workspace = game:GetService("Workspace")

-- Thông báo chạy thành công dưới góc màn hình bằng hệ thống gốc của Roblox
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "SBSD CHẠY NGẦM",
    Text = "Đang đóng băng Boss + Auto Parry... Không cần UI!",
    Duration = 5
})

-- ========================================================
-- LOGIC 1: ❄️ TỰ ĐỘNG ĐÓNG BĂNG BOSS VĨNH VIỄN (FREEZE ALL BOSSES)
-- ========================================================
runService.Heartbeat:Connect(function()
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Humanoid") and not Players:GetPlayerFromCharacter(v.Parent) then
            local hrp = v.Parent:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Anchored = true
                hrp.Velocity = Vector3.new(0, 0, 0)
                hrp.RotVelocity = Vector3.new(0, 0, 0)
            end
        end
    end
end)

-- ========================================================
-- LOGIC 2: 🛡️ AUTO PARRY KHÔNG TRỄ (0-MS AUTO PARRY)
-- ========================================================
local function equipAndParry()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if char and char:FindFirstChildOfClass("Humanoid") then
        local tool = (backpack and backpack:FindFirstChild("Azure Periastron")) or char:FindFirstChild("Azure Periastron")
        if tool then
            if tool.Parent ~= char then char.Humanoid:EquipTool(tool) end
            local remote = tool:FindFirstChild("Remote")
            if remote then remote:FireServer(Enum.KeyCode.E) end
        end
    end
end

local function listenToCharacter(char)
    char.DescendantAdded:Connect(function(descendant)
        local id = ""
        if descendant:IsA("ParticleEmitter") then 
            id = string.match(descendant.Texture, "%d+") or ""
        elseif descendant:IsA("MeshPart") or descendant:IsA("SpecialMesh") then 
            id = string.match(descendant.MeshId, "%d+") or "" 
        end
        
        -- Nhận diện đúng mã hạt đòn đánh chí mạng của Ahat Man / God Demon
        if id == "214269134" then
            task.spawn(equipAndParry)
        end
    end)
end

if LocalPlayer.Character then listenToCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(listenToCharacter)

-- ========================================================
-- LOGIC 3: 🚫 CHỐNG LỆNH ADMIN BAN/FLING (ANTI ADMIN POWERS)
-- ========================================================
runService.Heartbeat:Connect(function()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.RotVelocity = Vector3.new(0, 0, 0)
    end
end)
