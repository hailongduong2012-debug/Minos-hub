-- Tạo luồng chạy lặp nhịp tim liên tục (Heartbeat) ép dữ liệu máu không đổi bất kể quái dồn sát thương
RunService.Heartbeat:Connect(function()
    if GodModeActive then
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.Health = hum.MaxHealth -- Liên tục bơm đầy máu mỗi mili giây
                    
                    -- Cơ chế chống sập: Đóng băng trạng thái chết bằng cách ép các thuộc tính trạng thái nhân vật
                    if hum.Health <= 0 then
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                        hum.Health = hum.MaxHealth
                    end
                end
                
                -- Tạo liên tục màng bảo vệ ForceField gốc của hệ thống Roblox để chặn đứng sát thương chí mạng
                if not char:FindFirstChildOfClass("ForceField") then
                    Instance.new("ForceField", char)
                end
            end
        end)
    end
end)

