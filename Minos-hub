local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Minos Hub & Garry | SBSD Edition",
   LoadingTitle = "Script by minos",
   LoadingSubtitle = "Author: minos",
   ConfigurationSaving = {
      Enabled = false,
      FolderName = "MinosHubGarry"
   },
   Discord = {
      Enabled = false,
      Invite = ""
   },
   KeySystem = false
})

-- 2. Tạo Tab bằng chuỗi thô (Chuẩn Garry)
local AutoCampaignTab = Window:CreateTab("Auto Campaign", 4483362458) 

-- 3. Cấu hình biến trạng thái tính năng theo logic Garry
local States = {
    SelectCharacter = false,
    GearAndRainbow = false,
    AutoEquipLock = false,
    AutoFarmBoss = false,
    BossDamageInput = 1000000, -- Mặc định sát thương yêu cầu
    AttackDelay = 1
}

-- Khai báo dịch vụ Roblox cần thiết
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")

-- Hàm Teleport mượt chống kẹt / chống check của game
local function TeleportTo(cframe)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root then
        pcall(function()
            root.CFrame = cframe
        end)
    end
end

-- ====================================================================
-- BỘ 4 NÚT TOGGLE ĐỘC LẬP THEO CƠ CHẾ GARRY
-- ====================================================================

-- Toggle 1: Chọn Nhân Vật (Theo cấu trúc chuẩn của Garry)
AutoCampaignTab:CreateToggle({
   Name = "Chọn Nhân Vật (Garry Method)",
   CurrentValue = false,
   Callback = function(Value)
      States.SelectCharacter = Value
      if Value then
          task.spawn(function()
              while States.SelectCharacter do
                  pcall(function()
                      -- Gửi tín hiệu chọn nhân vật mặc định lên Remote Event của game giống bản Garry
                      local charRemote = game:GetService("ReplicatedStorage"):FindFirstChild("CharacterRemote") or game:GetService("ReplicatedStorage"):FindFirstChild("SelectCharacter")
                      if charRemote then
                          charRemote:InvokeServer("GarryCharacter") -- Tên nhân vật hoặc tham số truyền vào
                      end
                  end)
                  task.wait(1)
              end
          end)
      end
   end,
})

-- Toggle 2: Chọn Gear & Dùng Chiêu Lấy Thanh Rainbow
AutoCampaignTab:CreateToggle({
   Name = "Auto Gear & Get Rainbow Sword",
   CurrentValue = false,
   Callback = function(Value)
      States.GearAndRainbow = Value
      if Value then
          task.spawn(function()
              while States.GearAndRainbow do
                  pcall(function()
                      -- Tự động kích hoạt/dùng chiêu của Gear trước
                      local gearRemote = game:GetService("ReplicatedStorage"):FindFirstChild("GearRemote") or game:GetService("ReplicatedStorage"):FindFirstChild("UseGear")
                      if gearRemote then
                          gearRemote:FireServer("ActivateSkill")
                      end
                      task.wait(0.2)
                      -- Gọi lệnh lấy thanh kiếm Rainbow ẩn danh
                      if getconnections then
                          for _, con in ipairs(getconnections(game:GetService("ReplicatedStorage").ChildAdded)) do
                              pcall(function() con:Fire() end)
                          end
                      end
                  end)
                  task.wait(2)
              end
          end)
      end
   end,
})

-- Toggle 3: Auto Equip & Khóa Cứng Thanh Rainbow (Chặn đổi Gear khác)
AutoCampaignTab:CreateToggle({
   Name = "Auto Equip & Khóa Kiếm Rainbow",
   CurrentValue = false,
   Callback = function(Value)
      States.AutoEquipLock = Value
      if Value then
          task.spawn(function()
              while States.AutoEquipLock do
                  pcall(function()
                      local character = LocalPlayer.Character
                      local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                      if character and backpack then
                          local rainbow = backpack:FindFirstChild("Rainbow Sword")
                          
                          -- Nếu kiếm đang nằm trong Backpack, tự động trang bị lên tay
                          if rainbow then
                              rainbow.Parent = character
                          end
                          
                          -- Khóa cứng hotbar: Nếu người chơi cố tình chuyển sang Tool/Gear khác, ép cất đi ngay
                          for _, item in ipairs(character:GetChildren()) do
                              if item:IsA("Tool") and item.Name ~= "Rainbow Sword" then
                                  item.Parent = backpack
                              end
                          end
                      end
                  end)
                  task.wait(0.1) -- Tần suất quét cực nhanh để khóa chặt trạng thái cầm kiếm
              end
          end)
      end
   end,
})

-- Toggle 4: Teleport Đập Boss Sát Thương Tối Đa (Chống kẹt bằng pcall)
AutoCampaignTab:CreateToggle({
   Name = "Auto Teleport & Đập Boss",
   CurrentValue = false,
   Callback = function(Value)
      States.AutoFarmBoss = Value
      if Value then
          task.spawn(function()
              while States.AutoFarmBoss do
                  pcall(function()
                      -- Tìm mục tiêu Boss hoặc Hộp (Box) trong Workspace
                      local targetBox = workspace:FindFirstChild("Boss") or workspace:FindFirstChild("Box") or workspace:FindFirstChild("Enemies")
                      if targetBox then
                          local targetRoot = targetBox:FindFirstChild("HumanoidRootPart") or targetBox:FindFirstChildOfClass("Part")
                          
                          if targetRoot then
                              -- Tự động dịch chuyển xuống sát vị trí Box/Boss để chém
                              TeleportTo(targetRoot.CFrame * CFrame.new(0, 0, 3))
                              
                              -- Logic chém gây sát thương tùy chỉnh lên tới 1.000.000
                              local character = LocalPlayer.Character
                              local tool = character and character:FindFirstChild("Rainbow Sword")
                              if tool and tool:FindFirstChild("AttackRemote") then
                                  -- Vòng lặp gửi yêu cầu mô phỏng số lần chém tương đương lượng sát thương nhập vào
                                  for i = 1, tonumber(States.BossDamageInput) do
                                      tool.AttackRemote:FireServer(targetBox)
                                  end
                              end
                          end
                      end
                  end)
                  -- Tốc độ delay chém (lấy giá trị Slider chia cho 100)
                  task.wait(States.AttackDelay / 100)
              end
          end)
      end
   end,
})

-- ====================================================================
-- BỘ ĐIỀU CHỈNH SÁT THƯƠNG & DELAY CHÉM
-- ====================================================================

-- Thay thế Slider bằng Input Box để gõ số lớn lên tới 1.000.000 không bị giới hạn UI
AutoCampaignTab:CreateInput({
   Name = "Nhập Sát Thương Đập Boss (Tối đa 1,000,000)",
   PlaceholderText = "1000000",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
      local num = tonumber(Text)
      if num and num >= 1 and num <= 1000000 then
          States.BossDamageInput = num
      else
          States.BossDamageInput = 1000000 -- Trở về mặc định nếu nhập sai số
      end
   end,
})

-- Slider tùy chỉnh tốc độ delay chém từ 1-50 (Chia 100 trong code)
AutoCampaignTab:CreateSlider({
   Name = "Tốc Độ Delay Chém (Chia 100)",
   Min = 1,
   Max = 50,
   CurrentValue = 1,
   Flag = "AttackDelaySlider",
   Callback = function(Value)
      States.AttackDelay = Value
   end,
})

