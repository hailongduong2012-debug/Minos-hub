-- Hàm xử lý Boss ngáo: Xóa chiêu + Không cho di chuyển
local function DebuffBoss(boss)
    if boss:IsA("Model") and not Excluded[boss.Name] then
        -- 1. Đóng băng di chuyển hợp lệ (Không làm văng anti-cheat)
        local humanoid = boss:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
        end
        
        -- 2. Chặn xài chiêu: Xóa hoặc vô hiệu hóa các công cụ vũ khí/script chiêu thức
        for _, item in pairs(boss:GetChildren()) do
            if item:IsA("Tool") or item:IsA("Weapon") then
                item:Destroy() -- Xóa luôn vũ khí khiến boss không có gì để kích hoạt chiêu
            elseif item:IsA("Script") or item:IsA("LocalScript") then
                if item.Name:lower():match("skill") or item.Name:lower():match("power") or item.Name:lower():match("attack") then
                    item.Disabled = true -- Tắt script kích hoạt chiêu thức của Boss
                end
            end
        end
        
        -- Chặn hoạt ảnh xuất chiêu (Anims)
        if humanoid then
            local animator = humanoid:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                    track:Stop()
                end
            end
        end
    end
end

-- Vòng lặp ngầm điều phối an toàn
task.spawn(function()
    while true do
        task.wait(0.4) -- Quét giãn cách an toàn chống lag/kick
        if FreezeActive then
            pcall(function()
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
                        if not game.Players:GetPlayerFromCharacter(obj) then
                            DebuffBoss(obj)
                        end
                    end
                end
            end)
        end
    end
end)

ToggleBtn.MouseButton1Click:Connect(function()
    FreezeActive = not FreezeActive
    if FreezeActive then
        ToggleBtn.Text = "FREEZE & MUTE: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
    else
        ToggleBtn.Text = "FREEZE BOSS: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        -- Phục hồi tốc độ di chuyển cho boss khi tắt
        pcall(function()
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if hum and not Excluded[obj.Name] then
                        hum.WalkSpeed = 16
                    end
                end
            end
        end)
    end
end)
