   ConfigurationSaving = { Enabled = false },
   KeySystem = false 
})

local MainTab = Window:CreateTab("Remote Aura", 4483362458)

_G.RemoteAura = false
_G.ScanRange = 300 -- Phạm vi quét quái tầm xa toàn map (300 Studs)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Hàm xử lý truyền sát thương từ xa bằng va chạm ảo
local function applyRemotePassiveAura()
    local character = LocalPlayer.Character
    if not character then return end
    
    -- Kiểm tra xem bạn đã cầm vũ khí trên tay chưa
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end
    
    -- Tìm phần nhận diện chạm của vũ khí (Handle/Blade)
    local toolHandle = tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("Part")
    if not toolHandle then return end

    local enemyContainer = workspace:FindFirstChild("Enemies") or workspace

    for _, child in pairs(enemyContainer:GetChildren()) do
        if child:IsA("Model") and child ~= character then
            local humanoid = child:FindFirstChildOfClass("Humanoid")
            local enemyRoot = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("PrimaryPart")
            
            if humanoid and enemyRoot and humanoid.Health > 0 then
                -- Tính khoảng cách đến quái từ xa
                local distance = (character.HumanoidRootPart.Position - enemyRoot.Position).Magnitude
                
                if distance <= _G.ScanRange then
                    -- METHOD MINOS REMOTE: Đồng bộ hóa sự kiện chạm vật lý (Touch Interest) 
                    -- Kích hoạt trực tiếp hàm nhận diện va chạm giữa Lưỡi kiếm và Quái từ xa mà không cần dịch chuyển nhân vật
                    if toolHandle:FindFirstChildOfClass("TouchTransmitter") then
                        firetouchinterest(enemyRoot, toolHandle, 0) -- Giả lập chạm vào quái
                        firetouchinterest(enemyRoot, toolHandle, 1) -- Giải phóng chạm ngay lập tức để tạo nhịp nhảy dmg liên tục
                    end
                end
            end
        end
    end
end

-- Vòng lặp kích hoạt liên tục tốc độ cao (0.05s một nhịp chém tầm xa)
task.spawn(function()
    while true do
        if _G.RemoteAura then
            pcall(applyRemotePassiveAura)
        end
        task.wait(0.05) -- Tốc độ nhảy sát thương liên tục cực nhanh và mượt mà
    end
end)

