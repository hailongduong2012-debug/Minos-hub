-- HỆ THỐNG BIẾN ĐIỀU KHIỂN ĐỘC LẬP
local AutoAdmin = false
local AutoGetGear = false
local AutoEquip = false
local AutoFastAttack = false

-- BIẾN TÙY CHỈNH SÁT THƯƠNG VÀ TỐC ĐỘ CHÉM
local CustomDamageAmount = 10 
local CustomAttackDelay = 0.05 

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local virtualInputManager = game:GetService("VirtualInputManager")

-- HÀM 1: CHỌN NHÂN VẬT ADMIN (DÙNG PHƯƠNG PHÁP CLICK CONNECTION CỦA GARRY)
local function ProcessSelectAdmin()
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:FindFirstChild("PlayerGui")
    local charClass = playerGui and playerGui:FindFirstChild("CharClass")
    if not charClass then return end
    
    for _, desc in ipairs(charClass:GetDescendants()) do
        if desc:IsA("GuiButton") and desc.Name == "Admin" and desc.Visible then
            if not charClass.Enabled then charClass.Enabled = true end
            pcall(function()
                for _, connection in pairs(getconnections(desc.MouseButton1Click)) do connection:Fire() end
                for _, connection in pairs(getconnections(desc.MouseButton1Down)) do connection:Fire() end
                if desc.Activated then
                    for _, connection in pairs(getconnections(desc.Activated)) do connection:Fire() end
                end
            end)
            break
        end
    end
end

-- HÀM 2: LẤY KIẾM (DÙNG PHƯƠNG PHÁP CLICK CỦA GARRY + AUTO SLOT TIẾN HÓA)
local function ProcessGetRainbowGear()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local character = LocalPlayer.Character
    local hasRainbow = (backpack and backpack:FindFirstChild("RainbowPeriastron")) or (character and character:FindFirstChild("RainbowPeriastron"))
    
    if not hasRainbow then
        virtualInputManager:SendKeyEvent(true, Enum.KeyCode.G, false, game)
        task.wait(0.1)
        virtualInputManager:SendKeyEvent(false, Enum.KeyCode.G, false, game)
        task.wait(0.2)
        
        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:FindFirstChild("PlayerGui")
        local gearsGui = playerGui and playerGui:FindFirstChild("gears")
        
        if gearsGui and gearsGui.Enabled then
            for _, obj in ipairs(gearsGui:GetDescendants()) do
                if (obj:IsA("GuiButton") or obj:IsA("GuiObject")) and string.lower(obj.Name) == "rainbowperiastron" and obj.Visible then
                    pcall(function()
                        for _, connection in pairs(getconnections(obj.MouseButton1Click)) do connection:Fire() end
                        for _, connection in pairs(getconnections(obj.MouseButton1Down)) do connection:Fire() end
                        if obj:IsA("GuiButton") and obj.Activated then
                            for _, connection in pairs(getconnections(obj.Activated)) do connection:Fire() end
                        end
                    end)
                    break
                end
            end
            task.wait(0.2)
            gearsGui.Enabled = false
        end
    else
        -- Luôn ưu tiên kích hoạt slot chứa thanh kiếm trong kho đồ
        if backpack then
            local items = backpack:GetChildren()
            for index, item in ipairs(items) do
                if item.Name == "RainbowPeriastron" then
                    if index <= 9 then
                        pcall(function()
                            local slotKey = Enum.KeyCode[ "Number" .. tostring(index) ]
                            virtualInputManager:SendKeyEvent(true, slotKey, false, game)
                            task.wait(0.05)
                            virtualInputManager:SendKeyEvent(false, slotKey, false, game)
                        end)
                    end
                    break
                end
            end
        end
    end
end

-- HÀM 3: TỰ ĐỘNG KHÓA VÀ TRANG BỊ VŨ KHÍ
local function ProcessEquipWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    if character and backpack then
        local currentTool = character:FindFirstChildOfClass("Tool")
        if not currentTool or currentTool.Name ~= "RainbowPeriastron" then
            if currentTool then currentTool.Parent = backpack task.wait(0.05) end
            local rainbowTool = backpack:FindFirstChild("RainbowPeriastron")
            if rainbowTool then character.Humanoid:EquipTool(rainbowTool) end
        end
    end
end

-- KHỞI CHẠY LUỒNG TÍNH NĂNG ĐỘC LẬP
task.spawn(function()
    while true do
        task.wait(0.1)
        if AutoAdmin then pcall(ProcessSelectAdmin) end
        if AutoGetGear then pcall(ProcessGetRainbowGear) end
        if AutoEquip then pcall(ProcessEquipWeapon) end
    end
end)

-- VÒNG LẶP CHÍNH AUTO FARM (CHỈ CHẠY KHI BẬT FAST ATTACK)
task.spawn(function()
    while true do
        task.wait(0.1)
        
        if AutoFastAttack and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local myRoot = LocalPlayer.Character.HumanoidRootPart
            local enemiesFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Zombies") or workspace
            local hitRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Hit") or game:GetService("ReplicatedStorage"):FindFirstChild("Damage")
            
            local targetEnemy = nil
            local shortestDistance = math.huge
            
            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") then
                    local humanoid = enemy:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        local distance = (myRoot.Position - enemy.HumanoidRootPart.Position).Magnitude
                        if distance < shortestDistance then
                            shortestDistance = distance
                            targetEnemy = enemy
                        end
                    end
                end
            end
            
            if targetEnemy and targetEnemy:FindFirstChild("HumanoidRootPart") then
                local enemyRoot = targetEnemy.HumanoidRootPart
                local humanoid = targetEnemy:FindFirstChildOfClass("Humanoid")
                local enemyNameLower = string.lower(targetEnemy.Name)
                
                local isBoss = string.find(enemyNameLower, "boss") or string.find(enemyNameLower, "titan") or (humanoid and humanoid.MaxHealth >= 1000)
                
                while AutoFastAttack and targetEnemy and targetEnemy.Parent and enemyRoot and enemyRoot.Parent and humanoid and humanoid.Health > 0 do
                    pcall(function()
                        local targetPos = enemyRoot.Position
                        
                        if not isBoss then
                            -- Diệt quái thường
                            myRoot.CFrame = enemyRoot.CFrame * CFrame.new(0, 0, 2.5)
                            myRoot.AssemblyLinearVelocity = Vector3.zero
                            
                            local boxPart = targetEnemy:FindFirstChild("Box")
                            if boxPart then
                                local closePrompt = boxPart:FindFirstChild("Close") or boxPart:FindFirstChildWhichIsA("ProximityPrompt")
                                if closePrompt and fireproximityprompt then fireproximityprompt(closePrompt) end
                            end
                            
                            if hitRemote then hitRemote:FireServer(enemyRoot, targetPos) end
                        else
                            -- Diệt Boss/Titan (Sát thương to nhỏ chỉnh bằng CustomDamageAmount qua Slider)
                            myRoot.CFrame = enemyRoot.CFrame * CFrame.new(0, 3.5, 0)
                            myRoot.AssemblyLinearVelocity = Vector3.zero
                            
                            if hitRemote then
                                task.spawn(function()
                                    for i = 1, CustomDamageAmount do 
                                        if enemyRoot and enemyRoot.Parent then
                                            hitRemote:FireServer(enemyRoot, targetPos)
                                        end
                                    end
                                end)
                            end
                        end
                    end)
                    task.wait(CustomAttackDelay)
                end
            end
        end
    end
end)

