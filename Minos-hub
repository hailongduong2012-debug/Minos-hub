-- [[ MINOS HUB OVERLOAD ENGINE ]]
-- CHỨC NĂNG: SỬA INTERFACE CHUẨN MINOS, KILL AURA KHÔNG DELAY, RANGE TOÀN BẢN ĐỒ KHI CẦM GEAR

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local P = game:GetService("Players")
local LP = P.LocalPlayer
local RS = game:GetService("ReplicatedStorage")
local RunS = game:GetService("RunService")

local A_Active = false

-- === KHỞI TẠO BẢNG ĐIỀU KHIỂN CHUẨN MINOS HUB ===
local Window = Rayfield:CreateWindow({
   Name = "Minos hub Premium | SBSD GLOBAL",
   LoadingTitle = "Minos hub Loading...",
   LoadingSubtitle = "by minos",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "MinosHubSBSD",
      FileName = "MinosConfig"
   },
   Discord = { Enabled = false, Invite = "", RememberJoins = true },
   KeySystem = false
})

-- Tạo đúng cấu trúc Tab Farm của Minos Hub
local FarmTab = Window:CreateTab("Death Mode Farm", 4483345998)

-- Đổi tên tính năng theo yêu cầu: Loại bỏ chữ "Global", cấu trúc lại thông số
FarmTab:CreateToggle({
   Name = "Kill Aura (No Delay - Map Range)",
   CurrentValue = false,
   Flag = "KillAuraFlag",
   Callback = function(Value)
      A_Active = Value
   end,
})

-- === HÀM THỰC THI SÁT THƯƠNG DIỆN RỘNG (MAP RANGE) ===
local function FireAbsoluteDamage(enemy, currentGear)
    if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
        -- Loại trừ chính bạn, người chơi cùng phòng và Base để tránh lỗi game
        if not P:GetPlayerFromCharacter(enemy) and enemy.Name ~= "Base" and enemy ~= LP.Character then
            
            -- Ép kích hoạt Gear trên tay vung đòn liên tục không khoảng cách
            pcall(function() currentGear:Activate() end)

            -- Quét sạch mọi Remote Event nhận sát thương trong ReplicatedStorage của SBSD
            for _, remote in pairs(RS:GetDescendants()) do
                if remote:IsA("RemoteEvent") and (remote.Name:lower():match("attack") or remote.Name:lower():match("hit") or remote.Name:lower():match("damage") or remote.Name:lower():match("punch")) then
                    pcall(function()
                        local hrp = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChildOfClass("Part")
                        if hrp then
                            -- Ép nổ sát thương bằng cách gửi dồn dập các cấu trúc dữ liệu bypass kiểm tra từ Server
                            remote:FireServer(enemy, hrp.Position)
                            remote:FireServer(hrp, hrp.Position)
                            remote:FireServer(enemy, currentGear)
                            remote:FireServer(enemy)
                        end
                    end)
                end
            end
        end
    end
end

-- === VÒNG LẶP LIÊN TỤC KHÔNG ĐỘ TRỄ (NO DELAY - RENDERSTEPPED) ===
RunS.RenderStepped:Connect(function()
    if A_Active and LP.Character then
        -- Điều kiện tiên quyết: Chỉ hoạt động khi người chơi lôi một Gear (Tool) bất kỳ ra sử dụng
        local currentGear = LP.Character:FindFirstChildOfClass("Tool")
        
        if currentGear then
            -- Mở rộng tối đa bộ quét: Duyệt qua tất cả các thư mục con ẩn sâu nhất (GetDescendants)
            for _, object in pairs(workspace:GetDescendants()) do
                FireAbsoluteDamage(object, currentGear)
            end
        end
    end
end)
