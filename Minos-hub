-- Hàm tìm mục tiêu an toàn dựa trên khoảng cách (Chỉ hoạt động khi vào trận)
local function getSBSDTargets()
    local validTargets = {}
    for _, child in pairs(workspace:GetChildren()) do
        if child:IsA("Model") and child ~= LocalPlayer.Character then
            local humanoid = child:FindFirstChildOfClass("Humanoid")
            local mainPart = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("PrimaryPart")
            
            if humanoid and mainPart and humanoid.Health > 0 then
                -- PHÓNG TO HITBOX: Tự động gom mục tiêu tầm xa vào tầm chém thật mà không hack mạng
                mainPart.Size = Vector3.new(20, 20, 20)
                mainPart.CanCollide = false
                table.insert(validTargets, mainPart)
            end
        end
    end
    return #validTargets > 0 and validTargets or nil
end

-- Vòng lặp vung đòn vật lý an toàn 100% không bị Namecall Detect
task.spawn(function()
    while true do
        if _G.QuorumAura then
            local currentEnemies = getSBSDTargets()
            
            if currentEnemies then
                local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool then
                    -- Mô phỏng thao tác bấm chuột trái trực tiếp trên thiết bị (Không gửi RemoteEvent giả)
                    VirtualUser:CaptureController()
                    VirtualUser:Button1Down(Vector2.new(0,0))
                end
            end
        end
        task.wait(_G.AttackSpeed)
    end
end)

