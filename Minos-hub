-- 3. XỬ LÝ LOGIC LOG IN GAME VÀ AUTO CAMPAIGN
local AutoFastAttack = false

-- Hàm 1: Chọn Admin
local function AutoSelectAdmin()
    local playerGui = Player:FindFirstChildOfClass("PlayerGui") or Player:FindFirstChild("PlayerGui")
    local charClass = playerGui and playerGui:FindFirstChild("CharClass")
    if not charClass then return end
    
    local adminBtn = nil
    for _, desc in ipairs(charClass:GetDescendants()) do
        if desc:IsA("GuiButton") and desc.Name == "Admin" then
            adminBtn = desc
            break
        end
    end
    
    if adminBtn and adminBtn.Visible then
        if not charClass.Enabled then charClass.Enabled = true end
        local vp = workspace.CurrentCamera.ViewportSize
        adminBtn.Size = UDim2.new(1, 0, 1, 0)
        virtualInputManager:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, true, game, 1)
        task.wait(0.05)
        virtualInputManager:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, false, game, 1)
    end
end

-- Hàm 2: Lấy kiếm
local function AutoSelectRainbowGear()
    local backpack = Player:FindFirstChildOfClass("Backpack")
    local character = Player.Character
    local hasRainbow = (backpack and backpack:FindFirstChild("RainbowPeriastron")) or (character and character:FindFirstChild("RainbowPeriastron"))
    
    if not hasRainbow then
        virtualInputManager:SendKeyEvent(true, Enum.KeyCode.G, false, game)
        task.wait(0.1)
        virtualInputManager:SendKeyEvent(false, Enum.KeyCode.G, false, game)
        task.wait(0.2)
        
        local playerGui = Player:FindFirstChildOfClass("PlayerGui") or Player:FindFirstChild("PlayerGui")
        local gearsGui = playerGui and playerGui:FindFirstChild("gears")
        if gearsGui and gearsGui.Enabled then
            for _, obj in ipairs(gearsGui:GetDescendants()) do
                if (obj:IsA("GuiButton") or obj:IsA("GuiObject")) and string.lower(obj.Name) == "rainbowperiastron" then
                    local vp = workspace.CurrentCamera.ViewportSize
                    obj.Visible = true
                    obj.Size = UDim2.new(1, 0, 1, 0)
                    virtualInputManager:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, true, game, 1)
                    task.wait(0.05)
                    virtualInputManager:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, false, game, 1)
                    break
                end
            end
            task.wait(0.2)
            gearsGui.Enabled = false
        end
    end
end

-- Hàm 3: Trang bị kiếm
local function EquipWeapon()
    local backpack = Player:FindFirstChild("Backpack")
    local character = Player.Character
    if character and backpack then
        local currentTool = character:FindFirstChildOfClass("Tool")
        if not currentTool or currentTool.Name ~= "RainbowPeriastron" then
            if currentTool then currentTool.Parent = backpack task.wait(0.05) end
            local rainbowTool = backpack:FindFirstChild("RainbowPeriastron")
            if rainbowTool then character.Humanoid:EquipTool(rainbowTool) end
        end
    end
end

-- Vòng lặp quét quái liên tục không kẹt
task.spawn(function()
