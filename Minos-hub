-- 2. CHỨC NĂNG 🛡️ AUTO PARRY CHUẨN XÁC
-- ========================================================
local parryActive = false
addHackButton("🛡️ Auto Parry (Đỡ Đòn)", function(state)
    parryActive = state
end)

local function equipAndParry()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if char and char:FindFirstChildOfClass("Humanoid") then
        -- Ưu tiên lấy Azure Periastron để parry lệnh admin từ boss
        local tool = (backpack and backpack:FindFirstChild("Azure Periastron")) or char:FindFirstChild("Azure Periastron")
        if tool then
            if tool.Parent ~= char then char.Humanoid:EquipTool(tool) end
            local remote = tool:FindFirstChild("Remote")
            if remote then remote:FireServer(Enum.KeyCode.E) end
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    char.DescendantAdded:Connect(function(descendant)
        if not parryActive then return end
        local id = ""
        if descendant:IsA("ParticleEmitter") then id = string.match(descendant.Texture, "%d+") or ""
        elseif descendant:IsA("MeshPart") or descendant:IsA("SpecialMesh") then id = string.match(descendant.MeshId, "%d+") or "" end
        
