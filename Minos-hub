-- 2. TÍNH NĂNG 🛡️ AUTO PARRY CHẠY NGẦM
-- ========================================================
local parryState = false
createToggle("🛡️ Auto Parry Đỡ Đòn", function(state)
    parryState = state
end)

local function triggerParry()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if char and char:FindFirstChildOfClass("Humanoid") then
        local tool = (backpack and backpack:FindFirstChild("Azure Periastron")) or char:FindFirstChild("Azure Periastron")
        if tool then
            if tool.Parent ~= char then char.Humanoid:EquipTool(tool) end
            local remote = tool:FindFirstChild("Remote")
            if remote then remote:FireServer(Enum.KeyCode.E) end
        end
    end
end

local function listenCharacter(char)
    char.DescendantAdded:Connect(function(desc)
        if not parryState then return end
        local textId = ""
        if desc:IsA("ParticleEmitter") then textId = string.match(desc.Texture, "%d+") or ""
        elseif desc:IsA("MeshPart") or desc:IsA("SpecialMesh") then textId = string.match(desc.MeshId, "%d+") or "" end
        
        if textId == "214269134" then
            task.spawn(triggerParry)
        end
    end)
end

if LocalPlayer.Character then listenCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(listenCharacter)

