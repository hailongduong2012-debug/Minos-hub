-- === CƠ CHẾ GOD MODE BẤT TỬ TRỐN RA KHÔNG GIAN ẢO (VOID SPACE DESYNC) ===
Toggle3.MouseButton1Click:Connect(function()
    VoidGodModeActive = not VoidGodModeActive
    Toggle3.Text = VoidGodModeActive and "God Mode (Trốn Ra Không Gian Ảo) : ON" or "God Mode (Trốn Ra Không Gian Ảo) : OFF"
    Toggle3.TextColor3 = VoidGodModeActive and Color3.fromRGB(80, 200, 80) or Color3.fromRGB(200, 70, 70)
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if VoidGodModeActive and root then
        -- Lưu lại vị trí mặt đất ban đầu để dịch chuyển về khi tắt hack
        OriginalLocation = root.CFrame
        
        -- Bay ra tọa độ vô cực ngoài vũ trụ, Boss hoàn toàn mất phương hướng và bất lực
        local TargetVoidPos = CFrame.new(999999, 999999, 999999)
        root.CFrame = TargetVoidPos
        
        -- Tạo nền móng ảo đỡ chân ở ngoài rìa thế giới
        VoidPlatform = Instance.new("Part")
        VoidPlatform.Size = Vector3.new(30, 1, 30)
        VoidPlatform.CFrame = TargetVoidPos * CFrame.new(0, -3, 0)
        VoidPlatform.Anchored = true
        VoidPlatform.Material = Enum.Material.ForceField
        VoidPlatform.Parent = workspace
    else
        -- Trở về vị trí cũ an toàn
        if VoidPlatform then
            VoidPlatform:Destroy()
            VoidPlatform = nil
        end
        if root and OriginalLocation then
            root.CFrame = OriginalLocation
        end
    end
end)

-- Đóng băng vận tốc liên tục ở vùng không gian ảo để triệt tiêu các cơ chế quét vật lý của Server
RunService.PreSimulation:Connect(function()
    if VoidGodModeActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local char = LocalPlayer.Character
            local root = char.HumanoidRootPart
            root.Velocity = Vector3.new(0, 0, 0)
            
            -- Khóa cứng trạng thái chống chết bất ngờ
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                hum.MaxHealth = math.huge
                hum.Health = math.huge
                if hum:GetState() == Enum.HumanoidStateType.Dead then
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
            end
        end)
    end
end)


