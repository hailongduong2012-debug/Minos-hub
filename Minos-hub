-- === 1. CƠ CHẾ ĐẨY LỰC VẬT LÝ RA SAFE ZONE CÔ LẬP CỰC ĐẠI ===
Toggle2.MouseButton1Click:Connect(function()
    PhysicsSafeZoneActive = not PhysicsSafeZoneActive
    Toggle2.Text = PhysicsSafeZoneActive and "Physics Safe Zone (Cách Ly Đạn) : ON" or "Physics Safe Zone (Cách Ly Đạn) : OFF"
    Toggle2.TextColor3 = PhysicsSafeZoneActive and Color3.fromRGB(80, 200, 80) or Color3.fromRGB(200, 70, 70)
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if PhysicsSafeZoneActive and root then
        -- Lưu vị trí gốc trên mặt đất
        SavedLocation = root.CFrame
        
        -- Dùng gia tốc đẩy cơ thể ra rìa không gian cách ly an toàn (Cao hẳn lên 5000 block)
        root.CFrame = root.CFrame * CFrame.new(0, 5000, 0)
        
        -- Tạo Anchor bằng lực vật lý để khóa cứng tọa độ tại Safe Zone, đánh lừa bộ quét giật lùi của Server
        BodyAnchor = Instance.new("BodyVelocity")
        BodyAnchor.Name = "SBSD_PhysicsSafeAnchor"
        BodyAnchor.Velocity = Vector3.new(0, 0, 0) -- Giữ đứng im cố định ngoài rìa không gian
        BodyAnchor.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        BodyAnchor.Parent = root
    else
        -- Tắt hack, gỡ bỏ lực bay và trả nhân vật về vị trí cũ trên mặt đất an toàn
        if root and root:FindFirstChild("SBSD_PhysicsSafeAnchor") then
            root.SBSD_PhysicsSafeAnchor:Destroy()
        end
        BodyAnchor = nil
        if root and SavedLocation then
            root.CFrame = SavedLocation
        end
    end
end)

-- Khóa cứng trạng thái sinh học thời gian thực tại tầng mô phỏng PreSimulation
RunService.PreSimulation:Connect(function()
    if PhysicsSafeZoneActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local char = LocalPlayer.Character
            char.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
            
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.BreakJointsOnDeath = false
                hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
            end
        end)
    end
end)


