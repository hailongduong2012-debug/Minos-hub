local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Khởi tạo Cửa sổ giao diện theo đúng cấu trúc chuẩn tên Author
local Window = Rayfield:CreateWindow({
   Name = "Minos Hub & Garry (SBSD Edition) - Script by Minos",
   LoadingTitle = "Minos Hub Loading...",
   LoadingSubtitle = "by Minos",
   ConfigurationSaving = {
      Enabled = false,
      FolderName = "MinosHubGarry",
      FileName = "SBSDConfig"
   },
   Discord = {
      Enabled = false,
      Invite = "",
      RememberJoins = true
   },
   KeySystem = false
})

-- Khởi tạo các biến cấu hình hệ thống toàn cục
local _G = getgenv and getgenv() or _G
_G.AutoSelectGarry = false
_G.AutoGearRainbow = false
_G.LockRainbow = false
_G.AutoTeleportTelescope = false
_G.BoxDamageValue = 1000
_G.AttackDelayValue = 0.1

-- Biến đồng bộ trạng thái luồng (Sync Lock)
local isHandlingSequence = false 

-- Tạo Tab chính (Chuỗi thô / Main Script - Không dùng ID hình ảnh để tránh crash UI giống bản mẫu)
local MainTab = Window:CreateTab("Chuỗi Thô / Main Script")

-- Hàm phụ trợ click UI trung tâm màn hình/giả lập tương tác (Bóc tách từ file gốc)
local function clickUiObject(btn)
   if not btn or not btn:IsA("GuiObject") then return end
   local virtualInputManager = game:GetService("VirtualInputManager")
   local x = btn.AbsolutePosition.X + (btn.AbsoluteSize.X / 2)
   local y = btn.AbsolutePosition.Y + (btn.AbsoluteSize.Y / 2)
   virtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
   task.wait(0.05)
   virtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
end

-- =====================================================================
-- TOGGLE 1: CHỌN NHÂN VẬT GARRY (Quét diện rộng ép chọn Garry)
-- =====================================================================
MainTab:CreateToggle({
   Name = "Toggle 1: Chọn Nhân Vật (Garry)",
   CurrentValue = false,
   Flag = "ToggleGarry",
   Callback = function(Value)
      _G.AutoSelectGarry = Value
      if Value then
         task.spawn(function()
            while _G.AutoSelectGarry do
               for _, v in pairs(game:GetDescendants()) do
                  if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                     if string.find(string.lower(v.Name), "character") or string.find(string.lower(v.Name), "select") then
                        pcall(function()
                           v:FireServer("Garry")
                           v:InvokeServer("Garry")
                        end)
                     end
                  end
               end
               task.wait(1)
            end
         end)
      end
   end,
})

-- =====================================================================
-- TOGGLE 2: AUTO GEAR & GET RAINBOW (Quy trình đồng bộ chuỗi logic)
-- =====================================================================
MainTab:CreateToggle({
   Name = "Toggle 2: Auto Gear & Get Rainbow",
   CurrentValue = false,
   Flag = "ToggleGearRainbow",
   Callback = function(Value)
      _G.AutoGearRainbow = Value
      if Value then
         task.spawn(function()
            while _G.AutoGearRainbow do
               if not isHandlingSequence then
                  isHandlingSequence = true
                  
                  pcall(function()
                     local player = game.Players.LocalPlayer
                     local playerGui = player:FindFirstChildOfClass("PlayerGui")
                     local backpack = player:FindFirstChild("Backpack")
                     local character = player.Character
                     
                     -- BƯỚC 1: Ép chọn nhân vật Admin hoặc Telescope trước qua giao diện CharClass
                     local charClass = playerGui and playerGui:FindFirstChild("CharClass")
                     if charClass then
                        local targetBtn = nil
                        for _, desc in ipairs(charClass:GetDescendants()) do
                           if desc:IsA("GuiButton") and (string.find(desc.Name, "Admin") or string.find(desc.Name, "Telescope")) then
                              targetBtn = desc
                              break
                           end
                        end
                        if targetBtn then
                           clickUiObject(targetBtn)
                           task.wait(0.5) -- Chờ hệ thống áp dụng nhân vật
                        end
                     end
                     
                     -- BƯỚC 2: Tự động trang bị Gear hiện tại và kích hoạt chiêu (Nhấn nút E/G hoặc Activate)
                     if backpack then
                        for _, gear in pairs(backpack:GetChildren()) do
                           if gear:IsA("Tool") and gear.Name ~= "Rainbow Sword" then
                              if character then
                                 gear.Parent = character
                                 task.wait(0.1)
                                 gear:Activate()
                                 -- Gửi tín hiệu kích hoạt chiêu E từ remote phụ thuộc của vũ khí giống tệp gốc
                                 local remote = gear:FindFirstChild("Remote")
                                 if remote and remote:IsA("RemoteEvent") then
                                    remote:FireServer(Enum.KeyCode.E)
                                 end
                                 task.wait(0.2)
                              end
                           end
                        end
                     end
                     
                     -- BƯỚC 3: Mở túi đồ/giao diện "gears" bấm vô thanh Rainbow để lấy ẩn danh
                     local gearsGui = playerGui and playerGui:FindFirstChild("gears")
                     if gearsGui then
                        -- Giữ giao diện mở để kích hoạt giống file mẫu
                        gearsGui.Enabled = true
                        local rainbowBtn = nil
                        for _, obj in ipairs(gearsGui:GetDescendants()) do
                           if obj:IsA("GuiButton") and string.find(string.lower(obj.Name), "rainbow") then
                              rainbowBtn = obj
                              break
                           end
                        end
                        if rainbowBtn then
                           clickUiObject(rainbowBtn)
                           task.wait(0.3)
                        end
                        gearsGui.Enabled = false
                     end
                     
                     -- Dự phòng: Sử dụng getconnections lấy kiếm Rainbow ẩn danh
                     if typeof(getconnections) == "function" then
                        for _, connection in pairs(getconnections(game:GetService("ReplicatedStorage").ChildAdded)) do
                           connection:Fire()
                        end
                     end
                     
                     -- Ép Remote gọi server nếu nút UI không phản hồi
                     local rainbowRemote = game:GetService("ReplicatedStorage"):FindFirstChild("GetRainbow", true) or game:GetService("ReplicatedStorage"):FindFirstChild("ClaimItem", true)
                     if rainbowRemote and rainbowRemote:IsA("RemoteEvent") then
                        rainbowRemote:FireServer("Rainbow Sword")
                     end
                  end)
                  
                  isHandlingSequence = false
               end
               task.wait(1)
            end
         end)
      end
   end,
})

-- =====================================================================
-- TOGGLE 3: KHÓA KIẾM RAINBOW (50ms - Sắp xếp slot số 4 và ép cầm độc quyền)
-- =====================================================================
MainTab:CreateToggle({
   Name = "Toggle 3: Khóa Kiếm Rainbow (50ms)",
   CurrentValue = false,
   Flag = "ToggleLockRainbow",
   Callback = function(Value)
      _G.LockRainbow = Value
      if Value then
         task.spawn(function()
            while _G.LockRainbow do
               -- Kiểm tra Sync Lock ngăn ngừa đột tử luồng khi Toggle 2 đang chạy chuỗi hành động
               if not isHandlingSequence then
                  pcall(function()
                     local player = game.Players.LocalPlayer
                     local backpack = player:FindFirstChild("Backpack")
                     local character = player.Character
                     
                     if character and backpack then
                        -- Ép cất toàn bộ các vũ khí/gear khác về balo để dọn sạch tay cầm
                        for _, tool in pairs(character:GetChildren()) do
                           if tool:IsA("Tool") and tool.Name ~= "Rainbow Sword" then
                              tool.Parent = backpack
                           end
                        end
                        
                        -- Định vị thanh kiếm Rainbow trong Backpack
                        local rainbowSword = backpack:FindFirstChild("Rainbow Sword") or backpack:FindFirstChild("RainbowPeriastron")
                        if rainbowSword then
                           -- BƯỚC 4: Sắp xếp vị trí của cây kiếm xuất hiện ở hàng/slot thứ 4 trong kho đồ
                           -- Thiết lập LayoutOrder hoặc đổi vị trí sắp xếp trong cặp Core Gui Backpack di động
                           local targetSlotNumber = 4
                           if rainbowSword:OptInLayout() or pcall(function() rainbowSword.LayoutOrder = targetSlotNumber end) then
                              -- Khởi tạo thuộc tính thứ tự hiển thị slot 4 nếu engine hỗ trợ chỉnh sửa thuộc tính trực tiếp
                              rainbowSword.LayoutOrder = targetSlotNumber
                           end
                           
                           -- BƯỚC 5: Ép nhân vật cầm thanh kiếm Rainbow lên tay độc quyền
