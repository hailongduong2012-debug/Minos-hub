-- Hàm gom và đồng bộ vị trí quái toàn map về trước mặt người chơi (Không Teleport người chơi)
local function syncGlobalEnemies()
   local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
   if not myRoot then return false end

   local enemyContainer = workspace:FindFirstChild("Enemies") or workspace
   local hasEnemies = false

   for _, child in pairs(enemyContainer:GetChildren()) do
       if child:IsA("Model") and child ~= LocalPlayer.Character then
           local humanoid = child:FindFirstChildOfClass("Humanoid")
           local enemyRoot = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("PrimaryPart")
           
           if humanoid and enemyRoot and humanoid.Health > 0 then
               hasEnemies = true
               -- METHOD QUORUM V6: Ép CFrame của quái về ngay trước tầm chém vật lý của bạn
               -- Quái vẫn ở vị trí cũ trên màn hình server nhưng khối Hitbox xử lý sát thương cục bộ được kéo sát vào bạn
               enemyRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -3)
               enemyRoot.CanCollide = false
           end
       end
   end
   return hasEnemies
end

-- Vòng lặp kích hoạt đòn đánh lan toàn map
task.spawn(function()
   while true do
       if _G.QuorumAura then
           -- Đồng bộ hóa vị trí tất cả quái trước khi tung đòn
           local isReady = syncGlobalEnemies()
           
           if isReady then
               local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
               if tool then
                   -- Kích hoạt đòn đánh vật lý của Roblox Engine -> Sát thương lan trúng tất cả quái cùng lúc
                   VirtualUser:ClickButton1(Vector2.new(0, 0))
               end
           end
       end
       -- Sử dụng math.random nhỏ để giả lập nhịp click con người, bỏ qua hoàn toàn bộ lọc quét AI Anticheat
       task.wait(_G.AttackSpeed + (math.random(-2, 3) / 100))
   end
end)

