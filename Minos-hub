-- Cơ chế: Ép thực thi dòng lệnh bằng task.defer, loại bỏ hoàn toàn UI và thông báo tránh crash

task.defer(function()
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local LocalPlayer = Players.LocalPlayer

    -- === 1. CHÉM QUÁI TOÀN MAP (DIỆN TÍCH TỐI ĐA VÔ HẠN) ===
    RunService.Heartbeat:Connect(function()
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            
            -- Tự động cầm vũ khí
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if backpack and not char:FindFirstChildOfClass("Tool") then
                local tool = backpack:FindFirstChildOfClass("Tool")
                if tool then tool.Parent = char end
            end
            
            local currentTool = char:FindFirstChildOfClass("Tool")
            if currentTool and firetouchinterest then
                local attackPart = currentTool:FindFirstChild("Handle") or currentTool:FindFirstChildWhichIsA("BasePart")
                if attackPart then
                    -- Quét toàn bộ quái trên bản đồ, bỏ qua kiểm tra khoảng cách
                    for _, enemy in pairs(workspace:GetDescendants()) do
                        if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            if not Players:GetPlayerFromCharacter(enemy) then
                                local enemyRoot = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChildWhichIsA("BasePart")
                                if enemyRoot then
                                    -- Kích hoạt chạm sát thương (Kill Aura)
                                    firetouchinterest(enemyRoot, attackPart, 0)
                                    firetouchinterest(enemyRoot, attackPart, 1)
                                end
                            end
                        end
                    end
                end
            end
        end)
    end)

    -- === 2. TỰ ĐỘNG SPWAN TELESCOPE GIÁ 5 COIN ===
    task.spawn(function()
        while true do
            task.wait(0.8) -- Độ trễ an toàn chống spam nghẽn mạng
            pcall(function()
                -- Tự động quét tìm RemoteEvent mua/gọi đạo cụ của Game
                local shopRemote = ReplicatedStorage:FindFirstChild("BuyItem", true) 
                    or ReplicatedStorage:FindFirstChild("PurchaseItem", true)
                    or ReplicatedStorage:FindFirstChild("RemoteEvent", true)

                if shopRemote and shopRemote:IsA("RemoteEvent") then
                    shopRemote:FireServer("Telescope", 5)
                    shopRemote:FireServer("SpawnTelescope")
                end
            end)
        end
    end)
end)
