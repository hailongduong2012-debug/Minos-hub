-----------------------------------------------------
-- HOOK METATABLE (BẺ HƯỚNG ĐẠN)
-----------------------------------------------------
local mt = getrawmetatable(game)
local oldIndex = mt.__index
setreadonly(mt, false)

mt.__index = newcclosure(function(self, key)
    if silentAimEnabled and SA_TargetPart and not SA_IsCameraOrSystemScript() then
        if self == SA_Mouse and (key == "Hit" or key == "Target") then
            if key == "Hit" then
                local rootPart = SA_CurrentNPC and SA_CurrentNPC:FindFirstChild("HumanoidRootPart")
                local vel = rootPart and rootPart.Velocity or Vector3.new()
                return CFrame.new(SA_TargetPart.Position + (vel * silentAimPrediction))
            elseif key == "Target" then
                return SA_TargetPart
            end
        end
    end
    return oldIndex(self, key)
end)
setreadonly(mt, true)
