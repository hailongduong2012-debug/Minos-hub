-- 2. Tạo Tab bằng chuỗi thô (Chuẩn Garry)
local AutoCampaignTab = Window:CreateTab("Auto Campaign", 4483362458) 

-- 3. Cấu hình biến trạng thái đồng bộ
local States = {
    SelectCharacter = false,
    GearAndRainbow = false,
    AutoEquipLock = false,
    AutoFarmBoss = false,
    BossDamageInput = 1000000, -- Mặc định dồn 1 triệu sát thương
    AttackDelay = 1
}

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Hàm Teleport chuẩn xác trực tiếp của Garry
local function TeleportTo(cframe)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root then
        pcall(function()
            root.CFrame = cframe
        end)
    end
end

-- Hàm tìm kiếm thực thể đích (Ưu tiên Box/Boss theo cấu trúc game)
local function GetTarget()
    for _, obj in ipairs(workspace:GetChildren()) do
        -- Quét tất cả các object có tính chất là quái hoặc rương/hộp đánh boss
        if (obj:FindFirstChild("HumanoidRootPart") or obj:IsA("BasePart")) and 
           (string.find(string.lower(obj.Name), "box") or string.find(string.lower(obj.Name), "boss")) then
            return obj
        end
    end
    -- Fallback nếu đặt tên khác
    return workspace:FindFirstChild("Box") or workspace:FindFirstChild("Boss")
end

