-- 1. Khởi tạo và cấu hình UI Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Minos Hub & Garry | SBSD Edition",
   LoadingTitle = "Script by minos",
   LoadingSubtitle = "Author: minos",
   ConfigurationSaving = {
      Enabled = false,
      FolderName = "MinosHubGarry"
   },
   Discord = {
      Enabled = false,
      Invite = ""
   },
   KeySystem = false
})

-- 2. Tạo Tab chính bằng chuỗi thô (Chuẩn cấu trúc Garry)
local AutoCampaignTab = Window:CreateTab("Auto Campaign", 4483362458) 

-- 3. Khởi tạo các biến lưu trữ trạng thái tính năng
local States = {
    AdminSelection = false,
    RainbowSword = false,
    LockEquip = false,
    FastAttack = false,
    BossDamage = 1,
    AttackDelay = 1
}

-- ====================================================================
-- BỘ 4 NÚT TOGGLE ĐỘC LẬP (Đã fix lỗi hiển thị, hiển thị trực tiếp trong Tab)
-- ====================================================================

-- Toggle 1: Chọn Admin bằng getconnections
AutoCampaignTab:CreateToggle({
   Name = "Chọn Admin (GetConnections)",
   CurrentValue = false,
   Callback = function(Value)
      States.AdminSelection = Value
      if Value then
          task.spawn(function()
              while States.AdminSelection do
                  if getconnections then
                      for _, connection in ipairs(getconnections(game:GetService("UserInputService").TouchTapInWorld)) do
                          pcall(function() connection:Fire() end)
                      end
                  end
                  task.wait(0.5)
              end
          end)
      end
   end,
})

-- Toggle 2: Kiếm Rainbow ẩn danh (Khóa cứng hotbar)
AutoCampaignTab:CreateToggle({
   Name = "Kiếm Rainbow Ẩn Danh (Khóa Hotbar)",
   CurrentValue = false,
   Callback = function(Value)
      States.RainbowSword = Value
      if Value then
          task.spawn(function()
              while States.RainbowSword do
                  -- Sử dụng kết nối ẩn danh thông qua ReplicatedStorage
                  if getconnections then
                      for _, con in ipairs(getconnections(game:GetService("ReplicatedStorage").ChildAdded)) do
                          pcall(function() con:Fire() end)
                      end
                  end
                  
                  -- Khóa cứng hotbar (Tự động đưa kiếm Rainbow từ Backpack lên Character)
                  local localPlayer = game:GetService("Players").LocalPlayer
                  if localPlayer and localPlayer.Character then
                      local backpack = localPlayer:FindFirstChildOfClass("Backpack")
                      local rainbow = backpack and backpack:FindFirstChild("Rainbow Sword") or localPlayer.Character:FindFirstChild("Rainbow Sword")
                      if rainbow and backpack then
                          pcall(function()
                              rainbow.Parent = localPlayer.Character
                          end)
                      end
                  end
                  task.wait(0.1)
              end
          end)
      end
   end,
})

-- Toggle 3: Khóa equip vũ khí
AutoCampaignTab:CreateToggle({
   Name = "Khóa Equip Vũ Khí",
   CurrentValue = false,
   Callback = function(Value)
      States.LockEquip = Value
      if Value then
          task.spawn(function()
              local player = game:GetService("Players").LocalPlayer
              while States.LockEquip do
                  if player.Character then
                      local tool = player.Character:FindFirstChildOfClass("Tool")
                      -- Nếu nhân vật bị gỡ vũ khí, tự động trang bị lại ngay lập tức
                      if not tool then
                          local backpack = player:FindFirstChildOfClass("Backpack")
                          local targetTool = backpack and backpack:FindFirstChildOfClass("Tool")
                          if targetTool then
                              pcall(function() targetTool.Parent = player.Character end)
                          end
                      end
                  end
                  task.wait(0.2)
              end
          end)
      end
   end,
})

-- Toggle 4: Fast Attack đánh quái thường và Boss (Bọc pcall chống kẹt)
AutoCampaignTab:CreateToggle({
   Name = "Fast Attack (Chống Kẹt Boss/Quái)",
   CurrentValue = false,
   Callback = function(Value)
      States.FastAttack = Value
      if Value then
          task.spawn(function()
              while States.FastAttack do
                  -- Bọc toàn bộ trong pcall để chống kẹt/crash script khi quái chết hoặc mất mục tiêu
                  pcall(function()
                      local player = game:GetService("Players").LocalPlayer
                      local character = player.Character
                      local tool = character and character:FindFirstChildOfClass("Tool")
                      
                      if tool and tool:FindFirstChild("AttackRemote") then
                          -- Số lần chém liên tiếp dựa theo thanh Slider sát thương Boss
                          for i = 1, States.BossDamage do
                              tool.AttackRemote:FireServer()
                          end
                      end
                  end)
                  -- Tốc độ delay chém (lấy giá trị Slider chia cho 100)
                  task.wait(States.AttackDelay / 100)
              end
          end)
      end
   end,
})

-- ====================================================================
-- BỘ 2 THANH SLIDER TÙY CHỈNH
-- ====================================================================

-- Slider 1: Chỉnh sát thương đập Boss từ 1-30
AutoCampaignTab:CreateSlider({
   Name = "Sát Thương Đập Boss (Số Lần Chém)",
   Min = 1,
   Max = 30,
   CurrentValue = 1,
   Flag = "BossDamageSlider",
   Callback = function(Value)
      States.BossDamage = Value
   end,
})

-- Slider 2: Chỉnh tốc độ delay chém từ 1-50 (Chia 100 trong code)
AutoCampaignTab:CreateSlider({
   Name = "Tốc Độ Delay Chém (Chia 100)",
   Min = 1,
   Max = 50,
   CurrentValue = 1,
   Flag = "AttackDelaySlider",
   Callback = function(Value)
      States.AttackDelay = Value
   end,
})

