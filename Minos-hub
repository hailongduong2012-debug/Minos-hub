local AutoFastAttack = false
local Player = game:GetService("Players").LocalPlayer

-- HÀM CẦM VŨ KHÍ TỰ ĐỘNG (Giữ vũ khí ổn định không bị bật/tắt)
local function EquipWeapon()
    local backpack = Player:FindFirstChild("Backpack")
    local character = Player.Character
    if character and backpack then
        if not character:FindFirstChildOfClass("Tool") then
            for _, tool in pairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    character.Humanoid:EquipTool(tool)
                    break
                end
            end
        end
    end
end

-- VÒNG LẶP CHÍNH: QUÉT QUÁI - PHÂN LOẠI XỬ LÝ (ĐÓNG HỘP / CHÉM BOSS)
task.spawn(function()
    while true do
        task.wait(0.1)
        if AutoFastAttack and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
            local myRoot = Player.Character.HumanoidRootPart
            local enemiesFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Zombies") or workspace
            local hitRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Hit") or game:GetService("ReplicatedStorage"):FindFirstChild("Damage")
            local interactRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Interact") or game:GetService("ReplicatedStorage"):FindFirstChild("CloseBox")
            
            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") then
                    local enemyRoot = enemy.HumanoidRootPart
                    local humanoid = enemy:FindFirstChildOfClass("Humanoid")
                    
                    -- Kiểm tra xem mục tiêu có phải là Boss dựa trên Tên hoặc Lượng máu lớn
                    local isBoss = false
                    if string.find(string.lower(enemy.Name), "boss") or string.find(string.lower(enemy.Name), "titan") or (humanoid and humanoid.MaxHealth >= 1000) then
                        isBoss = true
                    end
                    
                    -- Bám sát và xử lý mục tiêu
                    while AutoFastAttack and humanoid and humanoid.Health > 0 and enemyRoot:IsDescendantOf(workspace) do
                        
                        -- 1. XỬ LÝ QUÁI THƯỜNG (QUÁI NHỎ): Dịch chuyển đến và ưu tiên đóng hộp
                        if not isBoss then
                            -- Teleport sát bên cạnh để đóng hộp
                            myRoot.CFrame = enemyRoot.CFrame * CFrame.new(0, 0, 2)
                            
                            -- Gửi tín hiệu đóng hộp qua Remote (Nếu game hỗ trợ)
                            if interactRemote then
                                interactRemote:FireServer(enemy)
                            end
                            
                            -- Đánh thêm vài phát cận chiến nhẹ để quái nhanh chết
                            if hitRemote then
                                hitRemote:FireServer(enemyRoot, enemyRoot.Position)
                            end
                        
                        -- 2. XỬ LÝ BOSS / QUÁI LỚN: Teleport lên trên đầu để né đạn tầm xa & Spam chém siêu tốc
                        else
                            -- Teleport lên trên đầu Boss 3 block để tránh bị dính skill tầm xa dưới đất
                            myRoot.CFrame = enemyRoot.CFrame * CFrame.new(0, 3, 0)
                            
                            -- Đảm bảo đang cầm kiếm
                            EquipWeapon()
                            
                            -- Spam chém siêu tốc dồn dập (10 lần liên tục mỗi vòng lặp)
                            if hitRemote then
                                for i = 1, 10 do 
                                    hitRemote:FireServer(enemyRoot, enemyRoot.Position)
                                end
                            end
                        end
                        
                        task.wait(0.05) -- Tốc độ vòng lặp tấn công
                    end
                end
            end
        end
    end
end)

