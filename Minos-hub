-- === XỬ LÝ ẨN / HIỆN UI ===
local function ToggleUi()
    UiVisible = not UiVisible
    Main.Visible = UiVisible
    OpenButton.Visible = not UiVisible
end

game:GetService("UserInputService").InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.LeftControl then
        ToggleUi()
    end
end)

OpenButton.MouseButton1Click:Connect(ToggleUi)


-- === LOGIC ULTRA FAST ATTACK (CHÉM SIÊU TỐC KHÔNG KHOẢNG CÁCH) ===
Toggle1.MouseButton1Click:Connect(function()
    AuraActive = not AuraActive
    if AuraActive then
        Toggle1.Text = "Ultra Fast Attack (Kill Aura) : ON"
        Toggle1.TextColor3 = Color3.fromRGB(80, 200, 80)
    else
        Toggle1.Text = "Ultra Fast Attack (Kill Aura) : OFF"
        Toggle1.TextColor3 = Color3.fromRGB(200, 70, 70)
    end
end)

RunService.Heartbeat:Connect(function()
    if AuraActive and AttackRemote then
        pcall(function()
            for _, enemy in pairs(workspace:GetDescendants()) do
                if enemy:IsA("Model") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                    if not Players:GetPlayerFromCharacter(enemy) then
                        
                        local isBoss = string.find(string.lower(enemy.Name), "boss") or enemy:GetAttribute("IsBoss")
                        
                        if isBoss then
                            -- Gặp Boss: Kích hoạt siêu đa luồng (Multi-hit x15) gây sát thương bốc hơi trong 1 nốt nhạc
                            for i = 1, 15 do
                                task.spawn(function()
                                    AttackRemote:FireServer(enemy)
                                end)
                            end
                        else
                            -- Quái thường: Đẩy nhanh x3 tốc độ cũ bằng luồng song song task.spawn
                            for i = 1, 3 do
                                task.spawn(function()
                                    AttackRemote:FireServer(enemy)
                                end)
                            end
                        end
                        
                    end
                end
            end
        end)
    end
end)


-- === LOGIC GOD MODE FF (BẤT TỬ KHÔNG NHẬN SÁT THƯƠNG) ===
