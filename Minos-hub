local gearHandled = false

-- [SỬA] Danh sách tên gear của Auto Gear (viết thường), ưu tiên từ trên xuống, tách riêng theo game.
-- Tìm theo kiểu "tên có chứa" nên không cần khớp 100%.
-- rainbowperiastron = gear của script Quorum | trollge_tui axe = gear cũ của bản mới (giữ làm dự phòng)
local IS_NEW_GAME = (PlaceId == 12377995562 or PlaceId == 15735896047)
local GEAR_NAMES = IS_NEW_GAME
  and { "rainbowperiastron", "trollge_tui axe" }
  or  { "rainbowperiastron", "whig sword", "dragonslayersswordandshield", "uppersword", "periastron" }

-- Tìm gear trong Backpack / Character / GUI (lọc theo class, ưu tiên theo thứ tự GEAR_NAMES)
local function findGear(container, className, deep)
  if not container then return nil end
  local list = deep and container:GetDescendants() or container:GetChildren()
  for _, gearName in ipairs(GEAR_NAMES) do
    for _, obj in ipairs(list) do
      if obj:IsA(className) and string.find(string.lower(obj.Name), gearName, 1, true) then
        return obj
      end
    end
  end
  return nil
end

local function hasGear()
  local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
  if backpack and findGear(backpack, "Tool") then return true end
  local char = LocalPlayer.Character
  return char ~= nil and findGear(char, "Tool") ~= nil
end

-- Không thấy gear trong GUI -> báo tên các nút đang có để biết đường sửa
local gearMiss, lastGearWarn = 0, 0
local function warnGearNotFound(gears)
  if tick() - lastGearWarn < 20 then return end
  lastGearWarn = tick()
  local names = {}
  for _, obj in ipairs(gears:GetDescendants()) do
    if obj:IsA("GuiButton") then
      table.insert(names, obj.Name)
      if #names >= 12 then break end
    end
  end
  local msg = #names > 0 and table.concat(names, ", ") or "(GUI gears không có nút nào)"
  warn("[Auto Gear] Không thấy gear khớp tên. Các nút trong GUI gears: " .. msg)
  pcall(function()
    Rayfield:Notify({ Title = "Auto Gear", Content = "Không thấy gear. Các nút trong GUI: " .. msg, Duration = 8 })
  end)
end

local function f35()
  local playerGui = getPlayerGui()
  local gears = playerGui and playerGui:FindFirstChild("gears")
  if not gears then return false end

  local item = findGear(gears, "GuiButton", true) or findGear(gears, "GuiObject", true)
  if not item then
    gearMiss = gearMiss + 1
    if gearMiss >= 6 then gearMiss = 0; warnGearNotFound(gears) end
    return false
  end
  gearMiss = 0

  -- Giữ GUI "gears" luôn bật trong lúc click (giống f36 của script Quorum)
  local keepOpen = true
  task.spawn(function()
    while keepOpen and gears.Parent do
      gears.Enabled = true
      runService.Heartbeat:Wait()
    end
  end)

  pcall(function()
    f33(item)
    task.wait(0.3)
  end)
  keepOpen = false
  return hasGear()
end

