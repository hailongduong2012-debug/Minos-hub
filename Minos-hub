-- Nút Toggle 1: Auto Attack
local Toggle1 = Instance.new("TextButton", Main)
Toggle1.Size = UDim2.new(0, 290, 0, 45)
Toggle1.Position = UDim2.new(0, 15, 0, 60)
Toggle1.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
