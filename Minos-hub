                local hrp = obj.HumanoidRootPart
                hrp.Anchored = false
                hrp.CanCollide = true
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 1
            end
        end
    end
    enableGrip()
end

